#!/bin/sh

set -eu
umask 077

minimum_keys_version=1.10.0
default_domain=aoscloud.io
aos_root=${AOS_USER_ROOT:-"$HOME/.aos"}
venv_path="$aos_root/venv"
security_path="$aos_root/security"
python_path="$venv_path/bin/python3"

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: scripts/aos-user-setup COMMAND

Commands:
  all            Run bootstrap, root trust, reissue, and verification.
  check-host     Check macOS, ARM64, Python, and current Aos tool state.
  bootstrap      Create ~/.aos/venv and install official Aos CLI tools.
  install-root   Install the two Aos root certificates in the login Keychain.
  reissue        Prompt privately for Admin, OEM, and SP one-time tokens.
  verify         Verify local certificates and their AosCloud roles.

Tokens are read without terminal echo and are passed directly to aos-keys.
They are never written to files, command-line arguments, logs, or shell history.
EOF
}

require_macos_arm64() {
    [ "$(uname -s)" = Darwin ] || die 'This helper currently supports macOS only.'
    [ "$(uname -m)" = arm64 ] || die 'This helper requires native Apple Silicon.'
}

validate_aos_root() {
    case "$aos_root" in
        /*) ;;
        *) die "AOS user root must be an absolute path: $aos_root" ;;
    esac
    [ ! -L "$aos_root" ] || die "AOS user root must not be a symbolic link: $aos_root"
    if [ -e "$aos_root" ] && [ ! -d "$aos_root" ]; then
        die "AOS user root is not a directory: $aos_root"
    fi
}

version_at_least() {
    "$1" - "$2" <<'PY'
import sys
from importlib.metadata import version
from packaging.version import Version

raise SystemExit(0 if Version(version('aos-keys')) >= Version(sys.argv[1]) else 1)
PY
}

find_bootstrap_python() {
    if [ -n "${AOS_USER_PYTHON:-}" ]; then
        [ -x "$AOS_USER_PYTHON" ] || die "AOS_USER_PYTHON is not executable: $AOS_USER_PYTHON"
        printf '%s\n' "$AOS_USER_PYTHON"
        return
    fi

    for candidate in \
        /opt/homebrew/opt/python@3.12/bin/python3.12 \
        /opt/homebrew/opt/python@3.13/bin/python3.13 \
        /opt/homebrew/bin/python3 \
        /Library/Frameworks/Python.framework/Versions/Current/bin/python3
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    die 'Python 3.10+ was not found. Install Homebrew python@3.12 first.'
}

require_python_310() {
    exit_code=0
    "$1" - <<'PY' || exit_code=$?
import platform
import sys

ok = sys.version_info >= (3, 10) and platform.machine() == 'arm64'
print(f'Python: {platform.python_version()} ({platform.machine()})')
raise SystemExit(0 if ok else 1)
PY
    if [ "${exit_code:-0}" -ne 0 ]; then
        die 'aos-keys 1.10.0 requires native ARM64 Python 3.10 or later.'
    fi
}

require_venv() {
    [ -x "$python_path" ] || die 'Aos environment is missing. Run bootstrap first.'
    require_python_310 "$python_path"
    version_at_least "$python_path" "$minimum_keys_version" || \
        die "aos-keys $minimum_keys_version or later is required. Run bootstrap again."
}

package_version() {
    "$python_path" - "$1" <<'PY'
import sys
from importlib.metadata import version

print(version(sys.argv[1]))
PY
}

check_host() {
    require_macos_arm64
    validate_aos_root
    printf 'Host: macOS %s (%s)\n' "$(sw_vers -productVersion)" "$(uname -m)"

    if [ -x "$python_path" ]; then
        printf 'Aos virtual environment: %s\n' "$venv_path"
        require_python_310 "$python_path"
        for package in aos-keys aos-signer aos-prov; do
            version_value=$(package_version "$package" 2>/dev/null || true)
            if [ -n "$version_value" ]; then
                printf '%s: %s\n' "$package" "$version_value"
            else
                printf '%s: not installed\n' "$package"
            fi
        done
    else
        printf 'Aos virtual environment: not installed\n'
        if bootstrap_python=$(find_bootstrap_python 2>/dev/null); then
            require_python_310 "$bootstrap_python"
            printf 'Bootstrap Python: %s\n' "$bootstrap_python"
        else
            printf 'Bootstrap Python: not installed (Homebrew python@3.12 is required)\n'
        fi
    fi

    for role in admin oem sp; do
        certificate="$security_path/aos-user-$role.p12"
        if [ -f "$certificate" ] && [ ! -L "$certificate" ]; then
            printf '%s certificate: present\n' "$role"
        else
            printf '%s certificate: absent\n' "$role"
        fi
    done
}

bootstrap() {
    require_macos_arm64
    validate_aos_root
    if ! bootstrap_python=$(find_bootstrap_python 2>/dev/null); then
        command -v brew >/dev/null 2>&1 || \
            die 'Homebrew is required to install Python 3.12.'
        printf 'Installing native Homebrew Python 3.12...\n'
        brew install python@3.12
        bootstrap_python=$(find_bootstrap_python)
    fi
    require_python_310 "$bootstrap_python"

    if [ -e "$venv_path" ] && [ ! -x "$python_path" ]; then
        die "Existing path is not a valid Aos environment: $venv_path"
    fi
    if [ ! -x "$python_path" ]; then
        mkdir -p "$aos_root"
        chmod 0700 "$aos_root"
        "$bootstrap_python" -m venv "$venv_path"
    fi

    require_python_310 "$python_path"
    "$python_path" -m pip install --upgrade pip
    "$python_path" -m pip install --upgrade \
        'aos-keys>=1.10.0,<2' \
        'aos-signer>=1.16.0,<2' \
        'aos-prov>=5.2.0,<6'

    require_venv
    chmod 0700 "$aos_root" "$venv_path"
    mkdir -p "$security_path"
    chmod 0700 "$security_path"

    for package in aos-keys aos-signer aos-prov; do
        printf '%s: %s\n' "$package" "$(package_version "$package")"
    done
    "$python_path" -m aos_prov provision --help >/dev/null
    printf 'Aos CLI bootstrap completed.\n'
    printf 'Next: %s install-root\n' "$0"
}

install_root() {
    require_macos_arm64
    validate_aos_root
    require_venv
    printf 'macOS will request Keychain approval for two Aos root certificates.\n'
    "$python_path" -m aos_keys install-root
    printf 'Aos root certificate installation completed.\n'
}

certificate_for_role() {
    printf '%s/aos-user-%s.p12\n' "$security_path" "$1"
}

reissue_role() {
    role=$1
    certificate=$(certificate_for_role "$role")
    if [ -e "$certificate" ]; then
        [ -f "$certificate" ] && [ ! -L "$certificate" ] || \
            die "Existing certificate path is unsafe: $certificate"
        printf 'Preserving existing %s certificate: %s\n' "$role" "$certificate"
        return
    fi

    AOS_USER_SECURITY_PATH="$security_path" \
        "$python_path" - "$default_domain" "$role" <<'PY'
import getpass
import os
import re
import sys

from aos_keys.actions import UserType, new_token_user
from aos_keys.common import AosKeysError

domain, role = sys.argv[1:]
output_directory = os.environ.pop('AOS_USER_SECURITY_PATH')
token = getpass.getpass(f'Paste the NEW one-time {role} token (input hidden): ')
if not re.fullmatch(r'[A-Za-z0-9._~-]+', token):
    raise SystemExit(f'Error: {role} token is empty or contains unexpected characters.')
try:
    new_token_user(
        domain,
        output_directory,
        token,
        UserType.from_input(role),
        False,
        False,
    )
except AosKeysError as error:
    raise SystemExit(f'Certificate request failed: {error}') from None
finally:
    token = ''
PY
    [ -f "$certificate" ] || die "$role certificate was not created."
    chmod 0600 "$certificate"
}

reissue() {
    require_macos_arm64
    validate_aos_root
    require_venv
    mkdir -p "$security_path"
    chmod 0700 "$aos_root" "$security_path"

    cat <<'EOF'
This operation needs three NEW one-time tokens from the reissue email:
  1. personal Admin account
  2. aa_oem
  3. aa_serviceproducer (SP)

The tokens will not be echoed or stored by this helper. Each token is consumed
by AosCloud, and each resulting PKCS#12 file is imported into the login Keychain.
EOF

    reissue_role admin
    reissue_role oem
    reissue_role sp
    printf 'All three certificates were reissued.\n'
    printf 'Next: %s verify\n' "$0"
}

verify() {
    require_macos_arm64
    validate_aos_root
    require_venv
    for role in admin oem sp; do
        certificate=$(certificate_for_role "$role")
        [ -f "$certificate" ] && [ ! -L "$certificate" ] || \
            die "$role certificate is missing: $certificate"
        chmod 0600 "$certificate"
        "$python_path" -m aos_keys info -c "$certificate"
    done
    printf 'Admin, OEM, and SP certificate checks completed.\n'
}

all() {
    bootstrap
    install_root
    reissue
    verify
}

command=${1:-}
case "$command" in
    all) all ;;
    check-host) check_host ;;
    bootstrap) bootstrap ;;
    install-root) install_root ;;
    reissue) reissue ;;
    verify) verify ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; die "Unknown command: $command" ;;
esac
