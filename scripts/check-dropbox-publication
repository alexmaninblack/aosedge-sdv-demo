"""Offline publisher qualification. Does not access Dropbox, M1 or release catalogs."""
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'scripts/distribution'))
from build_scratch import directory

started=time.monotonic()
with directory(ROOT) as scratch:
    env=dict(os.environ,TMPDIR=str(scratch),PYTHONDONTWRITEBYTECODE='1')
    result=subprocess.run([sys.executable,'-B','-m','unittest',
        'tests.test_dropbox_delivery','tests.test_dropbox_oauth','tests.test_dropbox_public',
        'tests.test_dropbox_download_parser','tests.test_release_automation',
        'tests.test_release_projection','tests.test_release_operator_amendment'],
        cwd=ROOT,env=env,timeout=300)
print('Dropbox publisher fixture scenario: '+('PASS' if result.returncode==0 else 'FAIL')+
      ' ('+str(round(time.monotonic()-started,2))+'s); scratch closed; no live operations.')
raise SystemExit(result.returncode)
