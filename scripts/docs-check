CANONICAL_DOCUMENTS = (
    Path("docs/architecture/high-level-architecture.md"),
    Path("docs/demo/staged-post-sop-brake-health-demo-scenarios.md"),
    Path("docs/architecture/demo-scenario-architecture-flows.md"),
    Path("docs/requirements/system-requirements-and-traceability.md"),
    Path("docs/requirements/component-decomposition-and-interface-register.md"),
)
BOUNDARY_DECISION_HEADING = "## Boundary Decision Status"
REQUIRED_METADATA = ("Status", "Version", "Prepared", "Owner")
ALLOWED_STATUSES = ("draft", "review candidate", "accepted", "superseded")
ALLOWED_DOC_SUFFIXES = {".md", ".png", ".jpg", ".jpeg", ".drawio", ".html"}
OBSOLETE_NAME = re.compile(
    r"(?i)(?:\.bak$|~$|(?:^|[-_.])(?:old|backup|copy|tmp)(?:[-_.]|$))"
)
PERSONAL_PATH = "/Users/" + "alexagizim"
EXPLICIT_ANCHOR = re.compile(r'<a\s+id=["\']([^"\']+)["\']\s*></a>', re.I)
HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*$", re.M)
MARKDOWN_LINK = re.compile(r"!?\[([^\]]*)\]\(([^)]+)\)")
INPUT_LINK = re.compile(
    r"^- ([A-Za-z][A-Za-z ]+ input): \[([^\]]+)\]\(([^)]+)\)\s*$",
    re.M,
)
IDENTIFIER = re.compile(
    r"\b(?:"
    r"GAP-AF-\d{2}|"
    r"SYS-[A-Z][A-Z0-9]*-\d{3}|"
    r"CMP-[A-Z0-9]+(?:-[A-Z0-9]+)*|"
    r"IF-[A-Z0-9]+-\d{3}|"
    r"AF-[A-Z0-9]+(?:-[A-Z0-9]+)+|"
    r"CR-[A-Z0-9]+(?:-[A-Z0-9]+)*|"
    r"REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*-\d{3}|"
    r"UT-[A-Z0-9]+(?:-[A-Z0-9]+)*-\d{3}|"
    r"UI-(?:INT|AT|TRC)-\d{3}"
    r")\b"
)
STABLE_ANCHOR = re.compile(
    r"^(?:gap-af-\d{2}|sys-[a-z0-9]+-\d{3}|cmp-[a-z0-9-]+|"
    r"if-[a-z0-9]+-\d{3}|af-[a-z0-9-]+|cr-[a-z0-9-]+|"
    r"req-[a-z0-9]+(?:-[a-z0-9]+)*-\d{3}|"
    r"ut-[a-z0-9]+(?:-[a-z0-9]+)*-\d{3}|"
    r"ui-(?:int|at|trc)-\d{3})$"
)


@dataclass(frozen=True)
class Issue:
    path: str
    message: str

    def render(self) -> str:
        return f"{self.path}: {self.message}"


@dataclass(frozen=True)
class WorkspaceRepository:
    directory: str
    path: Path
    github_path: str | None
    accepted_revision: str | None


def github_repository_path(url: str) -> str | None:
    parsed = urlsplit(url)
    if parsed.scheme not in {"http", "https"} or parsed.netloc.lower() != "github.com":
        return None
    path = parsed.path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = [part for part in path.split("/") if part]
    if len(parts) < 2:
        return None
    return "/".join(parts[:2]).lower()


def workspace_repositories(root: Path) -> tuple[WorkspaceRepository, ...]:
    manifest = root / "workspace" / "repositories.json"
    if not manifest.is_file():
        return ()
    data = json.loads(manifest.read_text(encoding="utf-8"))
    repositories: list[WorkspaceRepository] = []
    for item in data.get("repositories", []):
        directory = item.get("directory")
        repository = item.get("repository")
        if not isinstance(directory, str) or not directory:
            continue
        repositories.append(
            WorkspaceRepository(
                directory=directory,
                path=(root.parent / directory).resolve(),
                github_path=(
                    github_repository_path(repository)
                    if isinstance(repository, str)
                    else None
                ),
                accepted_revision=item.get("acceptedRevision"),
            )
        )
    return tuple(repositories)


def workspace_repository_for_url(
    repositories: tuple[WorkspaceRepository, ...], url: str
) -> WorkspaceRepository | None:
    target = github_repository_path(url)
    if target is None:
        return None
    return next(
        (repository for repository in repositories if repository.github_path == target),
        None,
    )


def markdown_documents(root: Path) -> dict[Path, str]:
    paths = list(root.glob("*.md"))
    excluded = {".git", ".venv", "node_modules", "build", "dist", "out",
                "__pycache__", "artifacts", ".local", ".cache"}
    for area in ("docs", "contracts", "apps", "scripts", "components", "tests", "workspace"):
        for directory, children, files in os.walk(root / area):
            children[:] = sorted(name for name in children if name not in excluded)
            paths.extend(Path(directory) / name for name in sorted(files) if name.endswith(".md"))
    return {
        path.resolve(): path.read_text(encoding="utf-8")
        for path in paths
        if path.is_file()
    }


READER_ROUTES = (
    "README.md", "CONTRIBUTING.md", "docs/getting-started/README.md",
    "docs/getting-started/release-status.md",
    "docs/getting-started/installed-preview-cloud-first-use.md",
    "docs/getting-started/reproduce-demo.md",
    "docs/getting-started/full-source-build.md",
    "docs/getting-started/troubleshooting.md",
    "docs/getting-started/macos-developer-tools.md",
    "docs/getting-started/unified-macos-launcher.md",
    "docs/architecture/product-map.md", "docs/operations/current-demo-workflow.md",
    "docs/operations/README.md", "docs/demo/README.md",
)


USER_GUIDES = {
    "README.md", "docs/architecture/product-map.md", "docs/demo/README.md",
    "docs/operations/README.md", "docs/operations/current-demo-workflow.md",
}
INTERNAL_STATUS_HEADING = re.compile(
    r"^#{1,6}\s+(?:What is still being qualified|"
    r"Remaining (?:qualification|acceptance|release) gates|"
    r"Before claiming full source support|Release-owner activation|"
    r"Private maintainer route)\b", re.I | re.M,
)
INTERNAL_STATUS_NARRATIVE = re.compile(
    r"\b(?:Kit\d{3}|Setup\d{3}|VDP-TIMEOUT-\d+)\b|"
    r"\b(?:M1|runtime|native|clean-host|public-consumer) "
    r"(?:qualification )?(?:campaign|evidence|proof)\b|"
    r"\bpassed \d+ (?:API|visible|scripted|installed)\b", re.I,
)


def check_user_guide_audience(root: Path, documents: dict[Path, str]) -> list[Issue]:
    """Keep installation/use instructions separate from internal status records."""
    issues: list[Issue] = []
    for source, text in documents.items():
        name = relative(root, source)
        if name not in USER_GUIDES and not name.startswith("docs/getting-started/"):
            continue
        if INTERNAL_STATUS_HEADING.search(text) or INTERNAL_STATUS_NARRATIVE.search(text):
            issues.append(Issue(name, "internal qualification/history belongs in engineering records, not a user guide"))
        for _, raw in markdown_links(text):
            target = link_target(raw)
            parsed = urlsplit(target)
            if parsed.scheme:
                hosted = re.fullmatch(
                    r"/alexmaninblack/aosedge-sdv-demo/(?:blob|tree)/[^/]+/(.+)",
                    unquote(parsed.path),
                ) if parsed.netloc.lower() == "github.com" else None
                if not hosted:
                    continue
                destination_name = hosted[1]
            else:
                destination, _ = resolve_local_target(root, source, raw)
                destination_name = relative(root, destination)
            if destination_name.startswith((
                "docs/qualification/", "docs/planning/", "workspace/checkpoints/",
            )):
                issues.append(Issue(name, "user guide links to an internal test/backlog record; use the engineering documentation map"))
    return issues


def pinned_workspace_link(repository: WorkspaceRepository, url: str) -> bool:
    parsed = urlsplit(url)
    parts = unquote(parsed.path).split("/")
    return (
        parsed.scheme == "https" and not parsed.query
        and len(parts) >= 6 and parts[3] in {"blob", "tree"}
        and bool(re.fullmatch(r"[a-f0-9]{40}", parts[4]))
        and all(part not in {"", ".", ".."} for part in parts[5:])
    )


def current_workspace_link(repository: WorkspaceRepository, url: str) -> bool:
    """Human navigation follows maintained main; this never selects build inputs."""
    parsed = urlsplit(url)
    parts = unquote(parsed.path).rstrip("/").split("/")
    return (parsed.scheme == "https" and not parsed.query and
            (len(parts) == 3 or
             len(parts) >= 6 and parts[3] in {"blob", "tree"} and parts[4] == "main"
             and all(part not in {"", ".", ".."} for part in parts[5:])))


def relative(root: Path, path: Path) -> str:
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return str(path)


def github_slug(value: str) -> str:
    value = re.sub(r"<[^>]+>", "", value)
    value = value.replace("`", "").replace("*", "").replace("_", "")
    value = value.lower().strip()
    value = re.sub(r"[^\w\s-]", "", value)
    return re.sub(r"[\s-]+", "-", value).strip("-")


def anchors(text: str) -> set[str]:
    values = {value.lower() for value in EXPLICIT_ANCHOR.findall(text)}
    generated: Counter[str] = Counter()
    for heading in HEADING.findall(text):
        base = github_slug(heading)
        if not base:
            continue
        suffix = generated[base]
        generated[base] += 1
        values.add(base if suffix == 0 else f"{base}-{suffix}")
    return values


def link_target(raw: str) -> str:
    value = raw.strip()
    if value.startswith("<") and ">" in value:
        return value[1 : value.index(">")]
    return value.split(maxsplit=1)[0]


def markdown_links(text: str) -> list[tuple[str, str]]:
    """Reader-visible inline/reference/image/HTML links, excluding fenced examples."""
    visible = re.sub(r"(?ms)^\s*(`{3,}|~{3,})[^\n]*\n.*?^\s*\1\s*$", "", text)
    result = MARKDOWN_LINK.findall(visible)
    references = {key.strip().casefold(): target for key, target in re.findall(
        r"(?m)^\s*\[([^\]]+)\]:\s*(<[^>]+>|\S+)", visible)}
    for title, key in re.findall(r"!?\[([^\]]+)\]\[([^\]]*)\]", visible):
        name = (key or title).strip().casefold()
        result.append((title, references.get(name, "missing-reference-" + name)))
    result.extend((key, target) for key, target in references.items())
    result.extend(("HTML reference", target) for target in re.findall(
        r"(?i)\b(?:href|src)=[\"']([^\"']+)[\"']", visible))
    result.extend(("Autolink", target) for target in re.findall(r"<(https?://[^>\s]+)>", visible))
    return result


def resolve_local_target(root: Path, source: Path, raw: str) -> tuple[Path, str]:
    target = unquote(link_target(raw))
    path_part, _, fragment = target.partition("#")
    destination = source if not path_part else (source.parent / path_part)
    destination = destination.resolve()
    if destination.is_dir():
        if (destination / "README.md").is_file():
            destination = destination / "README.md"
    return destination, fragment.lower()


def check_links(
    root: Path, documents: dict[Path, str], source_paths: set[Path] | None = None
) -> tuple[list[Issue], dict[Path, set[Path]], set[str]]:
    issues: list[Issue] = []
    graph = {path: set() for path in documents}
    external: set[str] = set()
    anchor_cache = {path: anchors(text) for path, text in documents.items()}
    repositories = workspace_repositories(root)
    for source, text in documents.items():
        if source_paths is not None and source not in source_paths:
            continue
        for _, raw in markdown_links(text):
            target = link_target(raw)
            scheme = urlsplit(target).scheme.lower()
            if scheme in {"http", "https"}:
                external.add(target)
                repository = workspace_repository_for_url(repositories, target)
                if repository is not None and not (
                    pinned_workspace_link(repository, target) or current_workspace_link(repository, target)
                ):
                    issues.append(
                        Issue(
                            relative(root, source),
                            "workspace repository link must use a safe main documentation URL "
                            f"or immutable full-revision URL for {repository.directory}: {target}",
                        )
                    )
                continue
            if scheme in {"mailto", "data"}:
                continue
            if scheme or target.startswith("//"):
                issues.append(Issue(relative(root, source), f"unsupported link: {target}"))
                continue
            destination, fragment = resolve_local_target(root, source, raw)
            inside_root = destination.is_relative_to(root.resolve())
            if source_paths is not None and not inside_root:
                issues.append(Issue(relative(root, source), f"reader route requires a sibling checkout: {target}"))
                continue
            sibling = next(
                (
                    repository
                    for repository in repositories
                    if destination.is_relative_to(repository.path)
                ),
                None,
            )
            if not inside_root and sibling is None:
                issues.append(Issue(relative(root, source), f"link leaves repository: {target}"))
                continue
            if not destination.exists():
                issues.append(Issue(relative(root, source), f"missing link target: {target}"))
                continue
            if destination.suffix.lower() == ".md":
                if inside_root and destination not in documents:
                    issues.append(
                        Issue(relative(root, source), f"Markdown target was not scanned: {target}")
                    )
                    continue
                if inside_root:
                    graph[source].add(destination)
                    target_anchors = anchor_cache[destination]
                else:
                    target_anchors = anchors(destination.read_text(encoding="utf-8"))
                if fragment and fragment not in target_anchors:
                    issues.append(
                        Issue(relative(root, source), f"missing anchor in {target}")
                    )
    return issues, graph, external


def check_reachability(
    root: Path, documents: dict[Path, str], graph: dict[Path, set[Path]]
) -> list[Issue]:
    start = (root / "docs" / "README.md").resolve()
    if start not in documents:
        return [Issue("docs/README.md", "documentation map is missing")]
    reached = {start}
    queue = deque([start])
    while queue:
        source = queue.popleft()
        for destination in graph.get(source, set()):
            if destination not in reached:
                reached.add(destination)
                queue.append(destination)
    return [
        Issue(relative(root, path), "document is not reachable from docs/README.md")
        for path in sorted(documents)
        if path != (root / "README.md").resolve()
        and path.is_relative_to((root / "docs").resolve())
        and path not in reached
    ]


def check_identifiers(root: Path, documents: dict[Path, str]) -> tuple[list[Issue], set[str]]:
    issues: list[Issue] = []
    definitions: dict[str, list[Path]] = {}
    references: dict[str, set[Path]] = {}
    for path, text in documents.items():
        for value in EXPLICIT_ANCHOR.findall(text):
            normalized = value.lower()
            if STABLE_ANCHOR.fullmatch(normalized):
                identifier = normalized.upper()
                definitions.setdefault(identifier, []).append(path)
        for identifier in IDENTIFIER.findall(text):
            references.setdefault(identifier, set()).add(path)
    for identifier, paths in sorted(definitions.items()):
        if len(paths) != 1:
            rendered = ", ".join(relative(root, path) for path in paths)
            issues.append(Issue(rendered, f"duplicate identifier definition: {identifier}"))
    for identifier, paths in sorted(references.items()):
        if identifier not in definitions:
            rendered = ", ".join(relative(root, path) for path in sorted(paths))
            issues.append(Issue(rendered, f"undefined identifier: {identifier}"))
    return issues, set(definitions)


def metadata(text: str, field: str) -> str | None:
    match = re.search(rf"^- {re.escape(field)}: (.+)$", text, re.M)
    return match.group(1).strip() if match else None


def named_document_versions(title: str, fragment: str = "") -> list[str]:
    # D4-026.17 is a stable decision identifier, not document version 026.17.
    # Likewise, a requirement about product v1.0 does not name its doc version.
    if re.match(r"(?:req|ut|sys|cmp|if|d4)-", fragment.lower()):
        return []
    return re.findall(r"(?<![\w.-])v?(\d+\.\d+(?:\.\d+)?)\b", title)


def retired_identifiers(text: str) -> set[str]:
    """Return stable IDs declared in explicitly labelled retired sections."""

    retired: set[str] = set()
    section = re.compile(
        r"(?ms)^#{2,6}\s+Retired[^\n]*\n(.*?)(?=^#{1,6}\s+|\Z)"
    )
    for match in section.finditer(text):
        retired.update(anchor.upper() for anchor in EXPLICIT_ANCHOR.findall(match.group(1)))
    return retired


def check_metadata(root: Path, documents: dict[Path, str]) -> list[Issue]:
    issues: list[Issue] = []
    canonical_paths = {(root / path).resolve() for path in CANONICAL_DOCUMENTS}
    for relative_path in CANONICAL_DOCUMENTS:
        path = (root / relative_path).resolve()
        text = documents.get(path)
        if text is None:
            issues.append(Issue(relative_path.as_posix(), "canonical document is missing"))
            continue
        for field in REQUIRED_METADATA:
            if not metadata(text, field):
                issues.append(Issue(relative_path.as_posix(), f"missing metadata: {field}"))
        status = (metadata(text, "Status") or "").lower()
        if status and not status.startswith(ALLOWED_STATUSES):
            issues.append(Issue(relative_path.as_posix(), f"unsupported status: {status}"))
        prepared = metadata(text, "Prepared") or ""
        if prepared and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", prepared):
            issues.append(Issue(relative_path.as_posix(), f"invalid Prepared date: {prepared}"))
        for label, title, raw_target in INPUT_LINK.findall(text):
            destination, _ = resolve_local_target(root, path, raw_target)
            target_text = documents.get(destination)
            if target_text is None:
                continue
            target_version = metadata(target_text, "Version")
            if target_version and target_version not in title:
                issues.append(
                    Issue(
                        relative_path.as_posix(),
                        f"{label} label does not name target version {target_version}: {title}",
                    )
                )
    for source, text in documents.items():
        for title, raw_target in markdown_links(text):
            destination, _ = resolve_local_target(root, source, raw_target)
            if destination not in documents or destination.suffix != ".md":
                continue
            target_text = documents.get(destination)
            target_version = metadata(target_text or "", "Version")
            named_versions = named_document_versions(title, urlsplit(link_target(raw_target)).fragment)
            if target_version and named_versions and target_version not in named_versions:
                issues.append(
                    Issue(
                        relative(root, source),
                        ("versioned canonical link label is stale: " if destination in canonical_paths
                         else "versioned document link label is stale: ") +
                        f"{title} names {', '.join(named_versions)}, target is {target_version}",
                    )
                )
    return issues


def check_traceability(root: Path, documents: dict[Path, str], definitions: set[str]) -> list[Issue]:
    issues: list[Issue] = []
    register = (
        root / "docs" / "requirements" / "component-decomposition-and-interface-register.md"
    ).resolve()
    text = documents.get(register, "")
    retired_register_ids = retired_identifiers(text)
    start = text.find("## Detailed Package Traceability")
    end = text.find(BOUNDARY_DECISION_HEADING, start)
    traceability = text[start:end] if start >= 0 and end > start else ""
    allocated = {value for value in IDENTIFIER.findall(traceability) if value.startswith("SYS-")}
    retired_system_ids = {
        value
        for document in documents.values()
        for value in retired_identifiers(document)
        if value.startswith("SYS-")
    }
    system_requirements = {
        value
        for value in definitions
        if value.startswith("SYS-") and value not in retired_system_ids
    }
    for identifier in sorted(system_requirements - allocated):
        issues.append(Issue(relative(root, register), f"system requirement is not allocated: {identifier}"))

    requirements = (
        root / "docs" / "requirements" / "system-requirements-and-traceability.md"
    ).resolve()
    requirements_text = documents.get(requirements, "")
    for line_number, line in enumerate(requirements_text.splitlines(), start=1):
        match = re.search(r'<a id="(sys-[a-z0-9-]+)"></a>', line)
        if not match:
            continue
        if match.group(1).upper() in retired_identifiers(requirements_text):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 5 or not cells[1]:
            issues.append(
                Issue(
                    f"{relative(root, requirements)}:{line_number}",
                    f"requirement {match.group(1).upper()} must have a short name",
                )
            )

    flows = (
        root / "docs" / "architecture" / "demo-scenario-architecture-flows.md"
    ).resolve()
    flows_text = documents.get(flows, "")
    for line_number, line in enumerate(flows_text.splitlines(), start=1):
        match = re.search(r'<a id="(gap-af-\d{2})"></a>', line)
        if not match:
            continue
        if match.group(1).upper() in retired_identifiers(flows_text):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 5 or not cells[1]:
            issues.append(
                Issue(
                    f"{relative(root, flows)}:{line_number}",
                    f"gap {match.group(1).upper()} must have a short name",
                )
            )

    for line_number, line in enumerate(text.splitlines(), start=1):
        match = re.search(r'<a id="(if-[a-z0-9-]+)"></a>', line)
        if not match:
            continue
        if match.group(1).upper() in retired_register_ids:
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 6 or not cells[1] or not cells[2]:
            issues.append(
                Issue(
                    f"{relative(root, register)}:{line_number}",
                    f"interface {match.group(1).upper()} must have producer and consumer",
                )
            )
    return issues


def check_reader_traceability(root: Path, documents: dict[Path, str]) -> list[Issue]:
    """Keep the component-package reader view useful without losing exact links."""

    issues: list[Issue] = []
    register = (
        root / "docs" / "requirements" / "component-decomposition-and-interface-register.md"
    ).resolve()
    text = documents.get(register, "")
    retired_register_ids = retired_identifiers(text)
    packages_start = text.find("## Provisional Component Requirement Packages")
    details_start = text.find("## Detailed Package Traceability", packages_start)
    details_end = text.find(BOUNDARY_DECISION_HEADING, details_start)
    if packages_start < 0 or details_start < 0 or details_end < 0:
        issues.append(Issue(relative(root, register), "component package traceability sections are missing"))
        return issues

    reader_view = text[packages_start:details_start]
    if "| Package | Human-readable responsibility |" not in reader_view:
        issues.append(Issue(relative(root, register), "component package reader view is missing"))
    reader_system_ids = sorted(
        {value for value in IDENTIFIER.findall(reader_view) if value.startswith("SYS-")}
    )
    if reader_system_ids:
        issues.append(
            Issue(
                relative(root, register),
                "reader view contains unexplained system identifiers: "
                + ", ".join(reader_system_ids),
            )
        )

    for line_number, line in enumerate(reader_view.splitlines(), start=1):
        match = re.search(r'<a id="(cr-[a-z0-9-]+)"></a>', line)
        if not match:
            continue
        if match.group(1).upper() in retired_register_ids:
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 4 or not cells[1]:
            issues.append(
                Issue(
                    f"{relative(root, register)}:{line_number}",
                    f"package {match.group(1).upper()} must have a human-readable responsibility",
                )
            )

    details = text[details_start:details_end]
    unlinked_details = MARKDOWN_LINK.sub("", details)
    unlinked_system_ids = sorted(
        {value for value in IDENTIFIER.findall(unlinked_details) if value.startswith("SYS-")}
    )
    for identifier in unlinked_system_ids:
        issues.append(
            Issue(
                relative(root, register),
                f"detailed package reference must use a named direct link: {identifier}",
            )
        )
    return issues


def check_component_requirement_packages(
    root: Path, documents: dict[Path, str]
) -> list[Issue]:
    """Reject a concrete component requirement without a linked SYS parent."""

    issues: list[Issue] = []
    packages = (root / "docs" / "requirements" / "components").resolve()
    for path, text in sorted(documents.items()):
        if path.parent != packages or path.name in {"README.md", "template.md"}:
            continue
        matches = list(re.finditer(r'<a id="(req-[a-z0-9-]+)"></a>', text))
        verification = text.find("## Verification Traceability")
        for index, match in enumerate(matches):
            end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
            if verification > match.end():
                end = min(end, verification)
            section = text[match.end():end]
            parent_links = [
                target
                for _, target in markdown_links(section)
                if "#sys-" in target.lower()
            ]
            if not parent_links:
                line_number = text.count("\n", 0, match.start()) + 1
                issues.append(
                    Issue(
                        f"{relative(root, path)}:{line_number}",
                        f"component requirement {match.group(1).upper()} must link at least one parent system requirement",
                    )
                )
    return issues


def ui_numbered_anchors(text: str, prefix: str) -> set[int]:
    pattern = re.compile(rf'<a id="{re.escape(prefix)}-(\d{{3}})"></a>')
    return {int(value) for value in pattern.findall(text)}


def expanded_ui_interaction_references(text: str) -> set[int]:
    references = {int(value) for value in re.findall(r"UI-INT-(\d{3})", text)}
    ranges = re.compile(
        r"UI-INT-(\d{3})`?\s*[–-]\s*`?(?:UI-INT-)?(\d{3})"
    )
    for start_text, end_text in ranges.findall(text):
        start = int(start_text)
        end = int(end_text)
        if end >= start:
            references.update(range(start, end + 1))
    return references


def check_ui_traceability(root: Path, documents: dict[Path, str]) -> list[Issue]:
    """Require complete stable interaction-to-acceptance-case coverage."""

    issues: list[Issue] = []
    specification = (
        root
        / "docs"
        / "demo"
        / "mockups"
        / "aosedge-demo-interaction-specification.md"
    ).resolve()
    text = documents.get(specification)
    if text is None:
        return [
            Issue(
                relative(root, specification),
                "interaction specification is missing",
            )
        ]

    path = relative(root, specification)
    interactions = ui_numbered_anchors(text, "ui-int")
    cases = ui_numbered_anchors(text, "ui-at")
    expected_interactions = set(range(1, 80))
    expected_cases = set(range(1, 51))

    for value in sorted(expected_interactions - interactions):
        issues.append(Issue(path, f"missing UI interaction definition: UI-INT-{value:03d}"))
    for value in sorted(interactions - expected_interactions):
        issues.append(Issue(path, f"unexpected UI interaction definition: UI-INT-{value:03d}"))
    for value in sorted(expected_cases - cases):
        issues.append(Issue(path, f"missing UI acceptance case: UI-AT-{value:03d}"))
    for value in sorted(cases - expected_cases):
        issues.append(Issue(path, f"unexpected UI acceptance case: UI-AT-{value:03d}"))

    section_start = text.find("## 9. Traceability and UI Acceptance Cases")
    if section_start < 0:
        issues.append(Issue(path, "UI traceability section is missing"))
        return issues
    traceability = text[section_start:]
    covered = expanded_ui_interaction_references(traceability)
    for value in sorted(interactions - covered):
        issues.append(Issue(path, f"UI interaction is not covered: UI-INT-{value:03d}"))

    case_rows: dict[int, str] = {}
    for line in traceability.splitlines():
        match = re.search(r'<a id="ui-at-(\d{3})"></a>', line)
        if match:
            case_rows[int(match.group(1))] = line
    for value in sorted(cases):
        row = case_rows.get(value, "")
        if not expanded_ui_interaction_references(row):
            issues.append(
                Issue(path, f"UI acceptance case has no interaction coverage: UI-AT-{value:03d}")
            )

    register = (
        root
        / "docs"
        / "demo"
        / "mockups"
        / "aosedge-demo-ui-traceability-register.md"
    ).resolve()
    register_text = documents.get(register)
    register_path = relative(root, register)
    if register_text is None:
        issues.append(Issue(register_path, "UI traceability register is missing"))
        return issues

    register_rows: dict[int, list[tuple[int, list[str]]]] = {}
    for line_number, line in enumerate(register_text.splitlines(), start=1):
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 5:
            continue
        match = re.search(r"\[`UI-INT-(\d{3})`\]\([^)]*#ui-int-\1\)", cells[0])
        if not match:
            continue
        value = int(match.group(1))
        register_rows.setdefault(value, []).append((line_number, cells))

    register_ids = set(register_rows)
    for value in sorted(expected_interactions - register_ids):
        issues.append(
            Issue(register_path, f"missing UI traceability row: UI-INT-{value:03d}")
        )
    for value in sorted(register_ids - expected_interactions):
        issues.append(
            Issue(register_path, f"unexpected UI traceability row: UI-INT-{value:03d}")
        )
    for value, rows in sorted(register_rows.items()):
        if len(rows) != 1:
            issues.append(
                Issue(register_path, f"duplicate UI traceability row: UI-INT-{value:03d}")
            )
            continue
        line_number, cells = rows[0]
        location = f"{register_path}:{line_number}"
        upstream = cells[1].lower()
        if not any(anchor in upstream for anchor in ("#d4-", "#req-", "#sys-", "#adr-")):
            issues.append(
                Issue(location, f"UI-INT-{value:03d} traceability row has no linked upstream owner")
            )
        if "UI-I0-" not in cells[2]:
            issues.append(
                Issue(location, f"UI-INT-{value:03d} traceability row has no I0 surface")
            )
        if "UI-AT-" not in cells[3]:
            issues.append(
                Issue(location, f"UI-INT-{value:03d} traceability row has no acceptance case")
            )
        if cells[4] not in {"`DESIGNED`", "`IMPLEMENTED`", "`QUALIFIED`"}:
            issues.append(
                Issue(location, f"UI-INT-{value:03d} traceability row has invalid status")
            )
    return issues


def check_hygiene(root: Path, documents: dict[Path, str]) -> list[Issue]:
    issues: list[Issue] = []
    docs_root = root / "docs"
    for path in sorted(docs_root.rglob("*")):
        if not path.is_file():
            continue
        if path.name == ".DS_Store":
            continue
        elif path.suffix.lower() not in ALLOWED_DOC_SUFFIXES:
            issues.append(Issue(relative(root, path), "unexpected documentation artifact type"))
        elif OBSOLETE_NAME.search(path.name):
            issues.append(Issue(relative(root, path), "obsolete or backup-style artifact name"))
    for path, text in documents.items():
        if path.is_relative_to(docs_root.resolve()):
            if "SPDX-FileCopyrightText:" not in text[:500]:
                issues.append(Issue(relative(root, path), "missing SPDX copyright header"))
            if "SPDX-License-Identifier:" not in text[:500]:
                issues.append(Issue(relative(root, path), "missing SPDX license header"))
        if PERSONAL_PATH in text:
            issues.append(Issue(relative(root, path), "personal absolute path is prohibited"))
        if "file:///" in text:
            issues.append(Issue(relative(root, path), "file URL is prohibited"))
    gitignore = root / ".gitignore"
    ignored = gitignore.read_text(encoding="utf-8") if gitignore.is_file() else ""
    if not re.search(r"(?m)^\.DS_Store$", ignored):
        issues.append(Issue(".gitignore", "must ignore macOS .DS_Store artifacts"))
    if not re.search(r"(?m)^\.obsidian/$", ignored):
        issues.append(Issue(".gitignore", "must ignore local Obsidian preferences"))
    return issues


def check_mermaid(root: Path, documents: dict[Path, str]) -> tuple[list[Issue], int]:
    """Check fenced Mermaid structure and conservative cross-renderer syntax."""

    issues: list[Issue] = []
    diagram_count = 0
    for path, text in documents.items():
        inside = False
        diagram_start = 0
        diagram_type_seen = False
        diagram_type = ""
        for line_number, line in enumerate(text.splitlines(), start=1):
            stripped = line.strip()
            if not inside and stripped == "```mermaid":
                inside = True
                diagram_start = line_number
                diagram_type_seen = False
                diagram_type = ""
                diagram_count += 1
                continue
            if inside and stripped.startswith("```"):
                if not diagram_type_seen:
                    issues.append(
                        Issue(
                            f"{relative(root, path)}:{diagram_start}",
                            "empty Mermaid diagram",
                        )
                    )
                inside = False
                continue
            if not inside or not stripped:
                continue
            if not diagram_type_seen:
                diagram_type_seen = True
                diagram_type = stripped.split(maxsplit=1)[0]
                declaration = (
                    r"^(?:flowchart|graph)\s+(?:TB|TD|BT|RL|LR)$|"
                    r"^sequenceDiagram$"
                )
                if not re.match(declaration, stripped):
                    issues.append(
                        Issue(
                            f"{relative(root, path)}:{line_number}",
                            f"unsupported Mermaid diagram declaration: {stripped}",
                        )
                    )
            if diagram_type == "sequenceDiagram" and ";" in line:
                issues.append(
                    Issue(
                        f"{relative(root, path)}:{line_number}",
                        "semicolon in sequenceDiagram source is prohibited "
                        "for cross-renderer compatibility",
                    )
                )
        if inside:
            issues.append(
                Issue(
                    f"{relative(root, path)}:{diagram_start}",
                    "unclosed Mermaid code fence",
                )
            )
    return issues, diagram_count


def check_external_links(urls: set[str]) -> list[Issue]:
    """Bounded parallel probes, never full payload round trips or sign-in bypass."""
    def probe(url: str) -> Issue | None:
        for method in ("HEAD", "GET"):
            headers = {"User-Agent": "aosedge-docs-check/1"}
            if method == "GET":
                headers["Range"] = "bytes=0-1023"
            request = urllib.request.Request(url, method=method, headers=headers)
            try:
                with urllib.request.urlopen(request, timeout=10) as response:
                    if method == "GET":
                        response.read(1024)
                    return None if response.status < 400 else Issue(url, f"HTTP {response.status}")
            except urllib.error.HTTPError as error:
                if method == "HEAD" and error.code in {403, 404, 405}:
                    continue
                return Issue(url, f"HTTP {error.code}")
            except (urllib.error.URLError, TimeoutError) as error:
                return Issue(url, f"external check failed: {error}")
        return None
    with ThreadPoolExecutor(max_workers=8) as executor:
        return [issue for issue in executor.map(probe, sorted(urls)) if issue is not None]


# Current schema-2 selection keeps old report references in Git, not exemptions
# from inspection of the maintained working-tree documentation.
LOCKED_EVIDENCE = frozenset()


def workspace_documentation(root: Path) -> tuple[dict[Path, str], tuple[WorkspaceRepository, ...], list[Issue]]:
    """Inspect owned integration/components, not licensed engine source or caches."""
    root = root.resolve()
    repositories = (WorkspaceRepository(root.name, root,
        "alexmaninblack/aosedge-sdv-demo", None), *(
        item for item in workspace_repositories(root)
        if item.directory not in {"CarlaSim", "UnrealEngine5_carla"}))
    documents: dict[Path, str] = {}
    issues: list[Issue] = []
    for repository in repositories:
        result = subprocess.run(["git", "-C", str(repository.path), "ls-files", "-z",
            "--cached", "--others", "--exclude-standard", "--", "*.md"],
            capture_output=True, check=False)
        if result.returncode:
            issues.append(Issue(repository.directory, "workspace documentation requires its Git checkout"))
            continue
        for name in result.stdout.decode().split("\0"):
            path = repository.path / name
            if name and path.is_file():
                documents[path.resolve()] = path.read_text(encoding="utf-8")
    return documents, tuple(repositories), issues


def check_current_guidance(root: Path, documents: dict[Path, str]) -> list[Issue]:
    issues: list[Issue] = []
    for path, text in documents.items():
        name = relative(root, path)
        if name in LOCKED_EVIDENCE:
            continue
        # Current specifications own obligations, not a replay of every version
        # review. Exact old decisions remain available through immutable Git.
        current_specification = name.startswith((
            "contracts/", "docs/requirements/", "docs/architecture/", "docs/planning/",
        ))
        if current_specification and re.search(
            r"^#{2,6}\s+(?:(?:Architecture-Flow )?Acceptance Record(?: and Delta| for Version| and Version)|"
            r"Review Record for Version|D3 Acceptance Record|Version \d+(?:\.\d+)* Acceptance and Delta)\b",
            text, re.M,
        ):
            issues.append(Issue(name, "completed version-review diaries belong in immutable Git, not current specifications"))
        if re.search(r"Current implementation status \([^\n]*(?:Kit\d+|Setup\d+)", text):
            issues.append(Issue(name, "copied historical release status must link to the current protocol map"))
        if re.search(r"^- D3 implementation snapshot|\| D3 implementation snapshot \|", text, re.M):
            issues.append(Issue(name, "historical D3 implementation snapshots must not compete with the current baseline"))
        if re.search(r"Google Drive holds reviewed developer inputs|The next new candidate is", text):
            issues.append(Issue(name, "current delivery/version selection must come from the source-owned catalogs"))
        if re.search(r"The HTML mockups are design/test fixtures", text):
            issues.append(Issue(name, "retired HTML prototypes must not be described as present"))
        if path.name == "aosvm-apple-silicon.md" and re.search(
            r"To reproduce the larger SDV demo,\s*complete this guide first", text, re.I):
            issues.append(Issue(name, "standalone AosVM is not an SDV Lab prerequisite"))
        if path.name == "README.md" and path.parent.name in {
            "carla-ego-runtime", "aos-vehicle-platform", "brake-health-service",
            "brake-health-cloud", "tire-health-service", "tire-health-cloud"}:
            if re.search(r"Mounted external APFS volume|export TMPDIR=|await the joint walkthrough|walkthrough has not been executed", text):
                issues.append(Issue(name, "component quickstart retains superseded storage or editing-history instructions"))
    return issues


def check_workspace(root: Path) -> tuple[list[Issue], int, set[str]]:
    root = root.resolve()
    documents, repositories, issues = workspace_documentation(root)
    issues.extend(check_current_guidance(root, documents))
    external: set[str] = set()
    historical: dict[tuple[Path, str, str], bytes | None] = {}
    for source, text in sorted(documents.items()):
        owner = next(item for item in repositories if source.is_relative_to(item.path))
        for title, raw in markdown_links(text):
            target = link_target(raw)
            parsed = urlsplit(target)
            destination: Path | None = None
            body: str | None = None
            if parsed.scheme in {"http", "https"}:
                repository = workspace_repository_for_url(repositories, target)
                if repository is None:
                    external.add(target)
                    continue
                if not (current_workspace_link(repository, target) or pinned_workspace_link(repository, target)):
                    issues.append(Issue(relative(root, source), f"unsafe hosted workspace reference: {target}"))
                    continue
                parts = unquote(parsed.path).rstrip("/").split("/")
                if len(parts) == 3:
                    continue
                revision, name = parts[4], "/".join(parts[5:])
                if revision != "main":
                    if (name == "README.md" and repository.path != root and
                            relative(root, source) not in LOCKED_EVIDENCE):
                        issues.append(Issue(relative(root, source), "current component README navigation must use main; keep exact source pins in provenance records"))
                    key = (repository.path, revision, name)
                    if key not in historical:
                        result = subprocess.run(["git", "-C", str(repository.path), "show",
                            f"{revision}:{name}"], capture_output=True, check=False)
                        historical[key] = result.stdout if result.returncode == 0 else None
                    content = historical[key]
                    if content is None:
                        issues.append(Issue(relative(root, source), f"missing immutable Git target: {target}"))
                    elif name.endswith(".md") and parsed.fragment and unquote(parsed.fragment).lower() not in anchors(content.decode()):
                        issues.append(Issue(relative(root, source), f"missing immutable Git anchor: {target}"))
                    continue
                destination = (repository.path / name).resolve()
                if not destination.is_relative_to(repository.path):
                    issues.append(Issue(relative(root, source), f"hosted path leaves repository: {target}"))
                    continue
            elif parsed.scheme in {"mailto", "data"}:
                continue
            elif parsed.scheme or target.startswith("//"):
                issues.append(Issue(relative(root, source), f"unsupported link: {target}"))
                continue
            else:
                destination, _ = resolve_local_target(root, source, raw)
                if (not destination.is_relative_to(owner.path) and
                        relative(root, source) not in LOCKED_EVIDENCE):
                    issues.append(Issue(relative(root, source), f"GitHub-unsafe sibling link; use the owning repository HTTPS URL: {target}"))
            if destination.is_dir():
                destination = destination / "README.md" if (destination / "README.md").is_file() else destination
            if not destination.exists():
                issues.append(Issue(relative(root, source), f"missing workspace link target: {target}"))
                continue
            if destination.suffix == ".md" and destination.is_file():
                body = documents.get(destination) or destination.read_text(encoding="utf-8")
                if parsed.fragment and unquote(parsed.fragment).lower() not in anchors(body):
                    issues.append(Issue(relative(root, source), f"missing workspace anchor: {target}"))
                version = metadata(body, "Version")
                named = named_document_versions(title, parsed.fragment)
                if version and named and version not in named:
                    issues.append(Issue(relative(root, source), f"versioned document link label is stale: {title}, target is {version}"))
    return issues, len(documents), external


def check_repository(
    root: Path, include_external: bool = False
) -> tuple[list[Issue], int, int, int]:
    root = root.resolve()
    documents = markdown_documents(root)
    issues, graph, external = check_links(root, documents)
    issues.extend(check_reachability(root, documents, graph))
    identifier_issues, definitions = check_identifiers(root, documents)
    issues.extend(identifier_issues)
    issues.extend(check_metadata(root, documents))
    issues.extend(check_traceability(root, documents, definitions))
    issues.extend(check_reader_traceability(root, documents))
    issues.extend(check_component_requirement_packages(root, documents))
    issues.extend(check_ui_traceability(root, documents))
    issues.extend(check_hygiene(root, documents))
    issues.extend(check_user_guide_audience(root, documents))
    issues.extend(check_current_guidance(root, documents))
    mermaid_issues, diagram_count = check_mermaid(root, documents)
    issues.extend(mermaid_issues)
    if include_external:
        issues.extend(check_external_links(external))
    return (
        sorted(issues, key=lambda issue: (issue.path, issue.message)),
        len(documents),
        len(definitions),
        diagram_count,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--external", action="store_true", help="also check HTTP(S) links")
    parser.add_argument("--reader-routes", action="store_true", help="check initial human routes without sibling checkouts; not the full design gate")
    parser.add_argument("--workspace", action="store_true", help="also audit every tracked Markdown document in the six component checkouts, hosted references and GitHub-safe navigation")
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(__file__).resolve().parents[1],
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()
    if args.workspace and args.reader_routes:
        parser.error("--workspace and --reader-routes are separate acceptance scopes")
    if args.reader_routes:
        root = args.root.resolve()
        documents = markdown_documents(root)
        selected = {(root / name).resolve() for name in READER_ROUTES}
        issues, _, external = check_links(root, documents, selected)
        issues.extend(Issue(relative(root, path), "required reader guide is missing")
                      for path in selected if path not in documents)
        issues.extend(check_user_guide_audience(root, documents))
        if args.external:
            issues.extend(check_external_links(external))
        for issue in sorted(issues, key=lambda item: (item.path, item.message)):
            print(f"ERROR {issue.render()}", file=sys.stderr)
        if issues:
            return 1
        print(f"Reader route gate: PASS ({len(selected)} entry documents; no sibling checkout required)")
        return 0
    issues, document_count, identifier_count, diagram_count = check_repository(args.root)
    if args.workspace:
        workspace_issues, workspace_count, external = check_workspace(args.root.resolve())
        issues.extend(workspace_issues)
        if args.external:
            issues.extend(check_external_links(external))
    elif args.external:
        issues.extend(check_external_links(check_links(args.root.resolve(), markdown_documents(args.root))[2]))
    if issues:
        for issue in issues:
            print(f"ERROR {issue.render()}", file=sys.stderr)
        print(f"Documentation quality gate: {len(issues)} error(s)", file=sys.stderr)
        return 1
    print(
        "Documentation quality gate: PASS "
        f"({document_count} Markdown documents, {identifier_count} stable identifiers, "
        f"{diagram_count} Mermaid diagrams)"
    )
    if args.workspace:
        print(f"Workspace documentation gate: PASS ({workspace_count} Markdown documents; GitHub-safe current navigation and immutable Git references)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
