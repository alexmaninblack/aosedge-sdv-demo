#!/bin/sh
# SPDX-FileCopyrightText: 2026 maninblack
# SPDX-License-Identifier: MIT

set -eu
umask 077

mode=${1:-full}
workdirs=/var/aos/workdirs
store=/var/aos/workdirs/sm/runtimes/systemd-slot-component
runtime_root=/var/aos/workdirs/sm/runtimes
backing="$runtime_root/.vehicle-data-provider-store.ext4"
partial="$runtime_root/.vehicle-data-provider-store.ext4.partial"
identity="$runtime_root/.vehicle-data-provider-store.identity"
identity_partial="$runtime_root/.vehicle-data-provider-store.identity.partial"
backup="$runtime_root/.r61-store-failure-backup"
filler="$runtime_root/.r61-store-reserve-probe"
prepare=/usr/libexec/aos-vehicle-data-provider-store-prepare
check=/usr/libexec/aos-vehicle-data-provider-store-check
attach=/usr/libexec/aos-vehicle-data-provider-loop
attach_unit=aos-vehicle-data-provider-store-attach.service
bootstrap_unit=aos-vehicle-data-provider-bootstrap.service
store_unit='var-aos-workdirs-sm-runtimes-systemd\x2dslot\x2dcomponent.mount'
sibling=/var/aos/workdirs/.r61-store-fixture-sibling/secret
marker="$store/state/.r61-store-fixture"
failure_log=/tmp/r61-store-expected-failure.log

fail() {
    printf 'R6.1 isolated store failure matrix failed: %s\n' "$*" >&2
    exit 1
}

expect_failure() {
    expected=$1
    shift
    rm -f "$failure_log"
    status=0
    "$@" >"$failure_log" 2>&1 || status=$?
    [ "$status" -ne 0 ] || fail "failure injection unexpectedly passed: $expected"
    grep -Fi "$expected" "$failure_log" >/dev/null || {
        cat "$failure_log" >&2
        fail "failure injection returned the wrong reason: $expected"
    }
}

require_regular() {
    [ -f "$1" ] && [ ! -L "$1" ] || fail "unsafe or missing file: $1"
}

case "$mode" in
    full|resume-loop) ;;
    *) fail 'usage: r6-1-store-failure-matrix [full|resume-loop]' ;;
esac

stop_store() {
    systemctl stop "$bootstrap_unit" >/dev/null 2>&1 || true
    systemctl stop "$store_unit" || fail 'cannot stop the isolated store mount'
    systemctl stop "$attach_unit" || fail 'cannot detach the isolated store loop'
    [ -z "$(findmnt -rn -M "$store")" ] || fail 'isolated store remained mounted'
    [ -z "$(losetup -j "$backing" 2>/dev/null || true)" ] ||
        fail 'isolated store backing remained attached'
}

start_store() {
    systemctl reset-failed aos-vehicle-data-provider-store-prepare.service \
        "$attach_unit" "$store_unit" "$bootstrap_unit" >/dev/null 2>&1 || true
    systemctl restart aos-vehicle-data-provider-store-prepare.service ||
        fail 'cannot revalidate the restored store image'
    systemctl start "$attach_unit" || fail 'cannot reattach the restored store image'
    systemctl start "$store_unit" || fail 'cannot remount the restored store image'
    systemctl start "$bootstrap_unit" || fail 'cannot validate the restored store layout'
    "$check" >/dev/null || fail 'restored store validation failed'
}

[ "$(id -u)" -eq 0 ] || fail 'this command must run as root'
[ "$(uname -m)" = aarch64 ] || fail 'guest is not AArch64'
grep -qx 'VERSION_ID=6.1.1-maninblack.10' /etc/os-release ||
    fail 'guest is not the accepted .10 rootfs'
[ "$(getenforce)" = Enforcing ] || fail 'SELinux is not enforcing'
if [ "$mode" = full ]; then
    [ "$(findmnt -rn -M "$store" -o FSTYPE)" = ext4 ] ||
        fail 'isolated store is not mounted'
    require_regular "$backing"
    require_regular "$identity"
    [ "$(cat "$marker")" = r6-1-store-fixture-v1 ] ||
        fail 'positive persistence marker is absent'
    [ "$(cat "$sibling")" = 'R6.1 sibling access must remain denied.' ] ||
        fail 'unrelated workdirs fixture is absent'
    [ ! -e "$backup" ] && [ ! -L "$backup" ] || fail 'stale failure backup exists'
    [ ! -e "$filler" ] && [ ! -L "$filler" ] || fail 'stale reserve probe exists'

    stop_store
    install -d -m 0700 "$backup"
    mv "$backing" "$backup/backing.original"
    mv "$identity" "$backup/identity.original"

    # An interrupted, incomplete allocation must remain visible and must not be
    # silently accepted, deleted, or converted into a committed store.
    dd if=/dev/zero of="$partial" bs=1048576 count=1 conv=fsync status=none
    chmod 0600 "$partial"
    expect_failure 'store file size is incorrect' "$prepare" prepare
    [ -f "$partial" ] && [ "$(stat -c %s "$partial")" = 1048576 ] ||
        fail 'interrupted partial image was changed automatically'
    [ ! -e "$backing" ] && [ ! -e "$identity" ] ||
        fail 'interrupted allocation created committed store state'
    rm -f -- "$partial"
    printf 'INTERRUPTED_ALLOCATION=PASS\n'

    # With no committed store, creation must stop before allocation if the fixed
    # 512 MiB store plus 512 MiB platform reserve cannot both fit.
    available_blocks=$(stat -f -c %a "$workdirs")
    block_size=$(stat -f -c %S "$workdirs")
    available=$(( available_blocks * block_size ))
    required=1073741824
    if [ "$available" -ge "$required" ]; then
        fill_bytes=$(( available - required + 16777216 ))
        fill_mebibytes=$(( (fill_bytes + 1048575) / 1048576 ))
        dd if=/dev/zero of="$filler" bs=1048576 count="$fill_mebibytes" \
            conv=fsync status=none
    fi
    expect_failure 'workdirs does not have the accepted creation reserve' \
        "$prepare" prepare
    [ ! -e "$partial" ] && [ ! -e "$backing" ] && [ ! -e "$identity" ] ||
        fail 'insufficient reserve created store state'
    rm -f -- "$filler"
    printf 'INSUFFICIENT_RESERVE=PASS\n'

    mv "$backup/backing.original" "$backing"
    mv "$backup/identity.original" "$identity"
    backing_digest=$(sha256sum "$backing" | cut -d' ' -f1)

    # A canonical but wrong recorded UUID must fail without changing the image.
    cp "$identity" "$backup/identity.valid"
    sed -i 's/^uuid=.*/uuid=00000000-0000-0000-0000-000000000000/' "$identity"
    expect_failure 'store filesystem UUID does not match its identity' \
        "$prepare" prepare
    [ "$(sha256sum "$backing" | cut -d' ' -f1)" = "$backing_digest" ] ||
        fail 'identity mismatch changed or reformatted the store image'
    mv "$backup/identity.valid" "$identity"
    printf 'INVALID_IDENTITY=PASS\n'

    # Exercise the exact non-zero e2fsck branch without modifying the valid image.
    install -d -m 0700 /tmp/r61-fsck-failure-bin
    cat >/tmp/r61-fsck-failure-bin/e2fsck <<'EOF'
#!/bin/sh
exit 4
EOF
    chmod 0700 /tmp/r61-fsck-failure-bin/e2fsck
    expect_failure 'store filesystem check failed with status 4' env \
        PATH=/tmp/r61-fsck-failure-bin:/usr/sbin:/usr/bin:/sbin:/bin \
        "$prepare" prepare
    [ "$(sha256sum "$backing" | cut -d' ' -f1)" = "$backing_digest" ] ||
        fail 'failed filesystem check changed or reformatted the store image'
    rm -rf /tmp/r61-fsck-failure-bin
    printf 'FAILED_FSCK=PASS\n'

    # Damage the ext4 identity in a disposable copy and prove the existing image
    # is rejected in place rather than reformatted or replaced.
    cp "$backing" "$backup/backing.valid"
    printf '\000\000' | dd of="$backing" bs=1 seek=1080 conv=notrunc status=none
    damaged_digest=$(sha256sum "$backing" | cut -d' ' -f1)
    expect_failure 'store filesystem is not ext4' "$prepare" prepare
    [ "$(sha256sum "$backing" | cut -d' ' -f1)" = "$damaged_digest" ] ||
        fail 'damaged filesystem was changed or reformatted automatically'
    rm -f -- "$backing"
    mv "$backup/backing.valid" "$backing"
    printf 'DAMAGED_FILESYSTEM=PASS\n'
else
    [ -z "$(findmnt -rn -M "$store")" ] ||
        fail 'resume requires the isolated store to remain unmounted'
    require_regular "$backing"
    require_regular "$identity"
    [ -d "$backup" ] && [ ! -L "$backup" ] ||
        fail 'resume failure backup is absent or unsafe'
fi

# The minimal image has no mount-namespace helper. Temporarily move only the
# loop-control node after proving that no loop is attached; an EXIT trap always
# restores the same device node before the matrix continues.
install -d -m 0750 /run/aos-vehicle-data-provider-store
[ -z "$(losetup -j "$backing")" ] ||
    fail 'store image is attached before the missing loop-control probe'
loop_control=/dev/loop-control
loop_control_saved=/dev/loop-control.r61-failure
[ -c "$loop_control" ] && [ ! -L "$loop_control" ] ||
    fail 'loop-control is absent or unsafe before its failure probe'
[ ! -e "$loop_control_saved" ] && [ ! -L "$loop_control_saved" ] ||
    fail 'stale saved loop-control node exists'
restore_loop_control() {
    if [ ! -e "$loop_control" ] && [ -e "$loop_control_saved" ]; then
        mv "$loop_control_saved" "$loop_control"
    fi
}
trap restore_loop_control EXIT HUP INT TERM
mv "$loop_control" "$loop_control_saved"
expect_failure 'cannot open loop-control' "$attach" attach
restore_loop_control
trap - EXIT HUP INT TERM
[ -c "$loop_control" ] && [ ! -e "$loop_control_saved" ] ||
    fail 'loop-control was not restored after its failure probe'
[ -z "$(losetup -j "$backing")" ] ||
    fail 'missing loop-control probe attached the store image'
rm -rf /run/aos-vehicle-data-provider-store
printf 'MISSING_LOOP_CONTROL=PASS\n'

# Use the real attach service, then remove only its runtime link to make the
# native mount fail. Restore that exact link before continuing.
systemctl reset-failed aos-vehicle-data-provider-store-prepare.service \
    "$attach_unit" "$store_unit" "$bootstrap_unit" >/dev/null 2>&1 || true
systemctl restart aos-vehicle-data-provider-store-prepare.service ||
    fail 'valid store preparation did not recover after negative probes'
systemctl start "$attach_unit" || fail 'valid loop attachment failed'
runtime_loop=/run/aos-vehicle-data-provider-store/loop
[ -L "$runtime_loop" ] || fail 'runtime loop identity is absent'
loop_target=$(readlink "$runtime_loop")
rm -f -- "$runtime_loop"
expect_failure 'failed' systemctl start "$store_unit"
[ "$(systemctl is-active "$bootstrap_unit" 2>/dev/null || true)" != active ] ||
    fail 'bootstrap continued after the component mount failed'
ln -s "$loop_target" "$runtime_loop"
restorecon "$runtime_loop" >/dev/null
systemctl reset-failed "$store_unit" "$bootstrap_unit" >/dev/null 2>&1 || true
systemctl start "$store_unit" || fail 'restored component mount did not start'
systemctl start "$bootstrap_unit" || fail 'restored component bootstrap did not start'
printf 'MOUNT_FAILURE=PASS\n'

# The post-mount checker must reject a read-only store, and the same store must
# recover after the fixture remounts it writable.
mount -o remount,ro "$store" || fail 'cannot inject a read-only store remount'
expect_failure 'component store mount option is absent: rw' "$check"
mount -o remount,rw "$store" || fail 'cannot restore the writable store mount'
"$check" >/dev/null || fail 'store check did not recover after writable remount'
printf 'READ_ONLY_REMOUNT=PASS\n'

[ "$(cat "$marker")" = r6-1-store-fixture-v1 ] ||
    fail 'failure matrix changed the positive persistence marker'
[ "$(cat "$sibling")" = 'R6.1 sibling access must remain denied.' ] ||
    fail 'failure matrix changed unrelated workdirs'
[ ! -e "$partial" ] && [ ! -e "$identity_partial" ] && [ ! -e "$filler" ] ||
    fail 'failure matrix left a partial transaction'
rm -rf "$backup"
rm -f "$failure_log"

if ausearch -m AVC,USER_AVC -ts boot 2>/dev/null | grep -q '^type=AVC'; then
    ausearch -m AVC,USER_AVC -ts boot >&2 || true
    fail 'store failure matrix produced an SELinux AVC denial'
fi

printf 'EXISTING_STORE_NEVER_REFORMATTED=PASS\n'
printf 'UNRELATED_WORKDIRS_UNCHANGED=PASS\n'
printf 'R6_1_STORE_FAILURE_MATRIX=PASS\n'
