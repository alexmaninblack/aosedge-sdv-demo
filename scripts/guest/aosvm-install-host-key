#!/bin/sh

set -eu
umask 077

public_key_file=${1:-}

fail() {
    printf 'AosVM host access setup failed: %s\n' "$*" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'this command must run as root'
[ -n "$public_key_file" ] || fail 'a public key file is required'
[ -f "$public_key_file" ] && [ ! -L "$public_key_file" ] ||
    fail 'the public key input is not a safe regular file'
[ "$(wc -l <"$public_key_file" | tr -d ' ')" = 1 ] ||
    fail 'the public key file must contain exactly one line'

public_key=$(cat "$public_key_file")
case "$public_key" in
    ssh-ed25519\ *) ;;
    *) fail 'only an Ed25519 public key is accepted' ;;
esac

root_home=$(awk -F: '$1 == "root" { print $6 }' /etc/passwd)
[ -n "$root_home" ] && [ -d "$root_home" ] ||
    fail 'cannot resolve the root account home directory'
ssh_directory="$root_home/.ssh"
authorized_keys="$ssh_directory/authorized_keys"

[ ! -L "$ssh_directory" ] || fail 'the root SSH directory is a symbolic link'
if [ -e "$ssh_directory" ]; then
    [ -d "$ssh_directory" ] || fail 'the root SSH path is not a directory'
else
    mkdir "$ssh_directory"
fi
chmod 0700 "$ssh_directory"

[ ! -L "$authorized_keys" ] || fail 'authorized_keys is a symbolic link'
if [ -e "$authorized_keys" ]; then
    [ -f "$authorized_keys" ] || fail 'authorized_keys is not a regular file'
else
    : >"$authorized_keys"
fi
chmod 0600 "$authorized_keys"

if grep -Fqx "$public_key" "$authorized_keys"; then
    if command -v restorecon >/dev/null 2>&1; then
        restorecon -RF "$root_home"
    fi
    printf 'The Mac host access key is already authorized.\n'
    exit 0
fi

authorized_keys_partial="$ssh_directory/.authorized_keys.aosvm.$$"
trap 'rm -f "$authorized_keys_partial"' EXIT HUP INT TERM
cat "$authorized_keys" >"$authorized_keys_partial"
printf '%s\n' "$public_key" >>"$authorized_keys_partial"
chmod 0600 "$authorized_keys_partial"
chown root:root "$authorized_keys_partial"
mv "$authorized_keys_partial" "$authorized_keys"
trap - EXIT HUP INT TERM
if command -v restorecon >/dev/null 2>&1; then
    restorecon -RF "$root_home"
fi

printf 'Authorized the private Mac host access key for this AosVM overlay.\n'
