set -eu
umask 077

root=/var/aos/workdirs/sm/runtimes/systemd-slot-component
reader_token=/tmp/r6-reader.token
reader=/tmp/r6-1-provider-read.py
jwt_public="$root/qualification/jwt.key.pub"

fail() {
    printf 'R6.1 provider restart check failed: %s\n' "$*" >&2
    exit 1
}

require_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || fail "unsafe or missing input: $1"
}

wait_active() {
    unit=$1
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        [ "$(systemctl is-active "$unit" 2>/dev/null || true)" = active ] && return 0
        attempt=$((attempt + 1))
        sleep 1
    done
    systemctl status "$unit" --no-pager >&2 || true
    return 1
}

wait_unavailable() {
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if /usr/bin/python3 -I "$reader" unavailable \
            --token "$reader_token" >/dev/null 2>&1; then
            /usr/bin/python3 -I "$reader" unavailable --token "$reader_token"
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    return 1
}

[ "$(id -u)" -eq 0 ] || fail 'this command must run as root'
[ "$(uname -m)" = aarch64 ] || fail 'guest is not AArch64'
grep -qx 'VERSION_ID=6.1.1-maninblack.10' /etc/os-release ||
    fail 'guest is not the accepted .10 rootfs'
[ "$(getenforce)" = Enforcing ] || fail 'SELinux is not enforcing'
require_file "$reader_token"
require_file "$reader"
require_file "$jwt_public"
[ "$(findmnt -rn -M "$root" -o FSTYPE)" = ext4 ] ||
    fail 'isolated provider store is not mounted'
[ -L "$root/active" ] && [ "$(readlink "$root/active")" = slots/b ] ||
    fail 'active provider slot B was not preserved'
for slot in a b; do
    [ -d "$root/slots/$slot" ] && [ ! -L "$root/slots/$slot" ] ||
        fail "provider slot $slot was not preserved"
done
grep -Eq '"Version"[[:space:]]*:[[:space:]]*"0\.3\.0"' \
    "$root/state/installed.json" || fail 'installed version 0.3.0 was not preserved'
grep -Eq '"slot"[[:space:]]*:[[:space:]]*"b"' \
    "$root/state/installed.json" || fail 'installed slot B was not preserved'
grep -Eq '"candidateVersion"[[:space:]]*:[[:space:]]*"0\.4\.0"' \
    "$root/state/last-failure.json" || fail 'rollback evidence was not preserved'

install -d -m 0755 /run/systemd/system/kuksa-databroker.service.d
cat >/run/systemd/system/kuksa-databroker.service.d/r61-qualification.conf <<EOF
[Service]
ExecStart=
ExecStart=/usr/bin/databroker --vss /usr/share/vss/vss.json --tls-cert /etc/kuksa-val/Server.pem --tls-private-key /etc/kuksa-val/Server.key --jwt-public-key $jwt_public --address=127.0.0.1
EOF
chmod 0644 /run/systemd/system/kuksa-databroker.service.d/r61-qualification.conf
systemctl daemon-reload
systemctl restart kuksa-databroker.service
wait_active kuksa-databroker.service || fail 'KUKSA did not restart with qualification auth'
systemctl restart aos-vehicle-data-provider.service ||
    fail 'provider did not restart from the preserved active slot'
wait_active aos-vehicle-data-provider.service || fail 'provider did not report ready'

main_pid=$(systemctl show -p MainPID --value aos-vehicle-data-provider.service)
case "$main_pid" in
    ''|0|*[!0-9]*) fail 'provider MainPID is invalid' ;;
esac
[ "$(awk '/^Uid:/ {print $2; exit}' "/proc/$main_pid/status")" -ne 0 ] ||
    fail 'provider unexpectedly runs as root'
wait_unavailable || fail 'restart retained stale KUKSA values'
[ "$(findmnt -n -o OPTIONS / | tr ',' '\n' | grep -c '^ro$')" -eq 1 ] ||
    fail 'root filesystem is not read-only'
[ "$(cat /var/aos/workdirs/.r61-store-fixture-sibling/secret)" = \
    'R6.1 sibling access must remain denied.' ] ||
    fail 'unrelated workdirs fixture changed'
/usr/libexec/aos-vehicle-data-provider-store-check >/dev/null ||
    fail 'isolated store validation failed after provider restart'

if ausearch -m AVC,USER_AVC -ts boot 2>/dev/null | grep -q '^type=AVC'; then
    ausearch -m AVC,USER_AVC -ts boot >&2 || true
    fail 'provider restart qualification produced an SELinux AVC denial'
fi

printf 'PROVIDER_VERSION=0.3.0\n'
printf 'ACTIVE_SLOT=b\n'
printf 'ROLLBACK_SLOT=a\n'
printf 'PROVIDER_UID=%s\n' \
    "$(awk '/^Uid:/ {print $2; exit}' "/proc/$main_pid/status")"
printf 'R6_1_PROVIDER_RESTART=PASS\n'
