#!/bin/sh
# SPDX-FileCopyrightText: 2026 maninblack
# SPDX-License-Identifier: MIT

set -eu
umask 077

mode=${1:-}
launcher=/tmp/r6-1-credential-launcher.bin
policy=/tmp/r6-1-credential-policy.pp
provider_unit=/tmp/aos-vehicle-data-provider.service
selftest_unit=/tmp/aos-vehicle-data-provider-selftest@.service
launcher_sha256=9f0fcf32c38e57c422230e1f79a32d66a880836bac4f2eb491f949518c46132c
policy_sha256=0e6f39cf3f799b2455d1037d6983bb632a692618cd549bcc31a26c3c82aba101
provider_unit_sha256=5c46d2a938c605f4839ef62759f1175c9c3faf51a2b3f116dbb928bc0b8f1c80
selftest_unit_sha256=2f773ef9719960b3941ce7fb58c361882bb98194b0bed349813ec6320ad50dbc

fail() {
    printf 'R6.1 credential side-load failed: %s\n' "$*" >&2
    exit 1
}

require_input() {
    path=$1
    digest=$2
    [ -f "$path" ] && [ ! -L "$path" ] || fail "unsafe or missing input: $path"
    printf '%s  %s\n' "$digest" "$path" | sha256sum -c --status ||
        fail "input digest mismatch: $path"
}

require_effective_allow() {
    source_type=$1
    target_type=$2
    object_class=$3
    permission=$4
    sesearch --allow -s "$source_type" -t "$target_type" \
        -c "$object_class" -p "$permission" -ds -dt |
        grep -q '^[[:space:]]*allow ' ||
        fail "effective policy is missing ${source_type} -> ${target_type}:${object_class} ${permission}"
}

[ "$(id -u)" -eq 0 ] || fail 'this helper must run as root'
[ "$(uname -m)" = aarch64 ] || fail 'guest is not AArch64'
grep -qx 'VERSION_ID=6.1.1-maninblack.10' /etc/os-release ||
    fail 'helper is restricted to the rejected .10 disposable base image'
[ "$(getenforce)" = Enforcing ] || fail 'global SELinux is not enforcing'
provider_permissive=no
if semanage permissive -l 2>/dev/null |
    grep -q '^[[:space:]]*vehicle_data_provider_t[[:space:]]*$'; then
    provider_permissive=yes
fi
case "$mode" in
    install|units)
        [ "$provider_permissive" = no ] ||
            fail 'provider domain must not be permissive'
        ;;
    units-discovery)
        [ "$provider_permissive" = yes ] ||
            fail 'provider domain is not in the bounded discovery mode'
        ;;
    *) fail 'usage: r6-1-credential-side-load <install|units|units-discovery>' ;;
esac

require_input "$launcher" "$launcher_sha256"
require_input "$policy" "$policy_sha256"
require_input "$provider_unit" "$provider_unit_sha256"
require_input "$selftest_unit" "$selftest_unit_sha256"

case "$mode" in
    install)
        mount -o remount,rw / ||
            fail 'cannot remount disposable rootfs writable'
        install -o 0 -g 0 -m 0755 "$launcher" \
            /usr/libexec/aos-vehicle-data-provider-launcher ||
            fail 'cannot install the corrected launcher'
        semodule -i "$policy" ||
            fail 'cannot install the corrected SELinux policy'
        require_effective_allow vehicle_data_provider_t initrc_runtime_t dir search
        require_effective_allow vehicle_data_provider_t initrc_runtime_t dir getattr
        require_effective_allow vehicle_data_provider_t initrc_runtime_t file open
        require_effective_allow vehicle_data_provider_t initrc_runtime_t file read
        require_effective_allow vehicle_data_provider_t initrc_runtime_t file getattr
        require_effective_allow vehicle_data_provider_t vehicle_data_provider_t \
            udp_socket create
        require_effective_allow vehicle_data_provider_t urandom_device_t \
            chr_file read
        if sesearch --allow -s vehicle_data_provider_t -t initrc_runtime_t \
            -c file -p write | grep -q '^[[:space:]]*allow '; then
            fail 'effective credential policy permits provider writes'
        fi
        restorecon /usr/libexec/aos-vehicle-data-provider-launcher ||
            fail 'cannot restore the launcher entrypoint label'
        printf '%s  %s\n' "$launcher_sha256" \
            /usr/libexec/aos-vehicle-data-provider-launcher |
            sha256sum -c --status || fail 'installed launcher digest mismatch'
        stat -c %C /usr/libexec/aos-vehicle-data-provider-launcher |
            grep -q ':vehicle_data_provider_exec_t:' ||
            fail 'launcher entrypoint SELinux type is incorrect'
        sync
        printf 'PLATFORM_BASE_REVISION=7cd8de32a7608618a3f45d35f989db3138c455b2\n'
        printf 'RUNTIME_DELTA_POLICY_SHA256=%s\n' "$policy_sha256"
        printf 'ROOTFS_VERSION=6.1.1-maninblack.10\n'
        printf 'CLEAN_RESTART_REQUIRED=yes\n'
        printf 'R6_1_CREDENTIAL_SIDE_LOAD=INSTALL_PASS\n'
        exit 0
        ;;
    units|units-discovery) ;;
esac

[ "$(findmnt -n -o OPTIONS / | tr ',' '\n' | grep -c '^ro$')" -eq 1 ] ||
    fail 'units mode requires a clean restart with read-only rootfs'
printf '%s  %s\n' "$launcher_sha256" \
    /usr/libexec/aos-vehicle-data-provider-launcher |
    sha256sum -c --status || fail 'installed launcher digest mismatch'
stat -c %C /usr/libexec/aos-vehicle-data-provider-launcher |
    grep -q ':vehicle_data_provider_exec_t:' ||
    fail 'launcher entrypoint SELinux type is incorrect'

install -d -m 0755 /run/systemd/system
install -o 0 -g 0 -m 0644 "$provider_unit" \
    /run/systemd/system/aos-vehicle-data-provider.service
install -o 0 -g 0 -m 0644 "$selftest_unit" \
    /run/systemd/system/aos-vehicle-data-provider-selftest@.service
systemctl daemon-reload

[ "$(systemctl show -p FragmentPath --value \
    aos-vehicle-data-provider.service)" = \
    /run/systemd/system/aos-vehicle-data-provider.service ] ||
    fail 'corrected provider unit is not loaded from the disposable override'
[ "$(systemctl show -p FragmentPath --value \
    aos-vehicle-data-provider-selftest@a.service)" = \
    /run/systemd/system/aos-vehicle-data-provider-selftest@.service ] ||
    fail 'corrected self-test unit is not loaded from the disposable override'
printf '%s  %s\n' "$provider_unit_sha256" \
    /run/systemd/system/aos-vehicle-data-provider.service |
    sha256sum -c --status || fail 'loaded provider unit digest mismatch'
printf '%s  %s\n' "$selftest_unit_sha256" \
    /run/systemd/system/aos-vehicle-data-provider-selftest@.service |
    sha256sum -c --status || fail 'loaded self-test unit digest mismatch'
grep -qx 'ExecStart=/usr/libexec/aos-vehicle-data-provider-launcher' \
    /run/systemd/system/aos-vehicle-data-provider.service ||
    fail 'provider launcher does not use the normal systemd identity path'
grep -qx 'User=aos-vdp' /run/systemd/system/aos-vehicle-data-provider.service ||
    fail 'provider unit does not establish the dedicated identity'
grep -qx 'CapabilityBoundingSet=' \
    /run/systemd/system/aos-vehicle-data-provider.service ||
    fail 'provider capability bounding set is not empty'
grep -qx 'After=network-online.target kuksa-databroker.service' \
    /run/systemd/system/aos-vehicle-data-provider.service ||
    fail 'KUKSA startup ordering is absent'
grep -qx 'Wants=network-online.target kuksa-databroker.service' \
    /run/systemd/system/aos-vehicle-data-provider.service ||
    fail 'KUKSA soft dependency is absent'
if grep -qx 'Requires=kuksa-databroker.service' \
    /run/systemd/system/aos-vehicle-data-provider.service; then
    fail 'KUKSA remains a hard lifecycle dependency'
fi
[ "$(findmnt -n -o OPTIONS / | tr ',' '\n' | grep -c '^ro$')" -eq 1 ] ||
    fail 'root filesystem is not read-only'

printf 'PLATFORM_BASE_REVISION=7cd8de32a7608618a3f45d35f989db3138c455b2\n'
printf 'RUNTIME_DELTA_POLICY_SHA256=%s\n' "$policy_sha256"
printf 'ROOTFS_VERSION=6.1.1-maninblack.10\n'
printf 'R6_1_CREDENTIAL_SIDE_LOAD=UNITS_PASS\n'
