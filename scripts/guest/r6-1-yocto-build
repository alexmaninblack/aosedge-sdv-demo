set -euo pipefail

readonly command_name="${1:-}"
readonly input_root="/home/yocto/r61-input"
readonly work_root="/home/yocto/r61-build/upstream"
readonly manifest="${input_root}/aos-vm-upstream.pinned.yaml"
readonly manifest_sha256="77f25a49c439035ab0dc2d8d496048043b1258bb230996428ca730de364bb4fe"
readonly build_ninja_sha256="af224c74f932dab23d8ca736e3b36c4c403df3ba5d219010f87f175ac472f0c6"
readonly moulin_root="/home/yocto/r61-work/moulin"
readonly moulin_revision="cbecc1c748a8c5649e9a319b29167bf27dc4fc3a"
readonly moulin_python="/home/yocto/.local/pipx/venvs/moulin/bin/python"
readonly gpt_image_version="0.8.1"
readonly tool_bin="/home/yocto/.local/bin"
readonly moulin="${tool_bin}/moulin"
readonly rouge="${tool_bin}/rouge"
readonly cache_root="/home/yocto/yocto-cache"
readonly log_file="${work_root}/r6-1-upstream-build.log"
readonly pid_file="${work_root}/r6-1-upstream-build.pid"
readonly result_file="${work_root}/r6-1-upstream-build.result"
readonly project_work_root="/home/yocto/r61-build/project"
readonly project_manifest="${input_root}/aos-vm-project.pinned.yaml"
readonly project_manifest_sha256="8d1814540e1c6b6291a6b4b8af3bcb66e2d118e9650af5002dc9847b62115445"
readonly project_build_ninja_sha256="528b09ca750576a2ab8520802d6f9ed015e7e57cab72d5aae4bbcdb55e2cf4a5"
readonly project_log_file="${project_work_root}/r6-1-project-build.log"
readonly project_pid_file="${project_work_root}/r6-1-project-build.pid"
readonly project_result_file="${project_work_root}/r6-1-project-build.result"
readonly project_fota_log_file="${project_work_root}/r6-1-project-fota.log"
readonly project_fota_pid_file="${project_work_root}/r6-1-project-fota.pid"
readonly project_fota_result_file="${project_work_root}/r6-1-project-fota.result"

# Non-interactive SSH sessions use the system default PATH and do not include
# pipx's application directory. Ninja invokes rouge by its generated command
# name, so export the pinned tool location before any graph is generated or run.
export PATH="${tool_bin}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_regular_file() {
    local path="$1"
    [[ -f "$path" && ! -L "$path" ]] || fail "unsafe or missing file: ${path}"
}

verify_inputs() {
    [[ "$(uname -m)" == "aarch64" ]] || fail "builder must be ARM64"
    [[ "$(findmnt -n -o FSTYPE -T /home/yocto)" == "ext4" ]] || \
        fail "builder workspace must be on ext4"
    require_regular_file "$manifest"
    [[ "$(sha256sum "$manifest" | cut -d' ' -f1)" == "$manifest_sha256" ]] || \
        fail "pinned manifest digest mismatch"
    [[ -x "$moulin" ]] || fail "Moulin is unavailable"
    [[ -x "$rouge" ]] || fail "Rouge image tool is unavailable"
    [[ -x "$moulin_python" ]] || fail "Moulin Python environment is unavailable"
    [[ "$(dirname "$(readlink -f "$rouge")")" == \
        "$(dirname "$(readlink -f "$moulin")")" ]] || \
        fail "Moulin and Rouge do not use the same pinned environment"
    [[ "$(git -C "$moulin_root" rev-parse HEAD)" == "$moulin_revision" ]] || \
        fail "Moulin revision mismatch"
    git -C "$moulin_root" diff --quiet
    git -C "$moulin_root" diff --cached --quiet
    "$moulin" -h 2>&1 | grep -F "Moulin meta-build system v0.21" >/dev/null
    "$rouge" -h 2>&1 | grep -F "usage: rouge" >/dev/null
    [[ "$("$moulin_python" -c \
        'from importlib.metadata import version; print(version("gpt-image"))')" == \
        "$gpt_image_version" ]] || fail "gpt-image version mismatch"
    for path in "$cache_root" "$cache_root/downloads" "$cache_root/sstate-cache"; do
        [[ -d "$path" && ! -L "$path" ]] || fail "unsafe cache path: ${path}"
    done
    if find "$input_root" -type f \( \
        -name '*.p12' -o -name '*.pfx' -o -name '*.pem' -o -name '*.key' \
    \) -print -quit | grep -q .; then
        fail "credential-like file present in the input directory"
    fi
}

verify_project_inputs() {
    verify_inputs
    require_regular_file "$project_manifest"
    [[ "$(sha256sum "$project_manifest" | cut -d' ' -f1)" == "$project_manifest_sha256" ]] || \
        fail "pinned project manifest digest mismatch"
    grep -F "https://github.com/alexmaninblack/aos-vehicle-platform" \
        "$project_manifest" >/dev/null
    grep -F "ad850e8bad7585cbdf589915a64fee061a0bd405" \
        "$project_manifest" >/dev/null
    grep -F '"../aos-vehicle-platform/meta-aos-vehicle-platform"' \
        "$project_manifest" >/dev/null
    if grep -E 'tlsKey:|\.p12|\.pfx|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY' \
        "$project_manifest" >/dev/null; then
        fail "credential reference present in the project manifest"
    fi
}

generate_upstream() {
    verify_inputs
    install -d -m 0750 "$work_root"
    cd "$work_root"
    "$moulin" "$manifest" \
        --MACHINE=qemuarm64 \
        --NODE_TYPE=main \
        --WITH_MESSAGE_PROXY=no \
        --CACHE_LOCATION=outside
    require_regular_file "$work_root/build.ninja"
    grep -F "/home/yocto/yocto-cache/downloads" "$work_root/build.ninja" >/dev/null
    grep -F "/home/yocto/yocto-cache/sstate-cache" "$work_root/build.ninja" >/dev/null
    if grep -E 'rev[^[:alnum:]]+(main|master|scarthgap|v[0-9])' \
        "$work_root/build.ninja" >/dev/null; then
        fail "generated build contains a floating source selector"
    fi
    [[ "$(sha256sum "$work_root/build.ninja" | cut -d' ' -f1)" == "$build_ninja_sha256" ]] || \
        fail "generated upstream build graph digest mismatch"
    printf 'MANIFEST_SHA256=%s\n' "$manifest_sha256"
    printf 'BUILD_NINJA_SHA256=%s\n' "$build_ninja_sha256"
    printf 'R6_1_UPSTREAM_GENERATE=PASS\n'
}

generate_project() {
    verify_project_inputs
    install -d -m 0750 "$project_work_root"
    cd "$project_work_root"
    "$moulin" "$project_manifest" \
        --MACHINE=qemuarm64 \
        --NODE_TYPE=main \
        --WITH_MESSAGE_PROXY=no \
        --CACHE_LOCATION=outside
    require_regular_file "$project_work_root/build.ninja"
    grep -F "/home/yocto/yocto-cache/downloads" "$project_work_root/build.ninja" >/dev/null
    grep -F "/home/yocto/yocto-cache/sstate-cache" "$project_work_root/build.ninja" >/dev/null
    grep -F "yocto/aos-vehicle-platform" "$project_work_root/build.ninja" >/dev/null
    if grep -E 'rev[^[:alnum:]]+(main|master|scarthgap|v[0-9])' \
        "$project_work_root/build.ninja" >/dev/null; then
        fail "generated project build contains a floating source selector"
    fi
    if grep -E 'aos-user-oem\.p12|tlsKey' "$project_work_root/build.ninja" >/dev/null; then
        fail "generated project build contains a credential reference"
    fi
    [[ "$(sha256sum "$project_work_root/build.ninja" | cut -d' ' -f1)" == "$project_build_ninja_sha256" ]] || \
        fail "generated project build graph digest mismatch"
    printf 'MANIFEST_SHA256=%s\n' "$project_manifest_sha256"
    printf 'BUILD_NINJA_SHA256=%s\n' "$project_build_ninja_sha256"
    printf 'R6_1_PROJECT_GENERATE=PASS\n'
}

read_owned_pid() {
    [[ -e "$pid_file" ]] || return 1
    require_regular_file "$pid_file"
    local pid
    pid="$(cat "$pid_file")"
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || fail "invalid build PID"
    [[ -r "/proc/${pid}/cmdline" ]] || return 1
    tr '\0' ' ' <"/proc/${pid}/cmdline" | \
        grep -F "r6-1-yocto-build run-upstream" >/dev/null || \
        fail "build PID is not owned by R6.1"
    printf '%s\n' "$pid"
}

read_project_pid() {
    [[ -e "$project_pid_file" ]] || return 1
    require_regular_file "$project_pid_file"
    local pid
    pid="$(cat "$project_pid_file")"
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || fail "invalid project build PID"
    [[ -r "/proc/${pid}/cmdline" ]] || return 1
    tr '\0' ' ' <"/proc/${pid}/cmdline" | \
        grep -F "r6-1-yocto-build run-project" >/dev/null || \
        fail "build PID is not owned by the R6.1 project build"
    printf '%s\n' "$pid"
}

read_project_fota_pid() {
    [[ -e "$project_fota_pid_file" ]] || return 1
    require_regular_file "$project_fota_pid_file"
    local pid
    pid="$(cat "$project_fota_pid_file")"
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || fail "invalid project FOTA PID"
    [[ -r "/proc/${pid}/cmdline" ]] || return 1
    tr '\0' ' ' <"/proc/${pid}/cmdline" | \
        grep -F "r6-1-yocto-build run-project-fota" >/dev/null || \
        fail "build PID is not owned by the R6.1 project FOTA build"
    printf '%s\n' "$pid"
}

run_upstream() {
    verify_inputs
    require_regular_file "$work_root/build.ninja"
    rm -f "$result_file"
    cd "$work_root"
    set +e
    ninja -j 10 main-qemuarm64.img
    result=$?
    set -e
    if [[ "$result" -eq 0 ]]; then
        printf 'PASS\n' >"$result_file"
    else
        printf 'FAIL:%s\n' "$result" >"$result_file"
    fi
    chmod 0640 "$result_file"
    exit "$result"
}

run_project() {
    verify_project_inputs
    require_regular_file "$project_work_root/build.ninja"
    rm -f "$project_result_file"
    cd "$project_work_root"
    set +e
    ninja -j 10 main-qemuarm64.img
    result=$?
    set -e
    if [[ "$result" -eq 0 ]]; then
        printf 'PASS\n' >"$project_result_file"
    else
        printf 'FAIL:%s\n' "$result" >"$project_result_file"
    fi
    chmod 0640 "$project_result_file"
    exit "$result"
}

run_project_fota() {
    verify_project_inputs
    require_regular_file "$project_work_root/build.ninja"
    require_regular_file "$project_result_file"
    [[ "$(cat "$project_result_file")" == PASS ]] ||
        fail "project image must pass before the FOTA build"
    rm -f "$project_fota_result_file"
    cd "$project_work_root"
    set +e
    ninja -j 10 fota
    result=$?
    set -e
    if [[ "$result" -eq 0 ]]; then
        printf 'PASS\n' >"$project_fota_result_file"
    else
        printf 'FAIL:%s\n' "$result" >"$project_fota_result_file"
    fi
    chmod 0640 "$project_fota_result_file"
    exit "$result"
}

start_upstream() {
    verify_inputs
    require_regular_file "$work_root/build.ninja"
    if pid="$(read_owned_pid)"; then
        printf 'R6.1 upstream build is already running (PID %s).\n' "$pid"
        return
    fi
    rm -f "$pid_file" "$result_file"
    require_regular_file "$0"
    nohup "$0" run-upstream >"$log_file" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$pid_file"
    chmod 0640 "$pid_file" "$log_file"
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null && [[ ! -f "$result_file" ]]; then
        fail "upstream build did not start; inspect ${log_file}"
    fi
    printf 'R6.1 upstream build started (PID %s).\n' "$pid"
    printf 'Log: %s\n' "$log_file"
}

start_project() {
    verify_project_inputs
    require_regular_file "$project_work_root/build.ninja"
    if pid="$(read_project_fota_pid)"; then
        fail "project FOTA build is still running as PID ${pid}"
    fi
    if pid="$(read_project_pid)"; then
        printf 'R6.1 project build is already running (PID %s).\n' "$pid"
        return
    fi
    rm -f "$project_pid_file" "$project_result_file"
    require_regular_file "$0"
    nohup "$0" run-project >"$project_log_file" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$project_pid_file"
    chmod 0640 "$project_pid_file" "$project_log_file"
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null && [[ ! -f "$project_result_file" ]]; then
        fail "project build did not start; inspect ${project_log_file}"
    fi
    printf 'R6.1 project build started (PID %s).\n' "$pid"
    printf 'Log: %s\n' "$project_log_file"
}

start_project_fota() {
    verify_project_inputs
    require_regular_file "$project_work_root/build.ninja"
    require_regular_file "$project_result_file"
    [[ "$(cat "$project_result_file")" == PASS ]] ||
        fail "project image must pass before the FOTA build"
    if pid="$(read_project_pid)"; then
        fail "project image build is still running as PID ${pid}"
    fi
    if pid="$(read_project_fota_pid)"; then
        printf 'R6.1 project FOTA build is already running (PID %s).\n' "$pid"
        return
    fi
    rm -f "$project_fota_pid_file" "$project_fota_result_file"
    require_regular_file "$0"
    nohup "$0" run-project-fota >"$project_fota_log_file" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$project_fota_pid_file"
    chmod 0640 "$project_fota_pid_file" "$project_fota_log_file"
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null && [[ ! -f "$project_fota_result_file" ]]; then
        fail "project FOTA build did not start; inspect ${project_fota_log_file}"
    fi
    printf 'R6.1 project FOTA build started (PID %s).\n' "$pid"
    printf 'Log: %s\n' "$project_fota_log_file"
}

status_upstream() {
    if pid="$(read_owned_pid)"; then
        printf 'STATE=RUNNING\nPID=%s\n' "$pid"
    elif [[ -f "$result_file" ]]; then
        require_regular_file "$result_file"
        printf 'STATE=%s\n' "$(cat "$result_file")"
    else
        printf 'STATE=NOT_STARTED\n'
    fi
    if [[ -f "$log_file" ]]; then
        require_regular_file "$log_file"
        printf '%s\n' '--- LOG TAIL ---'
        tail -n 30 "$log_file"
    fi
}

status_project() {
    if pid="$(read_project_pid)"; then
        printf 'STATE=RUNNING\nPID=%s\n' "$pid"
    elif [[ -f "$project_result_file" ]]; then
        require_regular_file "$project_result_file"
        printf 'STATE=%s\n' "$(cat "$project_result_file")"
    else
        printf 'STATE=NOT_STARTED\n'
    fi
    if [[ -f "$project_log_file" ]]; then
        require_regular_file "$project_log_file"
        printf '%s\n' '--- LOG TAIL ---'
        tail -n 30 "$project_log_file"
    fi
}

status_project_fota() {
    if pid="$(read_project_fota_pid)"; then
        printf 'STATE=RUNNING\nPID=%s\n' "$pid"
    elif [[ -f "$project_fota_result_file" ]]; then
        require_regular_file "$project_fota_result_file"
        printf 'STATE=%s\n' "$(cat "$project_fota_result_file")"
    else
        printf 'STATE=NOT_STARTED\n'
    fi
    if [[ -f "$project_fota_log_file" ]]; then
        require_regular_file "$project_fota_log_file"
        printf '%s\n' '--- LOG TAIL ---'
        tail -n 30 "$project_fota_log_file"
    fi
}

case "$command_name" in
    verify)
        verify_inputs
        printf 'R6_1_UPSTREAM_INPUTS=PASS\n'
        ;;
    generate-upstream)
        generate_upstream
        ;;
    generate-project)
        generate_project
        ;;
    run-upstream)
        run_upstream
        ;;
    start-upstream)
        start_upstream
        ;;
    status-upstream)
        status_upstream
        ;;
    start-project)
        start_project
        ;;
    run-project)
        run_project
        ;;
    run-project-fota)
        run_project_fota
        ;;
    status-project)
        status_project
        ;;
    start-project-fota)
        start_project_fota
        ;;
    status-project-fota)
        status_project_fota
        ;;
    *)
        fail "usage: $0 {verify|generate-upstream|start-upstream|status-upstream|generate-project|start-project|status-project|start-project-fota|status-project-fota}"
        ;;
esac
