#!/bin/sh
# SPDX-FileCopyrightText: 2026 maninblack
# SPDX-License-Identifier: MIT

set -eu
umask 077

mode=${1:-discovery}
root=/var/aos/workdirs/sm/runtimes/systemd-slot-component
provider_unit=aos-vehicle-data-provider.service
kuksa_unit=kuksa-databroker.service
fixture_unit=r61-viss-fixture.service
reader=/tmp/r6-1-provider-read.py
reader_token=/tmp/r6-reader.token
fixture=/tmp/r6-1-viss-fixture.py
jwt_public="$root/qualification/jwt.key.pub"
token_source="$root/credentials/kuksa-token"
configuration="$root/configuration/provider.json"
backup=/tmp/r61-provider-dependency-discovery
token_backup="$backup/kuksa-token"
configuration_backup="$backup/provider.json"
stopped_pid=

fail() {
    printf 'R6.1 provider dependency discovery failed: %s\n' "$*" >&2
    exit 1
}

require_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || fail "unsafe or missing input: $1"
}

wait_active() {
    unit=$1
    limit=${2:-30}
    attempt=0
    while [ "$attempt" -lt "$limit" ]; do
        [ "$(systemctl is-active "$unit" 2>/dev/null || true)" = active ] && return 0
        attempt=$((attempt + 1))
        sleep 1
    done
    return 1
}

wait_inactive() {
    unit=$1
    limit=${2:-10}
    attempt=0
    while [ "$attempt" -lt "$limit" ]; do
        [ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ] && return 0
        attempt=$((attempt + 1))
        sleep 1
    done
    return 1
}

wait_values() {
    expectation=$1
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if /usr/bin/python3 -I "$reader" "$expectation" \
            --token "$reader_token" >/dev/null 2>&1; then
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    return 1
}

restart_baseline() {
    systemctl stop "$fixture_unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$kuksa_unit" "$provider_unit" >/dev/null 2>&1 || true
    systemctl restart "$kuksa_unit" || return 1
    wait_active "$kuksa_unit" 30 || return 1
    systemctl restart "$provider_unit" || return 1
    wait_active "$provider_unit" 30 || return 1
    wait_values unavailable || return 1
}

cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$stopped_pid" ]; then
        kill -CONT "$stopped_pid" >/dev/null 2>&1 || true
    fi
    systemctl stop "$fixture_unit" >/dev/null 2>&1 || true
    if [ -f "$token_backup" ] && [ ! -L "$token_backup" ]; then
        install -o 0 -g 0 -m 0600 "$token_backup" "$token_source" || status=1
    fi
    if [ -f "$configuration_backup" ] && [ ! -L "$configuration_backup" ]; then
        install -o 0 -g 0 -m 0644 "$configuration_backup" "$configuration" ||
            status=1
    fi
    rm -rf "$backup"
    systemctl daemon-reload >/dev/null 2>&1 || status=1
    restart_baseline >/dev/null 2>&1 || status=1
    exit "$status"
}

trap cleanup EXIT HUP INT TERM

[ "$(id -u)" -eq 0 ] || fail 'this helper must run as root'
[ "$(uname -m)" = aarch64 ] || fail 'guest is not AArch64'
case "$mode" in
    discovery|verify) ;;
    *) fail 'usage: r6-1-provider-dependency-discovery [discovery|verify]' ;;
esac
grep -qx 'VERSION_ID=6.1.1-maninblack.10' /etc/os-release ||
    fail 'helper is restricted to the rejected .10 disposable base image'
[ "$(getenforce)" = Enforcing ] || fail 'global SELinux is not enforcing'
provider_permissive=no
if semanage permissive -l 2>/dev/null |
    grep -q '^[[:space:]]*vehicle_data_provider_t[[:space:]]*$'; then
    provider_permissive=yes
fi
case "$mode" in
    discovery)
        [ "$provider_permissive" = yes ] ||
            fail 'provider domain is not in bounded discovery mode'
        ;;
    verify)
        [ "$provider_permissive" = no ] ||
            fail 'provider domain must be enforcing for verification'
        ;;
esac
[ "$(findmnt -n -o OPTIONS / | tr ',' '\n' | grep -c '^ro$')" -eq 1 ] ||
    fail 'root filesystem is not read-only'
[ -L "$root/active" ] && [ "$(readlink "$root/active")" = slots/b ] ||
    fail 'active provider slot B is absent'
grep -Eq '"Version"[[:space:]]*:[[:space:]]*"0\.3\.0"' \
    "$root/state/installed.json" || fail 'installed provider 0.3.0 is absent'
for path in "$reader" "$reader_token" "$fixture" "$jwt_public" \
    "$token_source" "$configuration"; do
    require_file "$path"
done
[ ! -e "$backup" ] && [ ! -L "$backup" ] || fail 'stale discovery backup exists'
install -d -m 0700 "$backup"
install -o 0 -g 0 -m 0600 "$token_source" "$token_backup"
install -o 0 -g 0 -m 0644 "$configuration" "$configuration_backup"
token_sha=$(sha256sum "$token_backup" | cut -d' ' -f1)
configuration_sha=$(sha256sum "$configuration_backup" | cut -d' ' -f1)

install -d -m 0755 /run/systemd/system/kuksa-databroker.service.d
cat >/run/systemd/system/kuksa-databroker.service.d/r61-qualification.conf <<EOF
[Service]
ExecStart=
ExecStart=/usr/bin/databroker --vss /usr/share/vss/vss.json --tls-cert /etc/kuksa-val/Server.pem --tls-private-key /etc/kuksa-val/Server.key --jwt-public-key $jwt_public --address=127.0.0.1
EOF
chmod 0644 /run/systemd/system/kuksa-databroker.service.d/r61-qualification.conf
systemctl daemon-reload
restart_baseline || fail 'baseline KUKSA/provider state is unavailable'
printf 'BASELINE=PASS\n'

case "$mode" in
    discovery)
        systemctl stop "$kuksa_unit"
        if wait_inactive "$provider_unit" 10; then
            printf 'PROVIDER_AFTER_KUKSA_STOP=inactive\n'
        else
            printf 'PROVIDER_AFTER_KUKSA_STOP=active\n'
        fi
        systemctl start "$kuksa_unit"
        wait_active "$kuksa_unit" 30 || fail 'KUKSA did not restart'
        if wait_active "$provider_unit" 5; then
            printf 'PROVIDER_AFTER_KUKSA_RETURN=automatic\n'
        else
            printf 'PROVIDER_AFTER_KUKSA_RETURN=manual-restart-required\n'
            systemctl reset-failed "$provider_unit" >/dev/null 2>&1 || true
            systemctl start "$provider_unit" || fail 'provider did not start explicitly'
        fi
        wait_active "$provider_unit" 30 ||
            fail 'provider is inactive after KUKSA recovery'
        wait_values unavailable || fail 'KUKSA recovery retained stale values'
        printf 'KUKSA_DEPENDENCY_RECOVERY=OBSERVED\n'
        ;;
    verify)
        cat >"$configuration" <<'EOF'
{
  "schemaVersion": 1,
  "viss": {
    "uri": "wss://localhost:6443",
    "tlsServerName": "127.0.0.1"
  }
}
EOF
        chmod 0644 "$configuration"
        systemctl restart "$provider_unit" ||
            fail 'provider rejected the resolvable VISS hostname'
        wait_active "$provider_unit" 30 ||
            fail 'provider is inactive during positive DNS verification'
        systemctl stop "$fixture_unit" >/dev/null 2>&1 || true
        systemd-run --quiet --unit="$fixture_unit" --property=Type=simple \
            --property=Restart=no /usr/bin/python3 -I "$fixture"
        wait_active "$fixture_unit" 30 ||
            fail 'VISS fixture did not start for DNS verification'
        wait_values available ||
            fail 'resolvable VISS hostname did not deliver live values'
        printf 'DNS_RESOLUTION=PASS\n'

        provider_pid=$(systemctl show -p MainPID --value "$provider_unit")
        case "$provider_pid" in
            ''|0|*[!0-9]*) fail 'provider PID is invalid before KUKSA stop' ;;
        esac
        systemctl stop "$kuksa_unit"
        wait_active "$provider_unit" 10 ||
            fail 'soft KUKSA dependency stopped the provider'
        [ "$(systemctl show -p MainPID --value "$provider_unit")" = \
            "$provider_pid" ] || fail 'provider restarted when KUKSA stopped'
        systemctl start "$kuksa_unit"
        wait_active "$kuksa_unit" 30 || fail 'KUKSA did not restart'
        wait_active "$provider_unit" 10 ||
            fail 'provider became inactive after KUKSA recovery'
        [ "$(systemctl show -p MainPID --value "$provider_unit")" = \
            "$provider_pid" ] || fail 'provider PID changed across KUKSA recovery'
        wait_values available ||
            fail 'provider did not reconnect after KUKSA returned'
        printf 'KUKSA_SOFT_DEPENDENCY_RECOVERY=PASS\n'
        systemctl stop "$fixture_unit" >/dev/null 2>&1 || true
        wait_values unavailable || fail 'source stop retained stale values'
        install -o 0 -g 0 -m 0644 "$configuration_backup" "$configuration"
        restart_baseline || fail 'baseline restore after dependency test failed'
        ;;
esac

printf 'r61-invalid-kuksa-credential\n' >"$backup/invalid-token"
install -o 0 -g 0 -m 0600 "$backup/invalid-token" "$token_source"
systemctl reload "$provider_unit" ||
    fail 'running service lost its systemd credential snapshot'
wait_values unavailable || fail 'credential snapshot reload retained stale values'
printf 'RUNNING_CREDENTIAL_SNAPSHOT=PASS\n'
systemctl stop "$provider_unit"
systemctl reset-failed "$provider_unit" >/dev/null 2>&1 || true
if systemctl start "$provider_unit" >/dev/null 2>&1; then
    fail 'provider accepted an invalid credential after restart'
fi
systemctl stop "$provider_unit" >/dev/null 2>&1 || true
install -o 0 -g 0 -m 0600 "$token_backup" "$token_source"
[ "$(sha256sum "$token_source" | cut -d' ' -f1)" = "$token_sha" ] ||
    fail 'credential source was not restored exactly'
systemctl reset-failed "$provider_unit" >/dev/null 2>&1 || true
systemctl start "$provider_unit" || fail 'provider did not recover after credential restore'
wait_active "$provider_unit" 30 || fail 'provider is inactive after credential restore'
wait_values unavailable || fail 'credential recovery retained stale values'
printf 'INVALID_CREDENTIAL=FAIL_CLOSED\n'

systemd-run --quiet --unit="$fixture_unit" --property=Type=simple \
    --property=Restart=no /usr/bin/python3 -I "$fixture"
wait_active "$fixture_unit" 30 || fail 'VISS fixture did not start for crash test'
wait_values available || fail 'crash test did not establish live values'
old_pid=$(systemctl show -p MainPID --value "$provider_unit")
case "$old_pid" in ''|0|*[!0-9]*) fail 'provider PID is invalid' ;; esac
crash_start=$(date +%s)
kill -KILL "$old_pid"
systemctl stop "$fixture_unit" >/dev/null 2>&1 || true
attempt=0
new_pid=
while [ "$attempt" -lt 30 ]; do
    new_pid=$(systemctl show -p MainPID --value "$provider_unit" 2>/dev/null || true)
    if [ "$(systemctl is-active "$provider_unit" 2>/dev/null || true)" = active ] &&
        [ -n "$new_pid" ] && [ "$new_pid" != 0 ] && [ "$new_pid" != "$old_pid" ]; then
        break
    fi
    attempt=$((attempt + 1))
    sleep 1
done
[ -n "$new_pid" ] && [ "$new_pid" != 0 ] && [ "$new_pid" != "$old_pid" ] ||
    fail 'provider did not restart after SIGKILL'
wait_values unavailable || fail 'provider crash recovery retained stale values'
printf 'SIGKILL_RECOVERY_SECONDS=%s\n' "$(( $(date +%s) - crash_start ))"
printf 'SIGKILL_RECOVERY=PASS\n'

stopped_pid=$new_pid
kill -STOP "$stopped_pid"
sleep 3
if [ "$(systemctl is-active "$provider_unit" 2>/dev/null || true)" = active ] &&
    [ "$(systemctl show -p MainPID --value "$provider_unit")" = "$stopped_pid" ]; then
    printf 'HANG_DETECTION=ABSENT\n'
else
    printf 'HANG_DETECTION=PRESENT\n'
fi
kill -CONT "$stopped_pid"
stopped_pid=
systemctl restart "$provider_unit" || fail 'provider did not restart after hang probe'
wait_active "$provider_unit" 30 || fail 'provider is inactive after hang probe'
wait_values unavailable || fail 'hang probe recovery retained stale values'

cat >"$configuration" <<'EOF'
{
  "schemaVersion": 1,
  "viss": {
    "uri": "wss://r61-provider.invalid:6443",
    "tlsServerName": "r61-provider.invalid"
  }
}
EOF
chmod 0644 "$configuration"
systemctl restart "$provider_unit" || fail 'provider rejected a DNS-unavailable source'
wait_active "$provider_unit" 30 || fail 'provider is inactive during DNS failure'
wait_values unavailable || fail 'DNS failure retained stale values'
sleep 2
printf 'DNS_FAILURE=FAIL_SAFE\n'

systemd-run --quiet --unit="$fixture_unit" --property=Type=simple \
    --property=Restart=no /usr/bin/python3 -I "$fixture"
wait_active "$fixture_unit" 30 || fail 'VISS fixture did not start for TLS test'
cat >"$configuration" <<'EOF'
{
  "schemaVersion": 1,
  "viss": {
    "uri": "wss://127.0.0.1:6443",
    "tlsServerName": "r61-invalid-tls-name.invalid"
  }
}
EOF
chmod 0644 "$configuration"
systemctl restart "$provider_unit" || fail 'provider rejected a TLS-invalid source'
wait_active "$provider_unit" 30 || fail 'provider is inactive during TLS failure'
wait_values unavailable || fail 'TLS failure retained stale values'
sleep 2
systemctl stop "$fixture_unit" >/dev/null 2>&1 || true
printf 'TLS_FAILURE=FAIL_SAFE\n'

install -o 0 -g 0 -m 0644 "$configuration_backup" "$configuration"
[ "$(sha256sum "$configuration" | cut -d' ' -f1)" = "$configuration_sha" ] ||
    fail 'vehicle configuration was not restored exactly'
restart_baseline || fail 'final baseline recovery failed'

printf 'MEMORY_MAX=%s\n' "$(systemctl show -p MemoryMax --value "$provider_unit")"
printf 'CPU_QUOTA=%s\n' "$(systemctl show -p CPUQuotaPerSecUSec --value "$provider_unit")"
printf 'TASKS_MAX=%s\n' "$(systemctl show -p TasksMax --value "$provider_unit")"
printf 'WATCHDOG_USEC=%s\n' "$(systemctl show -p WatchdogUSec --value "$provider_unit")"
printf 'DEPENDENCY_MODE=%s\n' "$mode"
printf 'R6_1_PROVIDER_DEPENDENCY_DISCOVERY=PASS\n'
