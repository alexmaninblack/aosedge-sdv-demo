set -eu
umask 077

mode=${1:-}
launcher=/tmp/r6-1-side-load-launcher.bin
policy=/tmp/r6-1-side-load-policy.pp
launcher_sha256=55dc2e826d639f8434785f54a3dd69e51beef89d6e9c07229718bed72952a071
policy_sha256=a1efd6434642210a09a80170a19830b63a6601871d1c32ef7e6f1fd4e3cba2e1
domain=vehicle_data_provider_t

fail() {
    printf 'R6.1 security side-load failed: %s\n' "$*" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'this helper must run as root'
[ "$(uname -m)" = aarch64 ] || fail 'guest is not AArch64'
grep -qx 'VERSION_ID=6.1.1-maninblack.9' /etc/os-release ||
    fail 'helper is restricted to the rejected .9 disposable base image'
[ "$(getenforce)" = Enforcing ] || fail 'global SELinux is not enforcing'

case "$mode" in
    discovery)
        [ -f "$launcher" ] && [ ! -L "$launcher" ] ||
            fail 'launcher side-load artifact is absent or unsafe'
        [ -f "$policy" ] && [ ! -L "$policy" ] ||
            fail 'policy side-load artifact is absent or unsafe'
        printf '%s  %s\n' "$launcher_sha256" "$launcher" |
            sha256sum -c --status || fail 'launcher digest mismatch'
        printf '%s  %s\n' "$policy_sha256" "$policy" |
            sha256sum -c --status || fail 'policy digest mismatch'
        mount -o remount,rw / || fail 'cannot remount disposable rootfs writable'
        install -o 0 -g 0 -m 0755 "$launcher" \
            /usr/libexec/aos-vehicle-data-provider-launcher ||
            fail 'cannot install the side-load launcher'
        semodule -i "$policy" || fail 'cannot install the side-load policy'
        restorecon /usr/libexec/aos-vehicle-data-provider-launcher ||
            fail 'cannot restore the launcher SELinux entrypoint label'
        semanage permissive -a "$domain" ||
            fail 'cannot make only the provider domain permissive'
        semanage permissive -l | grep -q "^[[:space:]]*$domain[[:space:]]*$" ||
            fail 'provider domain permissive state was not recorded'
        sync
        printf 'R6_1_SECURITY_SIDE_LOAD=DISCOVERY_READY\n'
        printf 'CLEAN_RESTART_REQUIRED=yes\n'
        ;;
    enforcing)
        semanage permissive -l | grep -q "^[[:space:]]*$domain[[:space:]]*$" ||
            fail 'provider domain is not in the discovery permissive set'
        mount -o remount,rw / || fail 'cannot remount disposable rootfs writable'
        semanage permissive -d "$domain" ||
            fail 'cannot restore provider-domain enforcement'
        if semanage permissive -l |
            grep -q "^[[:space:]]*$domain[[:space:]]*$"; then
            fail 'provider domain remains permissive'
        fi
        sync
        printf 'R6_1_SECURITY_SIDE_LOAD=ENFORCING_READY\n'
        printf 'CLEAN_RESTART_REQUIRED=yes\n'
        ;;
    *) fail 'usage: r6-1-security-side-load <discovery|enforcing>' ;;
esac
