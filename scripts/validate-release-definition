"""Read-only current build-definition gate; never downloads, builds or starts runtime."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT = Path('workspace/build-definition.json')
CURRENT_SCHEMA = Path('workspace/build-definition.schema.json')
SCHEMA = Path('workspace/inputs/product-inputs.schema.json')
LIMIT = 8 * 1024 * 1024  # Metadata only; never rehash the multi-GB payload here.
PROFILES = {'operator', 'developer', 'full-source'}
GROUPS = {'host-runtime', 'preparation-inputs', 'vm-runtime', 'cloud-runtime', 'backend-inputs'}
LOCKS = {
    'host-runtime': 'contracts/portable-host-launch/host-runtime.lock.json',
    'preparation-inputs': 'contracts/portable-preparation-inputs/vehicle-inputs.lock.json',
    'vm-runtime': 'contracts/portable-vm-launch/vm-runtime.lock.json',
    'cloud-runtime': 'contracts/portable-cloud-backend-inputs/cloud-runtime.lock.json',
    'backend-inputs': 'contracts/portable-cloud-backend-inputs/backend-inputs.lock.json',
}
COMPONENTS = {
    'unreal', 'carla-content', 'carla', 'native-host', 'python-host', 'vm-support',
    'cloud-sdk', 'factory-layer', 'aoscore-kuksa', 'factory', 'vdp', 'brake-service',
    'tire-service', 'brake-backend', 'tire-backend', 'gateway', 'presenter',
    'preparation', 'backend-export', 'application', 'setup-media',
}


class DefinitionError(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise DefinitionError(message)


def safe_path(root, value):
    path = Path(value)
    require(not path.is_absolute() and '..' not in path.parts and '\\' not in value,
            f'Unsafe relative path: {value}')
    result = root / path
    require(result.resolve().is_relative_to(root.resolve()), f'Path escapes root: {value}')
    require(not result.is_symlink(), f'Symlink is not an immutable metadata file: {value}')
    return result


def read_bytes(path):
    require(path.is_file(), f'Required metadata unavailable: {path}')
    require(path.stat().st_size <= LIMIT, f'Metadata exceeds size limit: {path.name}')
    with path.open('rb') as stream:
        data = stream.read(LIMIT + 1)
    require(len(data) <= LIMIT, f'Metadata exceeds size limit: {path.name}')
    return data


def unique_pairs(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, f'Duplicate JSON key: {key}')
        result[key] = value
    return result


def read_json(path):
    try:
        return json.loads(read_bytes(path), object_pairs_hook=unique_pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise DefinitionError(f'Invalid JSON: {path.name}') from exc


def schema_check(value, spec, at='$'):
    """Enforce every keyword used by our deliberately small JSON Schema subset.

    Unknown keywords fail closed, so extending the published schema cannot
    silently bypass validation. No third-party package/network is required.
    """
    supported = {'$schema', '$comment', 'title', 'type', 'const', 'enum', 'pattern',
                 'minimum', 'minLength', 'minItems', 'items', 'properties',
                 'required', 'additionalProperties'}
    require(set(spec) <= supported, f'{at}: unsupported schema keyword')
    types = {'object': dict, 'array': list, 'string': str, 'integer': int,
             'boolean': bool, 'null': type(None)}
    if 'type' in spec:
        choices = spec['type'] if isinstance(spec['type'], list) else [spec['type']]
        require(any(type(value) is types[t] for t in choices), f'{at}: invalid type')
    if 'const' in spec:
        require(type(value) is type(spec['const']) and value == spec['const'], f'{at}: wrong constant')
    if 'enum' in spec:
        require(value in spec['enum'], f'{at}: unsupported value {value!r}')
    if isinstance(value, str):
        require(len(value) >= spec.get('minLength', 0), f'{at}: empty value')
        if 'pattern' in spec:
            require(re.search(spec['pattern'], value) is not None, f'{at}: invalid format')
    if type(value) is int:
        require(value >= spec.get('minimum', value), f'{at}: below minimum')
    if isinstance(value, list):
        require(len(value) >= spec.get('minItems', 0), f'{at}: missing entries')
        for index, item in enumerate(value):
            schema_check(item, spec['items'], f'{at}[{index}]')
    if isinstance(value, dict):
        require(set(spec.get('required', [])) <= set(value), f'{at}: missing required field')
        properties = spec.get('properties', {})
        if spec.get('additionalProperties') is False:
            require(set(value) <= set(properties), f'{at}: unknown field')
        for key, item in value.items():
            if key in properties:
                schema_check(item, properties[key], f'{at}.{key}')


def indexed(rows, key, label):
    result = {row[key]: row for row in rows}
    require(len(result) == len(rows), f'{label}: duplicate {key}')
    return result


def unique(values, label):
    require(len(values) == len(set(values)), f'{label}: duplicate reference')


def validate_inputs(value, root=ROOT):
    """Validate the complete current source/input and component closure."""
    schema_check(value, read_json(root / SCHEMA))
    selected = read_json(root / DEFAULT)
    locked = read_json(root / selected['inputs']['sources'])['sources']
    sources = indexed(value['sources'], 'id', 'sources')
    expected = indexed(locked, 'id', 'source lock')
    require(set(sources) == set(expected), 'Incomplete source roles')
    for role, row in sources.items():
        require(row == expected[role], role + ': source/build revision or access boundary mismatch')
    repos = indexed(read_json(root / 'workspace/repositories.json')['repositories'], 'id', 'repositories')
    for role, row in repos.items():
        require(role in sources and sources[role]['revision'] == row['acceptedRevision'] and
                sources[role]['repository'] == row['repository'], 'Workspace source pin mismatch: ' + role)
    runtime = read_json(root / selected['inputs']['runtime'])
    for key in ('inputs', 'application', 'artifacts'):
        require(value[key] == runtime[key], 'Runtime input/provenance mismatch: ' + key)
    groups = indexed(value['inputs'], 'id', 'input groups')
    require(set(groups) == GROUPS, 'Incomplete input manifest set')
    for role, row in groups.items():
        require(row['lock'] == LOCKS[role], role + ': wrong manifest authority')
        require({k:row[k] for k in ('path','bytes','sha256')} == read_json(root / row['lock'])['manifest'],
                role + ': input manifest mismatch')
        require(row['kitPath'] == f'demo-artifacts/aosedge-sdv-demo/{role}/{row["path"]}', 'Wrong kit path')
    workflow = (root / '.github/workflows/repository-boundaries.yml').read_text()
    checkouts = dict(re.findall(r'repository: (\S+)\s+ref: ([0-9a-f]{40})', workflow))
    for role, row in repos.items():
        if role not in {'carla','unreal-engine'}:
            repo = row['repository'].removeprefix('https://github.com/').removesuffix('.git')
            require(checkouts.get(repo) == row['acceptedRevision'], 'CI checkout pin mismatch: ' + role)
    components = indexed(value['components'], 'id', 'components')
    require(set(components) == COMPONENTS, 'Incomplete component closure')
    require(set(indexed(value['profiles'], 'id', 'profiles')) == PROFILES, 'Missing profile')
    for profile in value['profiles']:
        unique(profile['components'], profile['id'])
        require(set(profile['components']) == COMPONENTS, 'Incomplete profile closure')
    for role, component in components.items():
        for field, allowed in [('sourceIds',sources),('manifestIds',groups),('requires',components)]:
            unique(component[field], role + '.' + field)
            require(set(component[field]) <= set(allowed), 'Unknown ' + field)
        require(component['actions']['operator'] == 'reuse', 'Operator must not build')
        for recipe in component['recipes']:
            require(recipe['source'] in sources, 'Unknown recipe source')
            if recipe['source'] == 'integration':
                require(safe_path(root, recipe['path']).is_file(), 'Missing recipe: ' + recipe['path'])
    visiting, done = set(), set()
    def visit(role):
        require(role not in visiting, 'Dependency cycle')
        if role in done: return
        visiting.add(role)
        for child in components[role]['requires']: visit(child)
        visiting.remove(role); done.add(role)
    for role in components: visit(role)
    tools = indexed(value['toolchains'], 'id', 'toolchains')
    package = read_json(root / 'apps/presenter-ui/package.json')
    for name in ('node','npm'):
        require(tools.get('ui-'+name,{}).get('identity') == package['engines'][name], 'UI toolchain mismatch')
    for tool in tools.values(): require(safe_path(root, tool['evidence']).is_file(), 'Missing toolchain evidence')
    indexed(value['gates'], 'id', 'gates')
    return value


def resolve(value, root=ROOT):
    """Standalone v3 selection. No old release files or Git history required."""
    schema_check(value, read_json(root / CURRENT_SCHEMA))
    authorities = indexed(value['authorities'], 'path', 'authorities')
    needed = {*value['inputs'].values(), 'workspace/repositories.json',
              'workspace/cloud-worker-wheels.lock.json', 'workspace/gateway-build-sdk.lock.json',
              'apps/presenter-ui/package.json', 'apps/presenter-ui/package-lock.json', *LOCKS.values()}
    require(needed <= authorities.keys(), 'Missing required authority binding')
    for path, row in authorities.items():
        require(hashlib.sha256(read_bytes(safe_path(root,path))).hexdigest() == row['sha256'],
                'Authority digest mismatch: ' + path)
    data = {role:read_json(safe_path(root,path)) for role,path in value['inputs'].items()}
    require(all(type(v.get('schemaVersion')) is int and v['schemaVersion'] == 1 for v in data.values()),
            'Unsupported input lock schema')
    cache = data['cache']
    require(set(cache) == {'schemaVersion','definitionDigest','storageReleaseId','inputClosure',
                          'sourceControllerCheckpointSha256','scope'}, 'Invalid cache compatibility record')
    require(isinstance(cache['definitionDigest'],str) and re.fullmatch('[a-f0-9]{64}',cache['definitionDigest'])
            and isinstance(cache['storageReleaseId'],str) and re.fullmatch('[a-z0-9][a-z0-9.-]{0,100}',cache['storageReleaseId']),
            'Invalid cache namespace')
    closure = {path:hashlib.sha256(read_bytes(root/path)).hexdigest()
               for role,path in value['inputs'].items() if role != 'cache'}
    require(cache['inputClosure'] == closure, 'Cache compatibility input closure differs')
    result = {'id':value['id'], 'sources':data['sources']['sources'],
              **{k:data['runtime'][k] for k in ('inputs','application','artifacts')},
              **{k:data['policy'][k] for k in ('profiles','components','toolchains','gates')}}
    validate_inputs(result,root)
    selection = read_json(safe_path(root,value['developerSelection']))
    require(set(selection) == {'schemaVersion','path','sha256'} and type(selection['schemaVersion']) is int
            and selection['schemaVersion'] == 1 and Path(selection['path']).parent == Path('workspace/releases')
            and selection['path'].endswith('.json'), 'Invalid developer selection')
    plan_path = safe_path(root,selection['path'])
    require(hashlib.sha256(read_bytes(plan_path)).hexdigest() == selection['sha256'], 'Developer plan pin mismatch')
    plan = read_json(plan_path)
    require(plan.get('baseDefinitionSha256') == cache['definitionDigest'] and
            plan.get('resultPolicy') == 'seal-developer-results-v1', 'Developer plan input identity mismatch')
    catalog = read_json(safe_path(root,value['operatorSelection']))
    # Operator media is a delivery output, never a developer build input.
    # Validate A's independently selected descriptor, not B's input lock.
    from reproduction.delivery import descriptor
    try:
        delivery = descriptor(safe_path(root,catalog['operatorDescriptor']).resolve())
    except (ValueError,RuntimeError,TypeError,KeyError):
        raise DefinitionError('Invalid selected operator delivery descriptor') from None
    require(catalog.get('product') == 'aosedge-sdv-lab', 'Wrong operator product')
    for field in ('productVersion','status','file','bytes','sha256','manifestSha256','notarized'):
        require(field in delivery and delivery[field] == catalog['operator'].get(field), 'Operator descriptor mismatch: '+field)
    unique(value['documentation'],'documentation')
    for path in value['documentation']: require(safe_path(root,path).is_file(), 'Missing current documentation')
    return result


def validate(value, root=ROOT):
    return resolve(value,root)


def cache_identity(selected, root=ROOT):
    resolve(selected,root)
    return read_json(safe_path(root,selected['inputs']['cache']))


def verify_kit(value, kit):
    """Check existing small manifests, not payload integrity or runtime behavior."""
    checked = {}
    for row in [dict(value['application'], id='application'), *value['inputs']]:
        data = read_bytes(safe_path(kit, row['kitPath']))
        require(len(data) == row['bytes'] and hashlib.sha256(data).hexdigest() == row['sha256'],
                f'{row["id"]}: kit manifest digest/size mismatch')
        checked[row['id']] = json.loads(data, object_pairs_hook=unique_pairs)
    require(checked['application']['inputs'] == {
        row['id']: {k: row[k] for k in ('path', 'bytes', 'sha256')} for row in value['inputs']
    }, 'Application input bindings mismatch')
    host = next(row for row in value['inputs'] if row['id'] == 'host-runtime')
    require(checked['vm-runtime']['hostManifest'] == {k: host[k] for k in ('path', 'bytes', 'sha256')},
            'VM/host manifest binding mismatch')
    require(checked['application']['inputLogicalBytes'] == value['application']['inputLogicalBytes'],
            'Recorded input size mismatch')
    return len(checked)


def git_metadata(repository, *arguments):
    """Inspect local immutable objects only, without lazy fetching or hooks."""
    require(repository.is_dir(), f'Source checkout unavailable: {repository.name}')
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env.update(GIT_NO_LAZY_FETCH='1', GIT_TERMINAL_PROMPT='0',
               GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull)
    try:
        result = subprocess.run(['git', '--no-pager', '-C', str(repository), *arguments],
                                env=env, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise DefinitionError(f'Local Git inspection unavailable: {repository.name}') from exc
    require(result.returncode == 0, f'Required local Git object unavailable: {repository.name}')
    return result.stdout.strip()


def verify_sources(value, workspace, root=ROOT):
    """Optional source provenance check, not checkout preparation or a build."""
    directories = {r['id']: r['directory'] for r in read_json(root / 'workspace/repositories.json')['repositories']}
    directories.update(integration='aosedge-sdv-demo', **{'factory-tools': 'aosedge-sdv-demo'})
    sources = indexed(value['sources'], 'id', 'sources')
    for id_, source in sources.items():
        repository = safe_path(workspace, directories[id_])
        top = git_metadata(repository, 'rev-parse', '--show-toplevel')
        require(Path(top).resolve() == repository.resolve(), f'{id_}: wrong checkout root')
        require(git_metadata(repository, 'cat-file', '-t', source['revision']) == 'commit',
                f'{id_}: revision is not a commit')
    integration = safe_path(workspace, directories['integration'])
    recipes = {(r['source'], r['path']) for c in value['components'] for r in c['recipes']}
    for id_, path in sorted(recipes):
        repository = safe_path(workspace, directories[id_])
        type_ = git_metadata(repository, 'cat-file', '-t', f'{sources[id_]["revision"]}:{path}')
        require(type_ == 'blob', f'{id_}: recipe is not a file: {path}')
    return len(sources), len(recipes)


def readiness(value, profile):
    require(profile in PROFILES, f'Unsupported profile: {profile}')
    pending = [g for g in value['gates'] if profile in g['profiles']]
    # v1 describes an unqualified historical candidate only. Future promotion
    # needs a reviewed schema and qualification evidence, not deletion of gates.
    return [f'{g["id"]}: {g["resolution"]}' for g in pending] + [
        'PROFILE_NOT_QUALIFIED: no fresh-environment reproduction claim for this candidate.']


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--manifest', type=Path, default=ROOT / DEFAULT)
    parser.add_argument('--kit-root', type=Path, help='Optional existing kit; read six small manifests only')
    parser.add_argument('--source-workspace', type=Path, help='Optional existing sibling sources; inspect pinned Git objects without fetching or changing checkouts')
    parser.add_argument('--profile', help='Require reproduction readiness; unresolved candidate exits 2')
    args = parser.parse_args(argv)
    try:
        selected = read_json(args.manifest)
        value = resolve(selected)
        print(f'DEFINITION_VALID: {selected["id"]}; 3 profiles, {len(value["components"])} components')
        if args.kit_root:
            count = verify_kit(value, args.kit_root)
            print(f'KIT_METADATA_MATCH: {count} manifests; payloads and runtime NOT checked')
        if args.source_workspace:
            sources, recipes = verify_sources(value, args.source_workspace)
            print(f'SOURCE_OBJECTS_MATCH: {sources} roles, {recipes} recipe files; build NOT checked')
        if args.profile:
            pending = readiness(value, args.profile)
            print(f'PROFILE_BLOCKED: {args.profile}')
            for item in pending:
                print(f'- {item}')
            return 2
        print('Reproduction readiness NOT claimed; use --profile to inspect gates.')
        return 0
    except (DefinitionError, OSError, KeyError, IndexError, TypeError, json.JSONDecodeError) as exc:
        print(f'DEFINITION_INVALID: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
