"""Build the accepted self-contained demo interaction mockup."""

from __future__ import annotations

import base64
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
MOCKUP_DIR = ROOT / "docs" / "demo" / "mockups"
SOURCE = MOCKUP_DIR / "aosedge-demo-interaction-mockup-2-4.source.html"
OUTPUT = MOCKUP_DIR / "aosedge-demo-interaction-mockup-2-4.html"

ICON_PATHS = {
    number: f"icons/image{number}.png" for number in range(1, 14)
}
CUSTOM_ICON_PATHS = {
    "EVIDENCE": "icons/qualification-evidence.png",
    "SAFE": "icons/vehicle-safe-stop.png",
    "LINK": "icons/connectivity-available.png",
    "SIGNAL": "icons/vehicle-signals-vss.png",
    "LOG": "icons/operational-logs.png",
    "QUOTA": "icons/service-quota-isolation.png",
    "RESET": "icons/end-reset-demo.png",
    "REC": "icons/recovery-reconcile.png",
}
STATIC_PATHS = (
    "icons/image2.png",
    "icons/image4.png",
    "icons/image8.png",
    "icons/image11.png",
    "icons/vehicle-safe-stop.png",
    "icons/connectivity-available.png",
    "icons/vehicle-signals-vss.png",
    "source-screenshots/carla-simulator-live.jpeg",
    "source-screenshots/engineering-telematics-dashboard-live.png",
)


def data_uri(relative_path: str) -> str:
    path = MOCKUP_DIR / relative_path
    if not path.is_file():
        raise SystemExit(f"missing mockup asset: {relative_path}")
    suffix = path.suffix.lower()
    mime_type = "image/png" if suffix == ".png" else "image/jpeg"
    encoded = base64.b64encode(path.read_bytes()).decode("ascii")
    return f"data:{mime_type};base64,{encoded}"


def compact_json(value: object) -> str:
    return json.dumps(value, ensure_ascii=True, separators=(",", ":"))


def replace_once(text: str, old: str, new: str, label: str) -> str:
    if text.count(old) != 1:
        raise SystemExit(f"expected exactly one {label} marker")
    return text.replace(old, new, 1)


def main() -> None:
    text = SOURCE.read_text(encoding="utf-8")

    for relative_path in STATIC_PATHS:
        marker = f'src="{relative_path}"'
        replacement = f'src="{data_uri(relative_path)}"'
        if marker not in text:
            raise SystemExit(f"missing static asset reference: {relative_path}")
        text = text.replace(marker, replacement)

    icon_data = {
        str(number): data_uri(relative_path)
        for number, relative_path in ICON_PATHS.items()
    }
    custom_icon_data = {
        key: data_uri(relative_path)
        for key, relative_path in CUSTOM_ICON_PATHS.items()
    }

    old_icon_helper = (
        "    function iconMarkup(number,alt='',className='ui-icon')"
        "{return `<img class=\"${className}\" src=\"icons/image${number}.png\" "
        "alt=\"${esc(alt)}\">`; }"
    ).replace("`; }", "`;}")
    new_icon_helper = (
        f"    const embeddedIconData={compact_json(icon_data)};\n"
        "    function iconMarkup(number,alt='',className='ui-icon')"
        "{return `<img class=\"${className}\" src=\"${embeddedIconData[number]}\" "
        "alt=\"${esc(alt)}\">`; }"
    ).replace("`; }", "`;}")
    text = replace_once(text, old_icon_helper, new_icon_helper, "icon helper")

    old_custom_helpers = (
        "    const customIconFiles={EVIDENCE:'qualification-evidence.png',"
        "SAFE:'vehicle-safe-stop.png',LINK:'connectivity-available.png',"
        "SIGNAL:'vehicle-signals-vss.png',LOG:'operational-logs.png',"
        "QUOTA:'service-quota-isolation.png',RESET:'end-reset-demo.png',"
        "REC:'recovery-reconcile.png'};\n"
        "    function customIconMarkup(key,alt='',className='ui-icon')"
        "{return `<img class=\"${className}\" src=\"icons/${customIconFiles[key]}\" "
        "alt=\"${esc(alt)}\">`; }"
    ).replace("`; }", "`;}")
    new_custom_helpers = (
        f"    const embeddedCustomIconData={compact_json(custom_icon_data)};\n"
        "    function customIconMarkup(key,alt='',className='ui-icon')"
        "{return `<img class=\"${className}\" src=\"${embeddedCustomIconData[key]}\" "
        "alt=\"${esc(alt)}\">`; }"
    ).replace("`; }", "`;}")
    text = replace_once(
        text, old_custom_helpers, new_custom_helpers, "custom icon helpers"
    )

    text = text.replace(
        "<!doctype html>",
        "<!doctype html>\n<!-- Generated by scripts/build-demo-interaction-mockup; "
        "edit the .source.html file and repository-local assets. -->",
        1,
    )

    forbidden = ('src="icons/', 'src="source-screenshots/')
    if any(marker in text for marker in forbidden):
        raise SystemExit("generated mockup still contains an external image reference")

    OUTPUT.write_text(text, encoding="utf-8")
    print(f"Built {OUTPUT.relative_to(ROOT)} ({OUTPUT.stat().st_size} bytes)")


if __name__ == "__main__":
    main()
