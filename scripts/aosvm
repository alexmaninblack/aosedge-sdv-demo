#!/bin/sh

set -eu
umask 077

RELEASE="6.1.0"
ASSET="aos-vm-image-qemuarm64-6.1.0.tar.xz"
ASSET_SIZE="381515220"
ASSET_SHA256="db8fef0188f4ba0930aecafecdfe4ad063a3cf27a48e8649fc5050f9b3117e04"
ASSET_URL="https://github.com/aosedge/meta-aos-vm/releases/download/v6.1.0/aos-vm-image-qemuarm64-6.1.0.tar.xz"
MAIN_IMAGE="aos-vm-main-qemuarm64.qcow2"
MAIN_IMAGE_SIZE="593428480"
MAIN_IMAGE_SHA256="8cbc4bd331650fbae7b54ad5b11b00e36e275cea00298327629e568422023fc4"
SECONDARY_IMAGE="aos-vm-secondary-qemuarm64.qcow2"
SECONDARY_IMAGE_SIZE="573833216"
SECONDARY_IMAGE_SHA256="c6b687c180bab7621d5680c6e44894b531edc8a64cd6851afd467cec2dc193f6"
FIRMWARE="QEMU_EFI.fd"
FIRMWARE_SIZE="2097152"
FIRMWARE_SHA256="30f7042c23b81c28b8196a76f4af6bcf10046f08049c9d78b4387472c5bbcd10"
IMAGE_VIRTUAL_SIZE="6997147648"
OVERLAY="aosvm-main-overlay.qcow2"
LIFECYCLE_STATE="aosvm-main-lifecycle.json"
LIFECYCLE_GUARD="aosvm-main-provisioning-lock.json"
PRE_PROVISION_BACKUP="aosvm-main-pre-provision.qcow2"
POST_PROVISION_BACKUP="aosvm-main-post-provision.qcow2"
QEMU_QUALIFIED_VERSIONS="11.0.3 11.1.0"
QEMU_MACHINE="virt-11.0"
QEMU_CPU="host"
QEMU_VCPUS="2"
QEMU_MEMORY_MIB="2048"
VM_NAME="aosvm-main"
VM_MAC_ADDRESS="52:54:00:41:4f:53"
GUEST_NETWORK="10.0.0.0/24"
GUEST_ADDRESS="10.0.0.100"
GUEST_SSH_PORT="22"
GUEST_PROVISIONING_PORT="8089"
GUEST_VISIBLE_HOST="10.0.0.1"
GUEST_DNS_PROXY="10.0.0.2"
HOST_DNS_ADDRESS="127.0.0.1"
HOST_DNS_PORT=${AOSVM_HOST_DNS_PORT:-"18053"}
PROVISIONING_HOST_ADDRESS="127.0.0.1"
PROVISIONING_HOST_PORT=${AOSVM_PROVISIONING_HOST_PORT:-"18089"}
MINIMUM_HOST_MEMORY_BYTES="4294967296"
MINIMUM_HOST_FREE_KIB="20971520"
START_TIMEOUT_SECONDS=${AOSVM_START_TIMEOUT_SECONDS:-"30"}
STOP_TIMEOUT_SECONDS=${AOSVM_STOP_TIMEOUT_SECONDS:-"90"}
TERM_TIMEOUT_SECONDS=${AOSVM_TERM_TIMEOUT_SECONDS:-"15"}
SMOKE_TIMEOUT_SECONDS=${AOSVM_SMOKE_TIMEOUT_SECONDS:-"90"}

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)
CACHE_ROOT=${AOSVM_CACHE_ROOT:-"$REPOSITORY_ROOT/.cache"}
LOCAL_ROOT=${AOSVM_LOCAL_ROOT:-"$REPOSITORY_ROOT/.local"}
BACKUP_ROOT_OVERRIDE=${AOSVM_BACKUP_ROOT:-}
RUN_ROOT=${AOSVM_RUN_ROOT:-"$REPOSITORY_ROOT/.run"}
RUNS_ROOT=${AOSVM_RUNS_ROOT:-"$REPOSITORY_ROOT/runs"}
SSH_HOST_PORT=${AOSVM_SSH_HOST_PORT:-"10022"}
RELEASE_DIR="$CACHE_ROOT/aosvm/v$RELEASE/qemuarm64"
ARCHIVE_PATH="$RELEASE_DIR/$ASSET"
PARTIAL_PATH="$ARCHIVE_PATH.partial"
MAIN_IMAGE_PATH="$RELEASE_DIR/$MAIN_IMAGE"
SECONDARY_IMAGE_PATH="$RELEASE_DIR/$SECONDARY_IMAGE"
FIRMWARE_PATH="$RELEASE_DIR/$FIRMWARE"
OVERLAY_PATH="$LOCAL_ROOT/$OVERLAY"
LIFECYCLE_GUARD_PATH="$LOCAL_ROOT/$LIFECYCLE_GUARD"
LIFECYCLE_STATE_PATH=''
PID_PATH="$RUN_ROOT/$VM_NAME.pid"
QMP_SOCKET_PATH="$RUN_ROOT/$VM_NAME.qmp"
SERIAL_SOCKET_PATH="$RUN_ROOT/$VM_NAME.serial"
SERIAL_LOG_PATH="$RUNS_ROOT/$VM_NAME-serial.log"
DNS_BRIDGE_PID_PATH="$RUN_ROOT/$VM_NAME-dns.pid"
DNS_BRIDGE_LOG_PATH="$RUNS_ROOT/$VM_NAME-dns.log"
DNS_BRIDGE_SCRIPT="$REPOSITORY_ROOT/scripts/host/aosvm-dns-bridge"
QMP_HELPER="$REPOSITORY_ROOT/scripts/host/aosvm-qmp"
SUPERVISOR_PID_PATH="$RUN_ROOT/$VM_NAME-supervisor.pid"
SUPERVISOR_LOG_PATH="$RUNS_ROOT/$VM_NAME-supervisor.log"
LIFECYCLE_LOCK_DIR="$RUN_ROOT/$VM_NAME.lifecycle.lock"
SCRIPT_PATH="$REPOSITORY_ROOT/scripts/aosvm"

PREPARE_WORK_DIR=''
PREPARE_LOCK_DIR=''
QEMU_SYSTEM_PATH=''
QEMU_SYSTEM_VERSION=''
DNS_BRIDGE_PID=''
QEMU_CHILD_PID=''
LIFECYCLE_LOCK_HELD=0
SUPERVISOR_MODE=0
BACKGROUND_START_PID=''
BACKUP_ROOT=''
CHECKPOINT_WORK_DIR=''
CHECKPOINT_GUARD_PARTIAL=''
LIFECYCLE_STATUS='unprotected'

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "Required command is not available: $1"
}

validate_decimal_range() {
    decimal_value=$1
    decimal_minimum=$2
    decimal_maximum=$3
    decimal_label=$4

    case "$decimal_value" in
        ''|*[!0-9]*) fail "$decimal_label must be a decimal integer" ;;
    esac
    [ "$decimal_value" -ge "$decimal_minimum" ] &&
        [ "$decimal_value" -le "$decimal_maximum" ] ||
        fail "$decimal_label must be between $decimal_minimum and $decimal_maximum"
}

file_size() {
    stat -f '%z' "$1"
}

file_sha256() {
    shasum -a 256 "$1" | awk '{print $1}'
}

validate_effective_url() {
    effective_url=$1

    case "$effective_url" in
        https://*) ;;
        *) fail "Download did not finish on an HTTPS URL" ;;
    esac

    effective_authority=${effective_url#https://}
    effective_authority=${effective_authority%%/*}
    effective_host=${effective_authority%%:*}

    case "$effective_host" in
        github.com|release-assets.githubusercontent.com|objects.githubusercontent.com) ;;
        *) fail "Download redirected to an unexpected host" ;;
    esac
}

verify_archive() {
    verified_archive_path=$1

    [ ! -L "$verified_archive_path" ] ||
        fail "Archive must not be a symbolic link: $verified_archive_path"
    [ -f "$verified_archive_path" ] || fail "Archive does not exist: $verified_archive_path"

    verified_actual_size=$(file_size "$verified_archive_path")
    [ "$verified_actual_size" = "$ASSET_SIZE" ] ||
        fail "Archive size mismatch: expected $ASSET_SIZE bytes, found $verified_actual_size bytes"

    verified_actual_sha256=$(file_sha256 "$verified_archive_path")
    [ "$verified_actual_sha256" = "$ASSET_SHA256" ] ||
        fail "Archive SHA-256 mismatch: expected $ASSET_SHA256, found $verified_actual_sha256"
}

verify_release_file() {
    release_file_path=$1
    release_file_size=$2
    release_file_sha256=$3
    release_file_label=$4

    [ ! -L "$release_file_path" ] ||
        fail "$release_file_label must not be a symbolic link: $release_file_path"
    [ -f "$release_file_path" ] ||
        fail "$release_file_label is not a regular file: $release_file_path"

    release_actual_size=$(file_size "$release_file_path")
    [ "$release_actual_size" = "$release_file_size" ] ||
        fail "$release_file_label size mismatch: expected $release_file_size bytes, found $release_actual_size bytes"

    release_actual_sha256=$(file_sha256 "$release_file_path")
    [ "$release_actual_sha256" = "$release_file_sha256" ] ||
        fail "$release_file_label SHA-256 mismatch: expected $release_file_sha256, found $release_actual_sha256"
}

verify_base_image() {
    base_image_path=$1
    base_image_label=$2

    base_image_info=$(qemu-img info --output=json "$base_image_path")
    printf '%s\n' "$base_image_info" | jq -e \
        --argjson expected_virtual_size "$IMAGE_VIRTUAL_SIZE" \
        '.format == "qcow2" and
         .["virtual-size"] == $expected_virtual_size and
         .["dirty-flag"] == false and
         .["format-specific"].data.corrupt == false and
         (has("backing-filename") | not)' >/dev/null ||
        fail "$base_image_label qcow2 metadata does not match the pinned release"

    qemu-img check "$base_image_path" >/dev/null ||
        fail "$base_image_label failed qemu-img check"
}

absolute_path() {
    absolute_path_directory=$(CDPATH='' cd -- "$(dirname -- "$1")" && pwd)
    printf '%s/%s\n' "$absolute_path_directory" "$(basename -- "$1")"
}

file_mode() {
    stat -f '%Lp' "$1"
}

verify_overlay() {
    overlay_to_verify=$1
    overlay_access_mode=${2:-exclusive}
    expected_backing_path=$(absolute_path "$MAIN_IMAGE_PATH")

    [ ! -L "$overlay_to_verify" ] ||
        fail "Overlay must not be a symbolic link: $overlay_to_verify"
    [ -f "$overlay_to_verify" ] ||
        fail "Overlay is not a regular file: $overlay_to_verify"

    case "$overlay_access_mode" in
        exclusive)
            overlay_info=$(qemu-img info --output=json "$overlay_to_verify")
            ;;
        shared)
            overlay_info=$(qemu-img info -U --output=json "$overlay_to_verify")
            ;;
        *) fail "Unknown overlay verification mode: $overlay_access_mode" ;;
    esac
    printf '%s\n' "$overlay_info" | jq -e \
        --arg expected_backing "$expected_backing_path" \
        --argjson expected_virtual_size "$IMAGE_VIRTUAL_SIZE" \
        '.format == "qcow2" and
         .["virtual-size"] == $expected_virtual_size and
         .["dirty-flag"] == false and
         .["backing-filename"] == $expected_backing and
         .["backing-filename-format"] == "qcow2" and
         .["format-specific"].data.corrupt == false' >/dev/null ||
        fail "Overlay qcow2 metadata or backing file is not the expected value"

    if [ "$overlay_access_mode" = shared ]; then
        qemu-img check -U "$overlay_to_verify" >/dev/null ||
            fail "Overlay failed shared qemu-img check"
    else
        qemu-img check "$overlay_to_verify" >/dev/null ||
            fail "Overlay failed qemu-img check"
    fi
}

verify_standalone_backup() {
    backup_to_verify=$1

    [ ! -L "$backup_to_verify" ] ||
        fail "Checkpoint must not be a symbolic link: $backup_to_verify"
    [ -f "$backup_to_verify" ] ||
        fail "Checkpoint is not a regular file: $backup_to_verify"
    [ "$(file_mode "$backup_to_verify")" = "600" ] ||
        fail "Checkpoint mode must be 0600: $backup_to_verify"

    backup_info=$(qemu-img info --output=json "$backup_to_verify")
    printf '%s\n' "$backup_info" | jq -e \
        --argjson expected_virtual_size "$IMAGE_VIRTUAL_SIZE" \
        '.format == "qcow2" and
         .["virtual-size"] == $expected_virtual_size and
         .["dirty-flag"] == false and
         .["format-specific"].data.corrupt == false and
         (has("backing-filename") | not)' >/dev/null ||
        fail "Checkpoint is not a healthy standalone qcow2 image"

    qemu-img check "$backup_to_verify" >/dev/null ||
        fail "Checkpoint failed qemu-img check"
}

resolve_backup_root() {
    if [ -n "$BACKUP_ROOT_OVERRIDE" ]; then
        BACKUP_ROOT=$BACKUP_ROOT_OVERRIDE
    else
        [ -n "${HOME:-}" ] ||
            fail "HOME is unavailable; set AOSVM_BACKUP_ROOT explicitly"
        BACKUP_ROOT="$HOME/Library/Application Support/CarlaAosEdge/AosVM/backups"
    fi
    case "$BACKUP_ROOT" in
        /*) ;;
        *) fail "Checkpoint directory must be an absolute path: $BACKUP_ROOT" ;;
    esac
    [ "$BACKUP_ROOT" != "/" ] ||
        fail "Checkpoint directory must not be the filesystem root"
}

verify_lifecycle_state() {
    LIFECYCLE_STATUS='unprotected'

    resolve_backup_root
    LIFECYCLE_STATE_PATH="$BACKUP_ROOT/$LIFECYCLE_STATE"

    [ ! -L "$LIFECYCLE_GUARD_PATH" ] ||
        fail "Lifecycle guard must not be a symbolic link: $LIFECYCLE_GUARD_PATH"
    [ ! -L "$BACKUP_ROOT" ] ||
        fail "Checkpoint directory must not be a symbolic link: $BACKUP_ROOT"
    [ ! -L "$LIFECYCLE_STATE_PATH" ] ||
        fail "Lifecycle state must not be a symbolic link: $LIFECYCLE_STATE_PATH"

    guard_present=0
    state_present=0
    [ ! -e "$LIFECYCLE_GUARD_PATH" ] || guard_present=1
    [ ! -e "$LIFECYCLE_STATE_PATH" ] || state_present=1

    if [ "$guard_present" -eq 0 ] && [ "$state_present" -eq 0 ]; then
        return
    fi
    [ "$guard_present" -eq 1 ] && [ "$state_present" -eq 1 ] ||
        fail "Protected lifecycle metadata is incomplete; overlay reset and provisioning are blocked"

    [ -d "$LOCAL_ROOT" ] ||
        fail "Protected active VM directory is unavailable: $LOCAL_ROOT"
    [ -f "$LIFECYCLE_GUARD_PATH" ] ||
        fail "Lifecycle guard is not a regular file: $LIFECYCLE_GUARD_PATH"
    [ "$(file_mode "$LIFECYCLE_GUARD_PATH")" = "600" ] ||
        fail "Lifecycle guard mode must be 0600: $LIFECYCLE_GUARD_PATH"
    [ -d "$BACKUP_ROOT" ] ||
        fail "Checkpoint path is not a directory: $BACKUP_ROOT"
    [ "$(file_mode "$BACKUP_ROOT")" = "700" ] ||
        fail "Checkpoint directory mode must be 0700: $BACKUP_ROOT"

    [ -f "$LIFECYCLE_STATE_PATH" ] ||
        fail "Lifecycle state is not a regular file: $LIFECYCLE_STATE_PATH"
    [ "$(file_mode "$LIFECYCLE_STATE_PATH")" = "600" ] ||
        fail "Lifecycle state mode must be 0600: $LIFECYCLE_STATE_PATH"

    expected_active_overlay=$(absolute_path "$OVERLAY_PATH")
    lifecycle_json=$(cat "$LIFECYCLE_STATE_PATH")
    lifecycle_lock_id=$(printf '%s\n' "$lifecycle_json" |
        jq -er 'select(.lockId | test("^[0-9a-f]{64}$")) | .lockId') ||
        fail "Lifecycle state has no valid lock ID"
    jq -e \
        --arg vm "$VM_NAME" \
        --arg active_overlay "$expected_active_overlay" \
        --arg base_sha256 "$MAIN_IMAGE_SHA256" \
        --arg lock_id "$lifecycle_lock_id" \
        'select(.schema == 1 and .vm == $vm and
                .activeOverlay == $active_overlay and
                .baseImageSha256 == $base_sha256 and
                .lockId == $lock_id and .resetLocked == true)' \
        "$LIFECYCLE_GUARD_PATH" >/dev/null ||
        fail "Lifecycle guard does not match the protected active VM"
    LIFECYCLE_STATUS=$(printf '%s\n' "$lifecycle_json" | jq -er \
        --arg vm "$VM_NAME" \
        --arg active_overlay "$expected_active_overlay" \
        --arg base_sha256 "$MAIN_IMAGE_SHA256" \
        'select(.schema == 1 and .vm == $vm and
                .activeOverlay == $active_overlay and
                .baseImageSha256 == $base_sha256 and
                .lockId == .preProvisionBackupSha256 and
                (.lifecycle == "provisioning-locked" or
                 .lifecycle == "provisioned") and
                (.preProvisionBackup | type == "string") and
                (.preProvisionBackupSha256 | test("^[0-9a-f]{64}$"))) |
         .lifecycle') ||
        fail "Lifecycle state does not match the supported schema"

    pre_provision_backup=$(printf '%s\n' "$lifecycle_json" |
        jq -er '.preProvisionBackup')
    [ "$pre_provision_backup" = "$BACKUP_ROOT/$PRE_PROVISION_BACKUP" ] ||
        fail "Lifecycle state names an unexpected pre-provision checkpoint"
    [ ! -L "$pre_provision_backup" ] && [ -f "$pre_provision_backup" ] ||
        fail "Protected pre-provision checkpoint is unavailable: $pre_provision_backup"
    [ "$(file_mode "$pre_provision_backup")" = "600" ] ||
        fail "Protected pre-provision checkpoint mode must be 0600"

    if [ "$LIFECYCLE_STATUS" = "provisioned" ]; then
        printf '%s\n' "$lifecycle_json" | jq -e \
            'select((.postProvisionBackup | type == "string") and
                           (.postProvisionBackupSha256 |
                            test("^[0-9a-f]{64}$")))' >/dev/null ||
            fail "Provisioned lifecycle state has no valid sealed checkpoint"
        post_provision_backup=$(printf '%s\n' "$lifecycle_json" |
            jq -er '.postProvisionBackup')
        [ "$post_provision_backup" = "$BACKUP_ROOT/$POST_PROVISION_BACKUP" ] ||
            fail "Lifecycle state names an unexpected post-provision checkpoint"
        [ ! -L "$post_provision_backup" ] && [ -f "$post_provision_backup" ] ||
            fail "Protected post-provision checkpoint is unavailable: $post_provision_backup"
        [ "$(file_mode "$post_provision_backup")" = "600" ] ||
            fail "Protected post-provision checkpoint mode must be 0600"
    fi
}

prepare_cleanup() {
    if [ -n "$PREPARE_WORK_DIR" ] && [ -d "$PREPARE_WORK_DIR" ]; then
        rm -r "$PREPARE_WORK_DIR"
    fi
    if [ -n "$PREPARE_LOCK_DIR" ] && [ -d "$PREPARE_LOCK_DIR" ]; then
        rmdir "$PREPARE_LOCK_DIR" 2>/dev/null || true
    fi
}

checkpoint_cleanup() {
    if [ -n "$CHECKPOINT_WORK_DIR" ] && [ -d "$CHECKPOINT_WORK_DIR" ]; then
        rm -r "$CHECKPOINT_WORK_DIR"
    fi
    if [ -n "$CHECKPOINT_GUARD_PARTIAL" ] &&
       [ -f "$CHECKPOINT_GUARD_PARTIAL" ]; then
        rm "$CHECKPOINT_GUARD_PARTIAL"
    fi
    release_lifecycle_lock
}

validate_archive_members() {
    expected_members_path="$PREPARE_WORK_DIR/expected-members"
    actual_members_path="$PREPARE_WORK_DIR/actual-members"
    verbose_members_path="$PREPARE_WORK_DIR/verbose-members"

    printf '%s\n' "$MAIN_IMAGE" "$SECONDARY_IMAGE" "$FIRMWARE" |
        LC_ALL=C sort >"$expected_members_path"
    tar -tf "$ARCHIVE_PATH" | LC_ALL=C sort >"$actual_members_path"

    cmp -s "$expected_members_path" "$actual_members_path" ||
        fail "Archive members do not exactly match the pinned release manifest"

    tar -tvf "$ARCHIVE_PATH" >"$verbose_members_path"
    awk '
        NF == 0 { next }
        substr($1, 1, 1) != "-" { exit 1 }
        END { if (NR != 3) exit 1 }
    ' "$verbose_members_path" ||
        fail "Archive must contain exactly three regular files"
}

install_prepared_file() {
    prepared_source=$1
    prepared_target=$2
    prepared_size=$3
    prepared_sha256=$4
    prepared_label=$5

    if [ -e "$prepared_target" ] || [ -L "$prepared_target" ]; then
        verify_release_file "$prepared_target" "$prepared_size" "$prepared_sha256" "$prepared_label"
    else
        chmod 0444 "$prepared_source"
        mv "$prepared_source" "$prepared_target"
    fi

    chmod 0444 "$prepared_target"
}

download_archive() {
    require_command curl
    require_command shasum
    require_command stat

    mkdir -p "$RELEASE_DIR"

    if [ -L "$ARCHIVE_PATH" ]; then
        fail "Final archive path must not be a symbolic link: $ARCHIVE_PATH"
    fi
    if [ -e "$ARCHIVE_PATH" ] && [ ! -f "$ARCHIVE_PATH" ]; then
        fail "Final archive path is not a regular file: $ARCHIVE_PATH"
    fi

    if [ -f "$ARCHIVE_PATH" ]; then
        verify_archive "$ARCHIVE_PATH"
        printf 'Verified cached AosVM archive.\n'
        printf 'Path: %s\n' "$ARCHIVE_PATH"
        printf 'Size: %s bytes\n' "$ASSET_SIZE"
        printf 'SHA-256: %s\n' "$ASSET_SHA256"
        return
    fi

    if [ -L "$PARTIAL_PATH" ]; then
        fail "Partial archive path must not be a symbolic link: $PARTIAL_PATH"
    fi
    if [ -e "$PARTIAL_PATH" ] && [ ! -f "$PARTIAL_PATH" ]; then
        fail "Partial archive path is not a regular file: $PARTIAL_PATH"
    fi

    if [ -f "$PARTIAL_PATH" ]; then
        partial_size=$(file_size "$PARTIAL_PATH")
        if [ "$partial_size" -gt "$ASSET_SIZE" ]; then
            fail "Partial archive is larger than the pinned asset: $PARTIAL_PATH"
        fi
        if [ "$partial_size" = "$ASSET_SIZE" ]; then
            verify_archive "$PARTIAL_PATH"
            mv "$PARTIAL_PATH" "$ARCHIVE_PATH"
            printf 'Promoted the complete verified partial archive.\n'
            printf 'Path: %s\n' "$ARCHIVE_PATH"
            printf 'Size: %s bytes\n' "$ASSET_SIZE"
            printf 'SHA-256: %s\n' "$ASSET_SHA256"
            return
        fi
        printf 'Resuming AosVM download at %s of %s bytes.\n' "$partial_size" "$ASSET_SIZE"
    else
        printf 'Downloading pinned AosVM v%s qemuarm64 archive.\n' "$RELEASE"
    fi

    effective_url=$(curl \
        --fail \
        --location \
        --proto '=https' \
        --proto-redir '=https' \
        --retry 5 \
        --retry-all-errors \
        --continue-at - \
        --output "$PARTIAL_PATH" \
        --write-out '%{url_effective}' \
        "$ASSET_URL")

    validate_effective_url "$effective_url"

    verify_archive "$PARTIAL_PATH"
    mv "$PARTIAL_PATH" "$ARCHIVE_PATH"

    printf 'Downloaded and verified AosVM archive.\n'
    printf 'Path: %s\n' "$ARCHIVE_PATH"
    printf 'Size: %s bytes\n' "$ASSET_SIZE"
    printf 'SHA-256: %s\n' "$ASSET_SHA256"
}

prepare_images() {
    require_command awk
    require_command cmp
    require_command jq
    require_command qemu-img
    require_command shasum
    require_command stat
    require_command tar

    [ "$CACHE_ROOT" != "/" ] || fail "Cache root must not be the filesystem root"
    [ "$LOCAL_ROOT" != "/" ] || fail "Local root must not be the filesystem root"

    verify_lifecycle_state

    verify_archive "$ARCHIVE_PATH"
    mkdir -p "$RELEASE_DIR" "$LOCAL_ROOT"

    PREPARE_LOCK_DIR="$RELEASE_DIR/.prepare.lock"
    mkdir "$PREPARE_LOCK_DIR" 2>/dev/null ||
        fail "Another prepare operation may be running: $PREPARE_LOCK_DIR"

    trap prepare_cleanup EXIT HUP INT TERM
    PREPARE_WORK_DIR=$(mktemp -d "$RELEASE_DIR/.prepare.XXXXXX")

    validate_archive_members

    if [ -e "$MAIN_IMAGE_PATH" ] || [ -L "$MAIN_IMAGE_PATH" ] ||
       [ -e "$SECONDARY_IMAGE_PATH" ] || [ -L "$SECONDARY_IMAGE_PATH" ] ||
       [ -e "$FIRMWARE_PATH" ] || [ -L "$FIRMWARE_PATH" ]; then
        verify_release_file "$MAIN_IMAGE_PATH" "$MAIN_IMAGE_SIZE" "$MAIN_IMAGE_SHA256" "Main Node image"
        verify_release_file "$SECONDARY_IMAGE_PATH" "$SECONDARY_IMAGE_SIZE" "$SECONDARY_IMAGE_SHA256" "Secondary Node image"
        verify_release_file "$FIRMWARE_PATH" "$FIRMWARE_SIZE" "$FIRMWARE_SHA256" "QEMU EFI firmware"
    else
        tar -xf "$ARCHIVE_PATH" -C "$PREPARE_WORK_DIR" \
            "$MAIN_IMAGE" "$SECONDARY_IMAGE" "$FIRMWARE"
        verify_archive "$ARCHIVE_PATH"

        verify_release_file "$PREPARE_WORK_DIR/$MAIN_IMAGE" "$MAIN_IMAGE_SIZE" "$MAIN_IMAGE_SHA256" "Main Node image"
        verify_release_file "$PREPARE_WORK_DIR/$SECONDARY_IMAGE" "$SECONDARY_IMAGE_SIZE" "$SECONDARY_IMAGE_SHA256" "Secondary Node image"
        verify_release_file "$PREPARE_WORK_DIR/$FIRMWARE" "$FIRMWARE_SIZE" "$FIRMWARE_SHA256" "QEMU EFI firmware"
        verify_base_image "$PREPARE_WORK_DIR/$MAIN_IMAGE" "Main Node image"
        verify_base_image "$PREPARE_WORK_DIR/$SECONDARY_IMAGE" "Secondary Node image"

        install_prepared_file "$PREPARE_WORK_DIR/$MAIN_IMAGE" "$MAIN_IMAGE_PATH" "$MAIN_IMAGE_SIZE" "$MAIN_IMAGE_SHA256" "Main Node image"
        install_prepared_file "$PREPARE_WORK_DIR/$SECONDARY_IMAGE" "$SECONDARY_IMAGE_PATH" "$SECONDARY_IMAGE_SIZE" "$SECONDARY_IMAGE_SHA256" "Secondary Node image"
        install_prepared_file "$PREPARE_WORK_DIR/$FIRMWARE" "$FIRMWARE_PATH" "$FIRMWARE_SIZE" "$FIRMWARE_SHA256" "QEMU EFI firmware"
    fi

    chmod 0444 "$ARCHIVE_PATH"
    chmod 0444 "$MAIN_IMAGE_PATH" "$SECONDARY_IMAGE_PATH" "$FIRMWARE_PATH"

    verify_base_image "$MAIN_IMAGE_PATH" "Main Node image"
    verify_base_image "$SECONDARY_IMAGE_PATH" "Secondary Node image"

    if [ -L "$OVERLAY_PATH" ]; then
        fail "Overlay path must not be a symbolic link: $OVERLAY_PATH"
    fi

    if [ -e "$OVERLAY_PATH" ]; then
        verify_overlay "$OVERLAY_PATH"
    else
        overlay_partial_path="$PREPARE_WORK_DIR/$OVERLAY"
        absolute_main_image_path=$(absolute_path "$MAIN_IMAGE_PATH")
        qemu-img create -q -f qcow2 -b "$absolute_main_image_path" -B qcow2 "$overlay_partial_path"
        chmod 0600 "$overlay_partial_path"
        verify_overlay "$overlay_partial_path"
        mv "$overlay_partial_path" "$OVERLAY_PATH"
    fi

    chmod 0600 "$OVERLAY_PATH"
    verify_overlay "$OVERLAY_PATH"

    printf 'Prepared verified immutable AosVM inputs and writable overlay.\n'
    printf 'Main image: %s\n' "$MAIN_IMAGE_PATH"
    printf 'Secondary image: %s\n' "$SECONDARY_IMAGE_PATH"
    printf 'Firmware: %s\n' "$FIRMWARE_PATH"
    printf 'Overlay: %s\n' "$OVERLAY_PATH"
}

ensure_private_directory() {
    private_directory=$1
    private_directory_label=$2

    [ "$private_directory" != "/" ] ||
        fail "$private_directory_label must not be the filesystem root"
    [ ! -L "$private_directory" ] ||
        fail "$private_directory_label must not be a symbolic link: $private_directory"

    if [ -e "$private_directory" ]; then
        [ -d "$private_directory" ] ||
            fail "$private_directory_label is not a directory: $private_directory"
        [ "$(file_mode "$private_directory")" = "700" ] ||
            fail "$private_directory_label mode must be 0700: $private_directory"
    else
        mkdir -p "$private_directory"
        chmod 0700 "$private_directory"
    fi
}

validate_socket_path() {
    socket_path=$1
    socket_label=$2
    socket_path_length=$(printf '%s' "$socket_path" | wc -c | tr -d ' ')

    [ "$socket_path_length" -le 100 ] ||
        fail "$socket_label exceeds the safe macOS Unix socket path length: $socket_path"
}

ensure_lifecycle_directories() {
    ensure_private_directory "$RUN_ROOT" "Runtime directory"
    ensure_private_directory "$RUNS_ROOT" "Run-log directory"
}

release_lifecycle_lock() {
    if [ "$LIFECYCLE_LOCK_HELD" -eq 1 ]; then
        rmdir "$LIFECYCLE_LOCK_DIR" >/dev/null 2>&1 || true
        LIFECYCLE_LOCK_HELD=0
    fi
}

acquire_lifecycle_lock() {
    ensure_lifecycle_directories
    [ ! -L "$LIFECYCLE_LOCK_DIR" ] ||
        fail "Lifecycle lock must not be a symbolic link: $LIFECYCLE_LOCK_DIR"
    mkdir "$LIFECYCLE_LOCK_DIR" 2>/dev/null ||
        fail "Another AosVM lifecycle operation is running: $LIFECYCLE_LOCK_DIR"
    chmod 0700 "$LIFECYCLE_LOCK_DIR"
    LIFECYCLE_LOCK_HELD=1
    trap release_lifecycle_lock EXIT HUP INT TERM
}

cleanup_background_start() {
    trap - EXIT HUP INT TERM
    if [ -n "$BACKGROUND_START_PID" ] &&
       kill -0 "$BACKGROUND_START_PID" 2>/dev/null; then
        background_start_command=$(process_command "$BACKGROUND_START_PID" || true)
        case "$background_start_command" in
            "/bin/sh $SCRIPT_PATH _supervise normal"|\
            "/bin/sh $SCRIPT_PATH _supervise provisioning")
                kill -TERM "$BACKGROUND_START_PID" >/dev/null 2>&1 || true
                wait "$BACKGROUND_START_PID" 2>/dev/null || true
                ;;
        esac
    fi
    if [ -n "$BACKGROUND_START_PID" ] && [ -f "$SUPERVISOR_PID_PATH" ] &&
       [ "$(sed -n '1p' "$SUPERVISOR_PID_PATH")" = "$BACKGROUND_START_PID" ]; then
        rm -f "$SUPERVISOR_PID_PATH"
    fi
    release_lifecycle_lock
}

read_pid_file() {
    pid_file=$1
    pid_label=$2

    [ ! -L "$pid_file" ] || fail "$pid_label must not be a symbolic link: $pid_file"
    [ -f "$pid_file" ] || fail "$pid_label does not exist: $pid_file"
    [ "$(file_mode "$pid_file")" = "600" ] ||
        fail "$pid_label mode must be 0600: $pid_file"
    pid_value=$(sed -n '1p' "$pid_file")
    [ "$(wc -l <"$pid_file" | tr -d ' ')" -eq 1 ] ||
        fail "$pid_label must contain exactly one line"
    case "$pid_value" in
        ''|*[!0-9]*) fail "$pid_label is not a decimal PID" ;;
    esac
    [ "$pid_value" -gt 1 ] || fail "$pid_label contains an unsafe PID"
    printf '%s\n' "$pid_value"
}

process_command() {
    process_pid=$1
    ps -p "$process_pid" -o command= 2>/dev/null
}

process_parent_pid() {
    process_pid=$1
    ps -p "$process_pid" -o ppid= 2>/dev/null | tr -d ' '
}

process_working_directory() {
    process_pid=$1
    lsof -nP -a -p "$process_pid" -d cwd -F n 2>/dev/null |
        sed -n 's/^n//p'
}

verify_owned_qemu_pid() {
    owned_qemu_pid=$1
    [ -d "$LOCAL_ROOT" ] || fail "Local VM directory is unavailable: $LOCAL_ROOT"
    [ -f "$OVERLAY_PATH" ] || fail "Overlay is unavailable: $OVERLAY_PATH"
    expected_overlay=$(absolute_path "$OVERLAY_PATH")
    expected_qmp=$(absolute_path "$QMP_SOCKET_PATH")
    expected_serial=$(absolute_path "$SERIAL_SOCKET_PATH")
    expected_pid_file=$(absolute_path "$PID_PATH")
    owned_qemu_command=$(process_command "$owned_qemu_pid") ||
        fail "QEMU PID is not running: $owned_qemu_pid"

    case "$owned_qemu_command" in
        "$QEMU_SYSTEM_PATH -name $VM_NAME "*) ;;
        *) fail "PID $owned_qemu_pid is not the owned AosVM QEMU process" ;;
    esac
    case "$owned_qemu_command" in
        *"-machine $QEMU_MACHINE,accel=hvf"*) ;;
        *) fail "Owned QEMU PID does not use the qualified machine and HVF" ;;
    esac
    case "$owned_qemu_command" in
        *"file=$expected_overlay,if=none,id=aos-image,format=qcow2"*) ;;
        *) fail "Owned QEMU PID does not use the expected overlay" ;;
    esac
    case "$owned_qemu_command" in
        *"-qmp unix:$expected_qmp,server=on,wait=off"*) ;;
        *) fail "Owned QEMU PID does not use the expected QMP socket" ;;
    esac
    case "$owned_qemu_command" in
        *"-chardev socket,id=serial0,path=$expected_serial,server=on,wait=off,"*) ;;
        *) fail "Owned QEMU PID does not use the expected serial socket" ;;
    esac
    case "$owned_qemu_command" in
        *"-pidfile $expected_pid_file"*) ;;
        *) fail "Owned QEMU PID does not own the expected PID file" ;;
    esac
    owned_network_mode=$(qemu_network_mode "$owned_qemu_pid")
    [ "$owned_network_mode" = normal ] ||
        [ "$owned_network_mode" = provisioning ] ||
        fail "Owned QEMU PID has an unknown network mode"
}

network_option_for_mode() {
    network_mode=$1
    network_option_value="user,id=aosnet,net=$GUEST_NETWORK,host=$GUEST_VISIBLE_HOST,dns=$GUEST_DNS_PROXY,restrict=off,hostfwd=tcp:127.0.0.1:$SSH_HOST_PORT-$GUEST_ADDRESS:$GUEST_SSH_PORT"
    case "$network_mode" in
        normal) ;;
        provisioning)
            network_option_value="$network_option_value,hostfwd=tcp:$PROVISIONING_HOST_ADDRESS:$PROVISIONING_HOST_PORT-$GUEST_ADDRESS:$GUEST_PROVISIONING_PORT"
            ;;
        *) fail "Unknown AosVM network mode: $network_mode" ;;
    esac
    printf '%s\n' "$network_option_value"
}

qemu_network_mode() {
    network_qemu_pid=$1
    network_qemu_command=$(process_command "$network_qemu_pid") ||
        fail "QEMU PID is not running: $network_qemu_pid"
    normal_network_option=$(network_option_for_mode normal)
    provisioning_network_option=$(network_option_for_mode provisioning)
    network_device_option="virtio-net-pci,netdev=aosnet,mac=$VM_MAC_ADDRESS"

    case "$network_qemu_command" in
        *"-netdev $provisioning_network_option -device $network_device_option"*)
            printf 'provisioning\n'
            ;;
        *"-netdev $normal_network_option -device $network_device_option"*)
            printf 'normal\n'
            ;;
        *) fail "Owned QEMU PID does not use an accepted network contract" ;;
    esac
}

verify_supervisor_pid() {
    supervisor_pid=$1
    supervised_qemu_pid=$2
    supervisor_command=$(process_command "$supervisor_pid") ||
        fail "Supervisor PID is not running: $supervisor_pid"
    supervised_network_mode=$(qemu_network_mode "$supervised_qemu_pid")
    case "$supervisor_command" in
        "/bin/sh $SCRIPT_PATH _supervise $supervised_network_mode") ;;
        "/bin/sh $SCRIPT_PATH start --foreground")
            [ "$supervised_network_mode" = normal ] ||
                fail "Foreground normal supervisor owns a provisioning QEMU process"
            ;;
        "/bin/sh $SCRIPT_PATH start-provisioning --foreground")
            [ "$supervised_network_mode" = provisioning ] ||
                fail "Foreground provisioning supervisor owns a non-provisioning QEMU process"
            ;;
        "/bin/sh ./scripts/aosvm start --foreground"|\
        "/bin/sh ./scripts/aosvm start-provisioning --foreground")
            supervisor_cwd=$(process_working_directory "$supervisor_pid") ||
                fail "Cannot resolve the foreground supervisor directory"
            [ "$supervisor_cwd" = "$REPOSITORY_ROOT" ] ||
                fail "Foreground supervisor does not run from this repository"
            case "$supervisor_command:$supervised_network_mode" in
                "/bin/sh ./scripts/aosvm start --foreground:normal"|\
                "/bin/sh ./scripts/aosvm start-provisioning --foreground:provisioning") ;;
                *) fail "Foreground supervisor mode does not match the QEMU network mode" ;;
            esac
            ;;
        *) fail "PID $supervisor_pid is not the owned AosVM supervisor" ;;
    esac
    qemu_parent_pid=$(process_parent_pid "$supervised_qemu_pid") ||
        fail "Cannot resolve the QEMU parent PID"
    [ "$qemu_parent_pid" = "$supervisor_pid" ] ||
        fail "Owned QEMU is not a child of the recorded supervisor"
}

resolve_running_vm() {
    qualify_qemu_for_start
    qemu_pid=$(read_pid_file "$PID_PATH" "QEMU PID file")
    verify_owned_qemu_pid "$qemu_pid"
    printf '%s\n' "$qemu_pid"
}

qmp_command() {
    qmp_action=$1
    [ ! -L "$QMP_SOCKET_PATH" ] && [ -S "$QMP_SOCKET_PATH" ] ||
        fail "The owned QMP socket is unavailable: $QMP_SOCKET_PATH"
    [ ! -L "$QMP_HELPER" ] && [ -f "$QMP_HELPER" ] && [ -x "$QMP_HELPER" ] ||
        fail "The tracked QMP helper is unavailable: $QMP_HELPER"
    "$QMP_HELPER" "$QMP_SOCKET_PATH" "$qmp_action"
}

wait_for_process_exit() {
    wait_pid=$1
    wait_seconds=$2
    wait_elapsed=0
    while kill -0 "$wait_pid" 2>/dev/null; do
        [ "$wait_elapsed" -lt "$wait_seconds" ] || return 1
        sleep 1
        wait_elapsed=$((wait_elapsed + 1))
        if [ $((wait_elapsed % 10)) -eq 0 ]; then
            printf 'Still waiting for PID %s to exit (%s seconds).\n' \
                "$wait_pid" "$wait_elapsed"
        fi
    done
    return 0
}

validate_lifecycle_timeouts() {
    validate_decimal_range "$START_TIMEOUT_SECONDS" 1 300 "Start timeout"
    validate_decimal_range "$STOP_TIMEOUT_SECONDS" 1 600 "Stop timeout"
    validate_decimal_range "$TERM_TIMEOUT_SECONDS" 1 120 "Termination timeout"
    validate_decimal_range "$SMOKE_TIMEOUT_SECONDS" 1 600 "Smoke timeout"
}

validate_runtime_state() {
    runtime_network_mode=$1
    require_command lsof
    require_command tr
    require_command wc

    validate_decimal_range "$SSH_HOST_PORT" 1024 65535 "SSH host port"
    validate_decimal_range "$HOST_DNS_PORT" 1024 65535 "Host DNS port"
    [ "$HOST_DNS_PORT" -ne "$SSH_HOST_PORT" ] ||
        fail "Host DNS and SSH ports must differ"
    case "$runtime_network_mode" in
        normal) ;;
        provisioning)
            validate_decimal_range "$PROVISIONING_HOST_PORT" 1024 65535 \
                "Provisioning host port"
            [ "$PROVISIONING_HOST_PORT" -ne "$SSH_HOST_PORT" ] &&
                [ "$PROVISIONING_HOST_PORT" -ne "$HOST_DNS_PORT" ] ||
                fail "Provisioning, SSH, and DNS host ports must differ"
            ;;
        *) fail "Unknown AosVM network mode: $runtime_network_mode" ;;
    esac

    ensure_lifecycle_directories

    validate_socket_path "$QMP_SOCKET_PATH" "QMP socket path"
    validate_socket_path "$SERIAL_SOCKET_PATH" "Serial socket path"

    for runtime_path in \
        "$PID_PATH" "$QMP_SOCKET_PATH" "$SERIAL_SOCKET_PATH" \
        "$DNS_BRIDGE_PID_PATH"; do
        [ ! -e "$runtime_path" ] && [ ! -L "$runtime_path" ] ||
            fail "Runtime path already exists: $runtime_path"
    done
    if [ "$SUPERVISOR_MODE" -eq 1 ]; then
        supervisor_pid=$(read_pid_file "$SUPERVISOR_PID_PATH" \
            "Supervisor PID file")
        [ "$supervisor_pid" -eq "$$" ] ||
            fail "Supervisor PID file does not belong to the current supervisor"
    else
        [ ! -e "$SUPERVISOR_PID_PATH" ] && [ ! -L "$SUPERVISOR_PID_PATH" ] ||
            fail "Runtime path already exists: $SUPERVISOR_PID_PATH"
    fi

    [ ! -L "$SERIAL_LOG_PATH" ] ||
        fail "Serial log path must not be a symbolic link: $SERIAL_LOG_PATH"
    if [ -e "$SERIAL_LOG_PATH" ] && [ ! -f "$SERIAL_LOG_PATH" ]; then
        fail "Serial log path is not a regular file: $SERIAL_LOG_PATH"
    fi
    if [ -f "$SERIAL_LOG_PATH" ] && [ "$(file_mode "$SERIAL_LOG_PATH")" != "600" ]; then
        fail "Existing serial log mode must be 0600: $SERIAL_LOG_PATH"
    fi
    [ ! -L "$DNS_BRIDGE_LOG_PATH" ] ||
        fail "DNS bridge log path must not be a symbolic link: $DNS_BRIDGE_LOG_PATH"
    if [ -e "$DNS_BRIDGE_LOG_PATH" ] && [ ! -f "$DNS_BRIDGE_LOG_PATH" ]; then
        fail "DNS bridge log path is not a regular file: $DNS_BRIDGE_LOG_PATH"
    fi
    if [ -f "$DNS_BRIDGE_LOG_PATH" ] && [ "$(file_mode "$DNS_BRIDGE_LOG_PATH")" != "600" ]; then
        fail "Existing DNS bridge log mode must be 0600: $DNS_BRIDGE_LOG_PATH"
    fi
    [ ! -L "$SUPERVISOR_LOG_PATH" ] ||
        fail "Supervisor log path must not be a symbolic link: $SUPERVISOR_LOG_PATH"
    if [ -e "$SUPERVISOR_LOG_PATH" ] && [ ! -f "$SUPERVISOR_LOG_PATH" ]; then
        fail "Supervisor log path is not a regular file: $SUPERVISOR_LOG_PATH"
    fi
    if [ -f "$SUPERVISOR_LOG_PATH" ] && [ "$(file_mode "$SUPERVISOR_LOG_PATH")" != "600" ]; then
        fail "Existing supervisor log mode must be 0600: $SUPERVISOR_LOG_PATH"
    fi
    [ ! -L "$DNS_BRIDGE_SCRIPT" ] && [ -f "$DNS_BRIDGE_SCRIPT" ] &&
        [ -x "$DNS_BRIDGE_SCRIPT" ] ||
        fail "The tracked DNS bridge is unavailable or not executable: $DNS_BRIDGE_SCRIPT"

    if lsof -nP -iTCP:"$SSH_HOST_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
        fail "SSH host port is already in use: 127.0.0.1:$SSH_HOST_PORT"
    fi
    if lsof -nP -iTCP:"$HOST_DNS_PORT" -sTCP:LISTEN >/dev/null 2>&1 ||
       lsof -nP -iUDP:"$HOST_DNS_PORT" >/dev/null 2>&1; then
        fail "Host DNS port is already in use: $HOST_DNS_ADDRESS:$HOST_DNS_PORT"
    fi
    if [ "$runtime_network_mode" = provisioning ] &&
       lsof -nP -iTCP:"$PROVISIONING_HOST_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
        fail "Provisioning host port is already in use: $PROVISIONING_HOST_ADDRESS:$PROVISIONING_HOST_PORT"
    fi
}

cleanup_foreground_children() {
    trap - EXIT HUP INT TERM
    if [ -n "$QEMU_CHILD_PID" ] && kill -0 "$QEMU_CHILD_PID" 2>/dev/null; then
        kill "$QEMU_CHILD_PID" >/dev/null 2>&1 || true
        wait "$QEMU_CHILD_PID" 2>/dev/null || true
    fi
    if [ -n "$DNS_BRIDGE_PID" ] && kill -0 "$DNS_BRIDGE_PID" 2>/dev/null; then
        kill "$DNS_BRIDGE_PID" >/dev/null 2>&1 || true
        wait "$DNS_BRIDGE_PID" 2>/dev/null || true
    fi
    rm -f "$DNS_BRIDGE_PID_PATH"
    if [ "$SUPERVISOR_MODE" -eq 1 ] && [ -f "$SUPERVISOR_PID_PATH" ]; then
        supervisor_cleanup_pid=$(sed -n '1p' "$SUPERVISOR_PID_PATH")
        if [ "$supervisor_cleanup_pid" = "$$" ]; then
            rm -f "$SUPERVISOR_PID_PATH"
        fi
    fi
    release_lifecycle_lock
}

start_dns_bridge() {
    : >"$DNS_BRIDGE_LOG_PATH"
    chmod 0600 "$DNS_BRIDGE_LOG_PATH"
    "$DNS_BRIDGE_SCRIPT" \
        --listen-address "$HOST_DNS_ADDRESS" \
        --listen-port "$HOST_DNS_PORT" \
        >>"$DNS_BRIDGE_LOG_PATH" 2>&1 &
    DNS_BRIDGE_PID=$!
    printf '%s\n' "$DNS_BRIDGE_PID" >"$DNS_BRIDGE_PID_PATH"
    chmod 0600 "$DNS_BRIDGE_PID_PATH"

    dns_attempt=0
    while ! lsof -nP -a -p "$DNS_BRIDGE_PID" \
        -iUDP@"$HOST_DNS_ADDRESS":"$HOST_DNS_PORT" >/dev/null 2>&1; do
        if ! kill -0 "$DNS_BRIDGE_PID" 2>/dev/null; then
            wait "$DNS_BRIDGE_PID" 2>/dev/null || true
            DNS_BRIDGE_PID=''
            fail "The loopback DNS bridge failed to start; see $DNS_BRIDGE_LOG_PATH"
        fi
        dns_attempt=$((dns_attempt + 1))
        [ "$dns_attempt" -lt 100 ] ||
            fail "The loopback DNS bridge did not become ready"
        sleep 0.1
    done
}

verify_start_inputs() {
    require_command jq
    require_command qemu-img
    require_command shasum
    require_command stat

    verify_archive "$ARCHIVE_PATH"
    verify_release_file "$MAIN_IMAGE_PATH" "$MAIN_IMAGE_SIZE" "$MAIN_IMAGE_SHA256" "Main Node image"
    verify_release_file "$SECONDARY_IMAGE_PATH" "$SECONDARY_IMAGE_SIZE" "$SECONDARY_IMAGE_SHA256" "Secondary Node image"
    verify_release_file "$FIRMWARE_PATH" "$FIRMWARE_SIZE" "$FIRMWARE_SHA256" "QEMU EFI firmware"

    [ "$(file_mode "$ARCHIVE_PATH")" = "444" ] ||
        fail "Archive mode must be 0444"
    [ "$(file_mode "$MAIN_IMAGE_PATH")" = "444" ] ||
        fail "Main Node image mode must be 0444"
    [ "$(file_mode "$SECONDARY_IMAGE_PATH")" = "444" ] ||
        fail "Secondary Node image mode must be 0444"
    [ "$(file_mode "$FIRMWARE_PATH")" = "444" ] ||
        fail "QEMU EFI firmware mode must be 0444"

    verify_base_image "$MAIN_IMAGE_PATH" "Main Node image"
    verify_base_image "$SECONDARY_IMAGE_PATH" "Secondary Node image"
    verify_overlay "$OVERLAY_PATH"
    [ "$(file_mode "$OVERLAY_PATH")" = "600" ] ||
        fail "Overlay mode must be 0600"
    verify_lifecycle_state
}

qualify_qemu_for_start() {
    require_command file
    require_command grep
    require_command qemu-system-aarch64
    require_command sed

    QEMU_SYSTEM_PATH=$(command -v qemu-system-aarch64)
    case "$QEMU_SYSTEM_PATH" in
        /*) ;;
        *) fail "qemu-system-aarch64 did not resolve to an absolute path" ;;
    esac

    file "$QEMU_SYSTEM_PATH" | grep -q 'Mach-O 64-bit executable arm64' ||
        fail "qemu-system-aarch64 is not a native macOS ARM64 executable"

    qemu_version_line=$($QEMU_SYSTEM_PATH --version | sed -n '1p')
    QEMU_SYSTEM_VERSION=${qemu_version_line#QEMU emulator version }
    [ "$QEMU_SYSTEM_VERSION" != "$qemu_version_line" ] ||
        fail "Cannot parse the QEMU version"
    case " $QEMU_QUALIFIED_VERSIONS " in
        *" $QEMU_SYSTEM_VERSION "*) ;;
        *) fail "QEMU version $QEMU_SYSTEM_VERSION is not qualified; supported versions: $QEMU_QUALIFIED_VERSIONS" ;;
    esac

    $QEMU_SYSTEM_PATH -accel help | grep -qx 'hvf' ||
        fail "QEMU does not provide the HVF accelerator"
    $QEMU_SYSTEM_PATH -machine help | grep -Eq "^${QEMU_MACHINE}[[:space:]]" ||
        fail "QEMU does not provide the qualified machine $QEMU_MACHINE"
    $QEMU_SYSTEM_PATH -cpu help | grep -Eq '^[[:space:]]+host$' ||
        fail "QEMU does not provide the host ARM CPU model"

    qemu_device_list=$($QEMU_SYSTEM_PATH -machine "$QEMU_MACHINE" -device help)
    printf '%s\n' "$qemu_device_list" | grep -q 'name "virtio-scsi-pci"' ||
        fail "QEMU does not provide virtio-scsi-pci"
    printf '%s\n' "$qemu_device_list" | grep -q 'name "scsi-hd"' ||
        fail "QEMU does not provide scsi-hd"
    printf '%s\n' "$qemu_device_list" | grep -q 'name "virtio-net-pci"' ||
        fail "QEMU does not provide virtio-net-pci"
}

host_check() {
    require_command df
    require_command lsof
    require_command sysctl
    require_command uname

    [ "$(uname -s)" = Darwin ] || fail "The host operating system is not macOS"
    [ "$(uname -m)" = arm64 ] || fail "The host architecture is not ARM64"
    [ "$(sysctl -n kern.hv_support)" = 1 ] ||
        fail "Apple Hypervisor Framework is unavailable"
    validate_decimal_range "$SSH_HOST_PORT" 1024 65535 "SSH host port"
    validate_decimal_range "$HOST_DNS_PORT" 1024 65535 "Host DNS port"
    validate_decimal_range "$PROVISIONING_HOST_PORT" 1024 65535 \
        "Provisioning host port"
    [ "$SSH_HOST_PORT" -ne "$HOST_DNS_PORT" ] &&
        [ "$SSH_HOST_PORT" -ne "$PROVISIONING_HOST_PORT" ] &&
        [ "$HOST_DNS_PORT" -ne "$PROVISIONING_HOST_PORT" ] ||
        fail "Provisioning, SSH, and DNS host ports must differ"
    host_memory_bytes=$(sysctl -n hw.memsize)
    [ "$host_memory_bytes" -ge "$MINIMUM_HOST_MEMORY_BYTES" ] ||
        fail "Host memory is below the 4 GiB minimum"
    host_free_kib=$(df -Pk "$REPOSITORY_ROOT" | awk 'NR == 2 { print $4 }')
    [ "$host_free_kib" -ge "$MINIMUM_HOST_FREE_KIB" ] ||
        fail "Free disk at the repository is below the 20 GiB minimum"

    qualify_qemu_for_start
    if lsof -nP -iTCP:"$SSH_HOST_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
        fail "SSH host port is already in use: 127.0.0.1:$SSH_HOST_PORT"
    fi
    if lsof -nP -iTCP:"$HOST_DNS_PORT" -sTCP:LISTEN >/dev/null 2>&1 ||
       lsof -nP -iUDP:"$HOST_DNS_PORT" >/dev/null 2>&1; then
        fail "Host DNS port is already in use: $HOST_DNS_ADDRESS:$HOST_DNS_PORT"
    fi
    if lsof -nP -iTCP:"$PROVISIONING_HOST_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
        fail "Provisioning host port is already in use: $PROVISIONING_HOST_ADDRESS:$PROVISIONING_HOST_PORT"
    fi

    printf 'AosVM host qualification passed.\n'
    printf 'Host: macOS ARM64 with Hypervisor Framework\n'
    printf 'Memory: %s bytes\n' "$host_memory_bytes"
    printf 'Free disk: %s KiB\n' "$host_free_kib"
    printf 'QEMU: %s %s\n' "$QEMU_SYSTEM_PATH" "$QEMU_SYSTEM_VERSION"
    printf 'Normal listeners: 127.0.0.1:%s (SSH), 127.0.0.1:%s (DNS)\n' \
        "$SSH_HOST_PORT" "$HOST_DNS_PORT"
    printf 'Provisioning-only listener: 127.0.0.1:%s (IAM)\n' \
        "$PROVISIONING_HOST_PORT"
}

validate_qemu_option_paths() {
    for qemu_option_path in \
        "$FIRMWARE_PATH" "$OVERLAY_PATH" "$PID_PATH" "$QMP_SOCKET_PATH" \
        "$SERIAL_SOCKET_PATH" "$SERIAL_LOG_PATH" "$DNS_BRIDGE_LOG_PATH"; do
        case "$qemu_option_path" in
            *,*) fail "QEMU option paths must not contain commas: $qemu_option_path" ;;
        esac
    done
}

shell_quote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

print_command() {
    printf 'QEMU command (dry run; not executed):\n'
    command_separator=''
    for command_argument in "$@"; do
        printf '%s' "$command_separator"
        shell_quote "$command_argument"
        command_separator=' \
  '
    done
    printf '\n'
}

start_vm() {
    start_mode=$1
    start_network_mode=$2

    validate_lifecycle_timeouts
    validate_runtime_state "$start_network_mode"
    if [ "$start_network_mode" = provisioning ] && [ "$start_mode" != dry-run ]; then
        verify_lifecycle_state
        [ "$LIFECYCLE_STATUS" = provisioning-locked ] ||
            fail "Provisioning mode requires a verified pre-provision checkpoint and provisioning-locked lifecycle"
    fi
    verify_start_inputs
    qualify_qemu_for_start
    validate_qemu_option_paths

    absolute_overlay_path=$(absolute_path "$OVERLAY_PATH")
    absolute_firmware_path=$(absolute_path "$FIRMWARE_PATH")
    absolute_pid_path=$(absolute_path "$PID_PATH")
    absolute_qmp_socket_path=$(absolute_path "$QMP_SOCKET_PATH")
    absolute_serial_socket_path=$(absolute_path "$SERIAL_SOCKET_PATH")
    absolute_serial_log_path=$(absolute_path "$SERIAL_LOG_PATH")

    drive_option="file=$absolute_overlay_path,if=none,id=aos-image,format=qcow2,cache=writeback"
    network_option=$(network_option_for_mode "$start_network_mode")
    network_device_option="virtio-net-pci,netdev=aosnet,mac=$VM_MAC_ADDRESS"
    qmp_option="unix:$absolute_qmp_socket_path,server=on,wait=off"
    serial_chardev_option="socket,id=serial0,path=$absolute_serial_socket_path,server=on,wait=off,logfile=$absolute_serial_log_path,logappend=on,logtimestamp=on"

    set -- \
        "$QEMU_SYSTEM_PATH" \
        -name "$VM_NAME" \
        -machine "$QEMU_MACHINE,accel=hvf" \
        -cpu "$QEMU_CPU" \
        -smp "$QEMU_VCPUS" \
        -m "$QEMU_MEMORY_MIB" \
        -nodefaults \
        -bios "$absolute_firmware_path" \
        -drive "$drive_option" \
        -device 'virtio-scsi-pci,id=scsi' \
        -device 'scsi-hd,drive=aos-image,bootindex=0' \
        -netdev "$network_option" \
        -device "$network_device_option" \
        -chardev "$serial_chardev_option" \
        -serial 'chardev:serial0' \
        -qmp "$qmp_option" \
        -pidfile "$absolute_pid_path" \
        -monitor none \
        -display none

    case "$start_mode" in
        dry-run)
            print_command "$@"
            ;;
        foreground)
            trap cleanup_foreground_children EXIT
            if [ "$SUPERVISOR_MODE" -eq 1 ]; then
                # nohup intentionally makes the detached supervisor immune to
                # a controlling shell hangup. Preserve that contract here.
                trap '' HUP
            else
                trap 'cleanup_foreground_children; exit 129' HUP
            fi
            trap 'cleanup_foreground_children; exit 130' INT
            trap 'cleanup_foreground_children; exit 143' TERM
            start_dns_bridge
            printf 'Starting AosVM Main Node in %s mode in the foreground.\n' \
                "$start_network_mode"
            printf 'Serial log: %s\n' "$absolute_serial_log_path"
            printf 'QMP socket: %s\n' "$absolute_qmp_socket_path"
            printf 'Loopback DNS bridge: %s:%s\n' \
                "$HOST_DNS_ADDRESS" "$HOST_DNS_PORT"
            "$@" &
            QEMU_CHILD_PID=$!
            qemu_status=0
            wait "$QEMU_CHILD_PID" || qemu_status=$?
            QEMU_CHILD_PID=''
            cleanup_foreground_children
            return "$qemu_status"
            ;;
        *)
            fail "Unknown start mode: $start_mode"
            ;;
    esac
}

start_background() {
    start_network_mode=$1
    acquire_lifecycle_lock
    validate_lifecycle_timeouts
    if [ -e "$PID_PATH" ] || [ -L "$PID_PATH" ]; then
        vm_status
        running_qemu_pid=$(resolve_running_vm)
        running_network_mode=$(qemu_network_mode "$running_qemu_pid")
        [ "$running_network_mode" = "$start_network_mode" ] ||
            fail "AosVM is already running in $running_network_mode mode; stop it before requesting $start_network_mode mode"
        release_lifecycle_lock
        trap - EXIT HUP INT TERM
        printf 'AosVM Main Node is already running.\n'
        return
    fi
    validate_runtime_state "$start_network_mode"
    if [ "$start_network_mode" = provisioning ]; then
        verify_lifecycle_state
        [ "$LIFECYCLE_STATUS" = provisioning-locked ] ||
            fail "Provisioning mode requires a verified pre-provision checkpoint and provisioning-locked lifecycle"
    fi
    verify_start_inputs
    qualify_qemu_for_start

    : >"$SUPERVISOR_LOG_PATH"
    chmod 0600 "$SUPERVISOR_LOG_PATH"
    nohup "$SCRIPT_PATH" _supervise "$start_network_mode" \
        >>"$SUPERVISOR_LOG_PATH" 2>&1 </dev/null &
    supervisor_pid=$!
    BACKGROUND_START_PID=$supervisor_pid
    trap cleanup_background_start EXIT HUP INT TERM
    printf '%s\n' "$supervisor_pid" >"$SUPERVISOR_PID_PATH"
    chmod 0600 "$SUPERVISOR_PID_PATH"

    start_elapsed=0
    while [ "$start_elapsed" -lt "$START_TIMEOUT_SECONDS" ]; do
        if [ -f "$PID_PATH" ] && [ -S "$QMP_SOCKET_PATH" ]; then
            qemu_pid=$(read_pid_file "$PID_PATH" "QEMU PID file")
            verify_owned_qemu_pid "$qemu_pid"
            supervisor_pid_check=$(read_pid_file "$SUPERVISOR_PID_PATH" \
                "Supervisor PID file")
            verify_supervisor_pid "$supervisor_pid_check" "$qemu_pid"
            qmp_status=$(qmp_command query-status)
            printf '%s\n' "$qmp_status" | grep -Fq '"status":"running"' ||
                fail "QEMU did not report running state"
            release_lifecycle_lock
            trap - EXIT HUP INT TERM
            BACKGROUND_START_PID=''
            printf 'Started AosVM Main Node in %s mode in the background.\n' \
                "$start_network_mode"
            printf 'QEMU PID: %s\n' "$qemu_pid"
            printf 'Supervisor PID: %s\n' "$supervisor_pid"
            printf 'Serial log: %s\n' "$SERIAL_LOG_PATH"
            return
        fi
        if ! kill -0 "$supervisor_pid" 2>/dev/null; then
            rm -f "$SUPERVISOR_PID_PATH"
            fail "AosVM supervisor exited during startup; see $SUPERVISOR_LOG_PATH"
        fi
        sleep 1
        start_elapsed=$((start_elapsed + 1))
    done

    fail "AosVM did not become ready within $START_TIMEOUT_SECONDS seconds"
}

reset_overlay() {
    reset_confirmation=$1
    [ "$reset_confirmation" = --confirm ] ||
        fail "Reset requires the explicit --confirm option"
    require_command jq
    acquire_lifecycle_lock
    verify_lifecycle_state
    [ "$LIFECYCLE_STATUS" = unprotected ] ||
        fail "Overlay reset is disabled while lifecycle state is $LIFECYCLE_STATUS; reconcile the Unit with AosCloud before any recovery action"
    if [ -e "$PID_PATH" ] || [ -L "$PID_PATH" ] ||
       [ -e "$QMP_SOCKET_PATH" ] || [ -L "$QMP_SOCKET_PATH" ] ||
       [ -e "$SERIAL_SOCKET_PATH" ] || [ -L "$SERIAL_SOCKET_PATH" ] ||
       [ -e "$DNS_BRIDGE_PID_PATH" ] || [ -L "$DNS_BRIDGE_PID_PATH" ] ||
       [ -e "$SUPERVISOR_PID_PATH" ] || [ -L "$SUPERVISOR_PID_PATH" ]; then
        fail "Reset is allowed only when the VM has no runtime state"
    fi
    require_command qemu-img
    verify_release_file "$MAIN_IMAGE_PATH" "$MAIN_IMAGE_SIZE" \
        "$MAIN_IMAGE_SHA256" "Main Node image"
    verify_base_image "$MAIN_IMAGE_PATH" "Main Node image"
    verify_overlay "$OVERLAY_PATH"
    [ "$(file_mode "$OVERLAY_PATH")" = 600 ] || fail "Overlay mode must be 0600"

    reset_work_dir=$(mktemp -d "$LOCAL_ROOT/.reset-overlay.XXXXXX")
    reset_new_overlay="$reset_work_dir/$OVERLAY"
    reset_old_overlay="$reset_work_dir/$OVERLAY.old"
    absolute_main_image_path=$(absolute_path "$MAIN_IMAGE_PATH")
    qemu-img create -q -f qcow2 -b "$absolute_main_image_path" -B qcow2 \
        "$reset_new_overlay"
    chmod 0600 "$reset_new_overlay"
    verify_overlay "$reset_new_overlay"
    mv "$OVERLAY_PATH" "$reset_old_overlay"
    if mv "$reset_new_overlay" "$OVERLAY_PATH"; then
        rm "$reset_old_overlay"
        rmdir "$reset_work_dir"
    else
        mv "$reset_old_overlay" "$OVERLAY_PATH" >/dev/null 2>&1 || true
        fail "Cannot install the recreated overlay"
    fi
    verify_overlay "$OVERLAY_PATH"
    release_lifecycle_lock
    trap - EXIT HUP INT TERM
    printf 'Recreated the unprovisioned AosVM overlay.\n'
    printf 'Overlay: %s\n' "$OVERLAY_PATH"
}

require_stopped_vm() {
    for stopped_runtime_path in \
        "$PID_PATH" "$QMP_SOCKET_PATH" "$SERIAL_SOCKET_PATH" \
        "$DNS_BRIDGE_PID_PATH" "$SUPERVISOR_PID_PATH"; do
        [ ! -e "$stopped_runtime_path" ] && [ ! -L "$stopped_runtime_path" ] ||
            fail "Checkpoint operation requires a cleanly stopped VM: $stopped_runtime_path"
    done
}

write_pre_provision_state() {
    state_target=$1
    backup_target=$2
    backup_sha256=$3
    active_overlay=$(absolute_path "$OVERLAY_PATH")

    jq -n \
        --arg vm "$VM_NAME" \
        --arg lifecycle "provisioning-locked" \
        --arg active_overlay "$active_overlay" \
        --arg pre_backup "$backup_target" \
        --arg pre_sha256 "$backup_sha256" \
        --arg base_sha256 "$MAIN_IMAGE_SHA256" \
        --arg created_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        '{schema: 1, vm: $vm, lifecycle: $lifecycle,
          lockId: $pre_sha256,
          activeOverlay: $active_overlay,
          preProvisionBackup: $pre_backup,
          preProvisionBackupSha256: $pre_sha256,
          baseImageSha256: $base_sha256,
          lockedAt: $created_at}' >"$state_target"
    chmod 0600 "$state_target"
}

write_lifecycle_guard() {
    guard_target=$1
    lock_id=$2
    active_overlay=$(absolute_path "$OVERLAY_PATH")

    jq -n \
        --arg vm "$VM_NAME" \
        --arg active_overlay "$active_overlay" \
        --arg base_sha256 "$MAIN_IMAGE_SHA256" \
        --arg lock_id "$lock_id" \
        --arg locked_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        '{schema: 1, vm: $vm, resetLocked: true,
          activeOverlay: $active_overlay,
          baseImageSha256: $base_sha256,
          lockId: $lock_id,
          lockedAt: $locked_at}' >"$guard_target"
    chmod 0600 "$guard_target"
}

write_provisioned_state() {
    source_state=$1
    state_target=$2
    backup_target=$3
    backup_sha256=$4

    jq \
        --arg lifecycle "provisioned" \
        --arg post_backup "$backup_target" \
        --arg post_sha256 "$backup_sha256" \
        --arg sealed_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        '.lifecycle = $lifecycle |
         .postProvisionBackup = $post_backup |
         .postProvisionBackupSha256 = $post_sha256 |
         .sealedAt = $sealed_at' "$source_state" >"$state_target"
    chmod 0600 "$state_target"
}

create_lifecycle_checkpoint() {
    checkpoint_kind=$1

    require_command jq
    require_command qemu-img
    require_command shasum
    require_command stat
    acquire_lifecycle_lock
    require_stopped_vm
    verify_release_file "$MAIN_IMAGE_PATH" "$MAIN_IMAGE_SIZE" \
        "$MAIN_IMAGE_SHA256" "Main Node image"
    verify_base_image "$MAIN_IMAGE_PATH" "Main Node image"
    verify_overlay "$OVERLAY_PATH"
    [ "$(file_mode "$OVERLAY_PATH")" = 600 ] ||
        fail "Overlay mode must be 0600"
    verify_lifecycle_state

    case "$checkpoint_kind" in
        pre-provision)
            [ "$LIFECYCLE_STATUS" = unprotected ] ||
                fail "Pre-provision checkpoint requires unprotected lifecycle state, found $LIFECYCLE_STATUS"
            checkpoint_name=$PRE_PROVISION_BACKUP
            ;;
        post-provision)
            [ "$LIFECYCLE_STATUS" = provisioning-locked ] ||
                fail "Post-provision sealing requires provisioning-locked state, found $LIFECYCLE_STATUS"
            checkpoint_name=$POST_PROVISION_BACKUP
            ;;
        *) fail "Unknown checkpoint kind: $checkpoint_kind" ;;
    esac

    ensure_private_directory "$BACKUP_ROOT" "Checkpoint directory"
    checkpoint_target="$BACKUP_ROOT/$checkpoint_name"
    [ ! -e "$checkpoint_target" ] && [ ! -L "$checkpoint_target" ] ||
        fail "Checkpoint already exists: $checkpoint_target"

    CHECKPOINT_WORK_DIR=$(mktemp -d "$BACKUP_ROOT/.checkpoint.XXXXXX")
    chmod 0700 "$CHECKPOINT_WORK_DIR"
    trap checkpoint_cleanup EXIT HUP INT TERM
    checkpoint_partial="$CHECKPOINT_WORK_DIR/$checkpoint_name"
    state_partial="$CHECKPOINT_WORK_DIR/$LIFECYCLE_STATE"
    CHECKPOINT_GUARD_PARTIAL="$LOCAL_ROOT/.$LIFECYCLE_GUARD.partial.$$"

    qemu-img convert -q -f qcow2 -O qcow2 "$OVERLAY_PATH" \
        "$checkpoint_partial"
    chmod 0600 "$checkpoint_partial"
    verify_standalone_backup "$checkpoint_partial"
    checkpoint_sha256=$(file_sha256 "$checkpoint_partial")

    case "$checkpoint_kind" in
        pre-provision)
            write_pre_provision_state "$state_partial" "$checkpoint_target" \
                "$checkpoint_sha256"
            [ ! -e "$LIFECYCLE_GUARD_PATH" ] &&
                [ ! -L "$LIFECYCLE_GUARD_PATH" ] ||
                fail "Lifecycle guard already exists: $LIFECYCLE_GUARD_PATH"
            write_lifecycle_guard "$CHECKPOINT_GUARD_PARTIAL" \
                "$checkpoint_sha256"
            ;;
        post-provision)
            write_provisioned_state "$LIFECYCLE_STATE_PATH" "$state_partial" \
                "$checkpoint_target" "$checkpoint_sha256"
            ;;
    esac

    mv "$checkpoint_partial" "$checkpoint_target"
    mv "$state_partial" "$LIFECYCLE_STATE_PATH"
    if [ "$checkpoint_kind" = pre-provision ]; then
        mv "$CHECKPOINT_GUARD_PARTIAL" "$LIFECYCLE_GUARD_PATH"
        CHECKPOINT_GUARD_PARTIAL=''
    fi
    rmdir "$CHECKPOINT_WORK_DIR"
    CHECKPOINT_WORK_DIR=''
    verify_lifecycle_state
    release_lifecycle_lock
    trap - EXIT HUP INT TERM

    printf 'Created and verified the %s AosVM checkpoint.\n' "$checkpoint_kind"
    printf 'Lifecycle: %s\n' "$LIFECYCLE_STATUS"
    printf 'Checkpoint: %s\n' "$checkpoint_target"
    printf 'SHA-256: %s\n' "$checkpoint_sha256"
    if [ "$checkpoint_kind" = pre-provision ]; then
        printf 'Destructive overlay reset is now locked.\n'
    else
        printf 'This provisioned identity must never run concurrently with a restored copy.\n'
    fi
}

lifecycle_status() {
    require_command jq
    require_command qemu-img
    require_command shasum
    require_command stat
    verify_lifecycle_state

    printf 'AosVM lifecycle: %s\n' "$LIFECYCLE_STATUS"
    printf 'Active overlay: %s\n' "$OVERLAY_PATH"
    printf 'Lifecycle state: %s\n' "$LIFECYCLE_STATE_PATH"
    if [ "$LIFECYCLE_STATUS" = unprotected ]; then
        printf 'No protected checkpoint exists; provisioning must not start.\n'
        return
    fi

    lifecycle_json=$(cat "$LIFECYCLE_STATE_PATH")
    pre_provision_backup=$(printf '%s\n' "$lifecycle_json" |
        jq -er '.preProvisionBackup')
    expected_pre_sha256=$(printf '%s\n' "$lifecycle_json" |
        jq -er '.preProvisionBackupSha256')
    verify_standalone_backup "$pre_provision_backup"
    [ "$(file_sha256 "$pre_provision_backup")" = "$expected_pre_sha256" ] ||
        fail "Pre-provision checkpoint SHA-256 does not match lifecycle state"
    printf 'Pre-provision checkpoint: verified\n'

    if [ "$LIFECYCLE_STATUS" = provisioned ]; then
        post_provision_backup=$(printf '%s\n' "$lifecycle_json" |
            jq -er '.postProvisionBackup')
        expected_post_sha256=$(printf '%s\n' "$lifecycle_json" |
            jq -er '.postProvisionBackupSha256')
        verify_standalone_backup "$post_provision_backup"
        [ "$(file_sha256 "$post_provision_backup")" = "$expected_post_sha256" ] ||
            fail "Post-provision checkpoint SHA-256 does not match lifecycle state"
        printf 'Post-provision checkpoint: verified\n'
    fi
    printf 'Destructive overlay reset: locked\n'
}

vm_status() {
    ensure_lifecycle_directories
    if [ ! -e "$PID_PATH" ] && [ ! -L "$PID_PATH" ]; then
        for stale_path in "$QMP_SOCKET_PATH" "$SERIAL_SOCKET_PATH" \
            "$DNS_BRIDGE_PID_PATH" "$SUPERVISOR_PID_PATH"; do
            [ ! -e "$stale_path" ] && [ ! -L "$stale_path" ] ||
                fail "VM is stopped but ambiguous runtime state remains: $stale_path"
        done
        printf 'AosVM Main Node is stopped.\n'
        return
    fi

    qemu_pid=$(resolve_running_vm)
    running_network_mode=$(qemu_network_mode "$qemu_pid")
    supervisor_pid=$(read_pid_file "$SUPERVISOR_PID_PATH" "Supervisor PID file")
    verify_supervisor_pid "$supervisor_pid" "$qemu_pid"
    dns_pid=$(read_pid_file "$DNS_BRIDGE_PID_PATH" "DNS bridge PID file")
    dns_command=$(process_command "$dns_pid") ||
        fail "DNS bridge PID is not running: $dns_pid"
    case "$dns_command" in
        "/usr/bin/python3 $DNS_BRIDGE_SCRIPT --listen-address $HOST_DNS_ADDRESS --listen-port $HOST_DNS_PORT"|\
        *"/Python $DNS_BRIDGE_SCRIPT --listen-address $HOST_DNS_ADDRESS --listen-port $HOST_DNS_PORT") ;;
        *) fail "DNS bridge PID is not the owned loopback bridge" ;;
    esac
    dns_parent_pid=$(process_parent_pid "$dns_pid") ||
        fail "Cannot resolve the DNS bridge parent PID"
    [ "$dns_parent_pid" = "$supervisor_pid" ] ||
        fail "Owned DNS bridge is not a child of the recorded supervisor"
    qmp_status=$(qmp_command query-status)
    printf '%s\n' "$qmp_status" | grep -Fq '"status":"running"' ||
        fail "QEMU is not in running state"

    ssh_listener=$(lsof -nP -a -p "$qemu_pid" -iTCP:"$SSH_HOST_PORT" \
        -sTCP:LISTEN -F n 2>/dev/null | sed -n 's/^n//p')
    [ "$ssh_listener" = "127.0.0.1:$SSH_HOST_PORT" ] ||
        fail "Owned QEMU SSH listener is not loopback-only"
    provisioning_listener=$(lsof -nP -a -p "$qemu_pid" \
        -iTCP:"$PROVISIONING_HOST_PORT" -sTCP:LISTEN -F n 2>/dev/null |
        sed -n 's/^n//p')
    case "$running_network_mode" in
        normal)
            [ -z "$provisioning_listener" ] ||
                fail "Normal AosVM mode unexpectedly exposes the provisioning port"
            ;;
        provisioning)
            [ "$provisioning_listener" = "$PROVISIONING_HOST_ADDRESS:$PROVISIONING_HOST_PORT" ] ||
                fail "Provisioning listener is not loopback-only"
            ;;
    esac
    dns_tcp_listener=$(lsof -nP -a -p "$dns_pid" -iTCP:"$HOST_DNS_PORT" \
        -sTCP:LISTEN -F n 2>/dev/null | sed -n 's/^n//p')
    dns_udp_listener=$(lsof -nP -a -p "$dns_pid" -iUDP:"$HOST_DNS_PORT" \
        -F n 2>/dev/null | sed -n 's/^n//p')
    [ "$dns_tcp_listener" = "$HOST_DNS_ADDRESS:$HOST_DNS_PORT" ] &&
        [ "$dns_udp_listener" = "$HOST_DNS_ADDRESS:$HOST_DNS_PORT" ] ||
        fail "Owned DNS bridge listeners are not loopback-only"

    printf 'AosVM Main Node is running.\n'
    printf 'QEMU PID: %s\n' "$qemu_pid"
    printf 'Supervisor PID: %s\n' "$supervisor_pid"
    printf 'DNS bridge PID: %s\n' "$dns_pid"
    printf 'QMP status: running\n'
    printf 'Network mode: %s\n' "$running_network_mode"
    printf 'SSH: 127.0.0.1:%s\n' "$SSH_HOST_PORT"
    if [ "$running_network_mode" = provisioning ]; then
        printf 'Provisioning IAM: %s:%s -> %s:%s\n' \
            "$PROVISIONING_HOST_ADDRESS" "$PROVISIONING_HOST_PORT" \
            "$GUEST_ADDRESS" "$GUEST_PROVISIONING_PORT"
    else
        printf 'Provisioning IAM: not exposed\n'
    fi
    printf 'DNS bridge: %s:%s (TCP and UDP)\n' \
        "$HOST_DNS_ADDRESS" "$HOST_DNS_PORT"
    printf 'Serial socket: %s\n' "$SERIAL_SOCKET_PATH"
    printf 'Overlay: %s\n' "$OVERLAY_PATH"
}

supervise_vm() {
    supervised_network_mode=$1
    [ "$SUPERVISOR_MODE" -eq 0 ] || fail "Supervisor mode is already active"
    supervisor_wait=0
    while [ ! -f "$SUPERVISOR_PID_PATH" ]; do
        [ "$supervisor_wait" -lt 50 ] ||
            fail "Supervisor PID file did not become available"
        sleep 0.1
        supervisor_wait=$((supervisor_wait + 1))
    done
    supervisor_pid=$(read_pid_file "$SUPERVISOR_PID_PATH" "Supervisor PID file")
    [ "$supervisor_pid" -eq "$$" ] ||
        fail "Supervisor PID file does not name the current process"
    SUPERVISOR_MODE=1
    start_vm foreground "$supervised_network_mode"
}

start_foreground_owned() {
    start_network_mode=$1
    acquire_lifecycle_lock
    if [ -e "$PID_PATH" ] || [ -L "$PID_PATH" ]; then
        vm_status
        running_qemu_pid=$(resolve_running_vm)
        running_network_mode=$(qemu_network_mode "$running_qemu_pid")
        [ "$running_network_mode" = "$start_network_mode" ] ||
            fail "AosVM is already running in $running_network_mode mode; stop it before requesting $start_network_mode mode"
        release_lifecycle_lock
        trap - EXIT HUP INT TERM
        printf 'AosVM Main Node is already running.\n'
        return
    fi
    [ ! -e "$SUPERVISOR_PID_PATH" ] && [ ! -L "$SUPERVISOR_PID_PATH" ] ||
        fail "Ambiguous supervisor state exists: $SUPERVISOR_PID_PATH"
    printf '%s\n' "$$" >"$SUPERVISOR_PID_PATH"
    chmod 0600 "$SUPERVISOR_PID_PATH"
    SUPERVISOR_MODE=1
    release_lifecycle_lock
    trap - EXIT HUP INT TERM
    start_vm foreground "$start_network_mode"
}

vm_console() {
    require_command nc
    resolve_running_vm >/dev/null
    [ ! -L "$SERIAL_SOCKET_PATH" ] && [ -S "$SERIAL_SOCKET_PATH" ] ||
        fail "The owned serial socket is unavailable: $SERIAL_SOCKET_PATH"
    printf 'Connecting to the AosVM serial console. Press Ctrl-C to detach.\n'
    nc -U "$SERIAL_SOCKET_PATH"
}

vm_stop() {
    acquire_lifecycle_lock
    validate_lifecycle_timeouts

    if [ ! -e "$PID_PATH" ] && [ ! -L "$PID_PATH" ]; then
        for stale_path in "$QMP_SOCKET_PATH" "$SERIAL_SOCKET_PATH" \
            "$DNS_BRIDGE_PID_PATH" "$SUPERVISOR_PID_PATH"; do
            [ ! -e "$stale_path" ] && [ ! -L "$stale_path" ] ||
                fail "VM has no PID but ambiguous runtime state remains: $stale_path"
        done
        release_lifecycle_lock
        trap - EXIT HUP INT TERM
        printf 'AosVM Main Node is already stopped.\n'
        return
    fi

    qemu_pid=$(resolve_running_vm)
    supervisor_pid=$(read_pid_file "$SUPERVISOR_PID_PATH" "Supervisor PID file")
    verify_supervisor_pid "$supervisor_pid" "$qemu_pid"
    printf 'Requesting a clean AosVM shutdown through QMP.\n'
    qmp_command system_powerdown >/dev/null
    if wait_for_process_exit "$qemu_pid" "$STOP_TIMEOUT_SECONDS"; then
        printf 'The guest completed a clean shutdown.\n'
    else
        verify_owned_qemu_pid "$qemu_pid"
        printf 'Guest shutdown timed out; sending TERM to verified QEMU PID %s.\n' \
            "$qemu_pid"
        kill -TERM "$qemu_pid" || fail "Cannot signal verified QEMU PID $qemu_pid"
        wait_for_process_exit "$qemu_pid" "$TERM_TIMEOUT_SECONDS" ||
            fail "Verified QEMU PID did not exit after TERM: $qemu_pid"
    fi

    wait_for_process_exit "$supervisor_pid" "$TERM_TIMEOUT_SECONDS" ||
        fail "Owned supervisor did not exit after QEMU shutdown"
    runtime_cleanup_elapsed=0
    while [ "$runtime_cleanup_elapsed" -lt "$TERM_TIMEOUT_SECONDS" ]; do
        if [ ! -e "$PID_PATH" ] && [ ! -e "$QMP_SOCKET_PATH" ] &&
           [ ! -e "$SERIAL_SOCKET_PATH" ] && [ ! -e "$DNS_BRIDGE_PID_PATH" ] &&
           [ ! -e "$SUPERVISOR_PID_PATH" ]; then
            break
        fi
        sleep 1
        runtime_cleanup_elapsed=$((runtime_cleanup_elapsed + 1))
    done
    [ ! -e "$PID_PATH" ] && [ ! -e "$QMP_SOCKET_PATH" ] &&
        [ ! -e "$SERIAL_SOCKET_PATH" ] && [ ! -e "$DNS_BRIDGE_PID_PATH" ] &&
        [ ! -e "$SUPERVISOR_PID_PATH" ] ||
        fail "Owned runtime state remained after shutdown"
    verify_overlay "$OVERLAY_PATH"
    release_lifecycle_lock
    trap - EXIT HUP INT TERM
    printf 'Stopped AosVM Main Node and verified overlay integrity.\n'
}

smoke_test() {
    ensure_lifecycle_directories
    validate_lifecycle_timeouts
    qemu_pid=$(resolve_running_vm)
    running_network_mode=$(qemu_network_mode "$qemu_pid")
    vm_status >/dev/null
    require_command nc
    require_command stat

    ssh_banner=''
    smoke_deadline=$(($(date +%s) + SMOKE_TIMEOUT_SECONDS))
    while [ "$(date +%s)" -lt "$smoke_deadline" ]; do
        ssh_banner=$( (sleep 1) |
            nc -w 2 127.0.0.1 "$SSH_HOST_PORT" 2>/dev/null |
            sed -n '1p')
        case "$ssh_banner" in
            SSH-2.0-OpenSSH_*) break ;;
        esac
        sleep 1
    done
    case "$ssh_banner" in
        SSH-2.0-OpenSSH_*) ;;
        *) fail "The guest SSH banner did not become ready within $SMOKE_TIMEOUT_SECONDS seconds" ;;
    esac
    qmp_status=$(qmp_command query-status)
    printf '%s\n' "$qmp_status" | grep -Fq '"status":"running"' ||
        fail "QMP smoke check did not report running state"
    verify_overlay "$OVERLAY_PATH" shared

    manifest_path="$RUNS_ROOT/$VM_NAME-smoke-$(date -u '+%Y%m%dT%H%M%SZ').json"
    manifest_partial="$manifest_path.partial"
    [ ! -e "$manifest_path" ] && [ ! -L "$manifest_path" ] ||
        fail "Smoke-test manifest already exists: $manifest_path"
    cat >"$manifest_partial" <<EOF
{"schema":1,"vm":"$VM_NAME","result":"pass","qmp":"running","networkMode":"$running_network_mode","ssh":"loopback","sshPort":$SSH_HOST_PORT,"dns":"loopback","dnsPort":$HOST_DNS_PORT,"qemuPid":$qemu_pid,"overlayFormat":"qcow2","baseImageSha256":"$MAIN_IMAGE_SHA256","checkedAt":"$(date -u '+%Y-%m-%dT%H:%M:%SZ')"}
EOF
    chmod 0600 "$manifest_partial"
    mv "$manifest_partial" "$manifest_path"
    printf 'AosVM smoke test passed.\n'
    printf 'Local manifest: %s\n' "$manifest_path"
}

usage() {
    printf 'Usage: %s <host-check|download|prepare|start [--foreground|--dry-run]|start-provisioning [--foreground|--dry-run]|console|status|smoke-test|stop|checkpoint-pre-provision|seal-provisioned|lifecycle-status|reset-overlay --confirm>\n' "$0"
}

case ${1:-} in
    host-check)
        [ "$#" -eq 1 ] || fail "The host-check command does not accept arguments"
        host_check
        ;;
    download)
        [ "$#" -eq 1 ] || fail "The download command does not accept arguments"
        download_archive
        ;;
    prepare)
        [ "$#" -eq 1 ] || fail "The prepare command does not accept arguments"
        prepare_images
        ;;
    start)
        [ "$#" -le 2 ] ||
            fail "Start accepts no option, --dry-run, or --foreground"
        case ${2:-background} in
            background) start_background normal ;;
            --dry-run) start_vm dry-run normal ;;
            --foreground) start_foreground_owned normal ;;
            *) fail "Start mode must be --dry-run or --foreground" ;;
        esac
        ;;
    start-provisioning)
        [ "$#" -le 2 ] ||
            fail "Start-provisioning accepts no option, --dry-run, or --foreground"
        case ${2:-background} in
            background) start_background provisioning ;;
            --dry-run) start_vm dry-run provisioning ;;
            --foreground) start_foreground_owned provisioning ;;
            *) fail "Start-provisioning mode must be --dry-run or --foreground" ;;
        esac
        ;;
    console)
        [ "$#" -eq 1 ] || fail "The console command does not accept arguments"
        vm_console
        ;;
    status)
        [ "$#" -eq 1 ] || fail "The status command does not accept arguments"
        vm_status
        ;;
    smoke-test)
        [ "$#" -eq 1 ] || fail "The smoke-test command does not accept arguments"
        smoke_test
        ;;
    stop)
        [ "$#" -eq 1 ] || fail "The stop command does not accept arguments"
        vm_stop
        ;;
    checkpoint-pre-provision)
        [ "$#" -eq 1 ] ||
            fail "The checkpoint-pre-provision command does not accept arguments"
        create_lifecycle_checkpoint pre-provision
        ;;
    seal-provisioned)
        [ "$#" -eq 1 ] ||
            fail "The seal-provisioned command does not accept arguments"
        create_lifecycle_checkpoint post-provision
        ;;
    lifecycle-status)
        [ "$#" -eq 1 ] ||
            fail "The lifecycle-status command does not accept arguments"
        lifecycle_status
        ;;
    reset-overlay)
        [ "$#" -eq 2 ] || fail "Reset requires the explicit --confirm option"
        reset_overlay "$2"
        ;;
    _supervise)
        [ "$#" -eq 2 ] || fail "The internal supervisor requires one network mode"
        case "$2" in
            normal|provisioning) supervise_vm "$2" ;;
            *) fail "The internal supervisor received an invalid network mode" ;;
        esac
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
