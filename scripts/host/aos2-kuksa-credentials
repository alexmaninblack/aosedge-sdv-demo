"""Create and verify ignored, path-scoped KUKSA prototype credentials."""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import json
import os
import shutil
import stat
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
PRIVATE_ROOT = ROOT / ".local/aos2-kuksa"
PRIVATE_KEY = PRIVATE_ROOT / "jwt-signing-key.pem"
PUBLIC_KEY = PRIVATE_ROOT / "jwt-signing-key.pub.pem"
PROVIDER_TOKEN = PRIVATE_ROOT / "carla-kuksa-provider.token"
READER_TOKEN = PRIVATE_ROOT / "aos2-qualification-reader.token"
DEFAULT_PROFILE = (
    ROOT.parent
    / "aos-vehicle-platform/contracts/vehicle-telemetry-profile/v0.1.1/profile.json"
)


class CredentialError(RuntimeError):
    """Raised for unsafe state or invalid credential material."""


def encode(value: bytes) -> str:
    return base64.urlsafe_b64encode(value).rstrip(b"=").decode("ascii")


def decode(value: str) -> bytes:
    return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))


def require_openssl() -> str:
    openssl = shutil.which("openssl")
    if openssl is None:
        raise CredentialError("OpenSSL is required")
    return openssl


def ensure_private_root() -> None:
    if PRIVATE_ROOT.is_symlink():
        raise CredentialError(f"private root must not be a symlink: {PRIVATE_ROOT}")
    PRIVATE_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(PRIVATE_ROOT, 0o700)
    if stat.S_IMODE(PRIVATE_ROOT.stat().st_mode) != 0o700:
        raise CredentialError(f"private root mode must be 0700: {PRIVATE_ROOT}")


def atomic_output(mode: int) -> tuple[Path, int]:
    descriptor, raw_path = tempfile.mkstemp(prefix=".credential.", dir=PRIVATE_ROOT)
    os.fchmod(descriptor, mode)
    return Path(raw_path), descriptor


def generate_key_pair(openssl: str) -> None:
    ensure_private_root()
    if PRIVATE_KEY.exists() or PRIVATE_KEY.is_symlink():
        require_regular(PRIVATE_KEY, 0o600)
    else:
        temporary, descriptor = atomic_output(0o600)
        os.close(descriptor)
        try:
            subprocess.run(
                [
                    openssl,
                    "genpkey",
                    "-algorithm",
                    "RSA",
                    "-pkeyopt",
                    "rsa_keygen_bits:3072",
                    "-out",
                    str(temporary),
                ],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            os.chmod(temporary, 0o600)
            os.replace(temporary, PRIVATE_KEY)
        finally:
            temporary.unlink(missing_ok=True)

    temporary, descriptor = atomic_output(0o644)
    os.close(descriptor)
    try:
        subprocess.run(
            [
                openssl,
                "pkey",
                "-in",
                str(PRIVATE_KEY),
                "-pubout",
                "-out",
                str(temporary),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        os.chmod(temporary, 0o644)
        if PUBLIC_KEY.exists() and PUBLIC_KEY.read_bytes() != temporary.read_bytes():
            raise CredentialError("existing KUKSA public key does not match the private key")
        os.replace(temporary, PUBLIC_KEY)
    finally:
        temporary.unlink(missing_ok=True)
    require_regular(PRIVATE_KEY, 0o600)
    require_regular(PUBLIC_KEY, 0o644)


def load_scopes(profile_path: Path, permission: str) -> str:
    profile = json.loads(profile_path.read_text(encoding="utf-8"))
    if profile.get("contract", {}).get("version") != "0.1.1":
        raise CredentialError("AOS-2 credentials require contract 0.1.1")
    signals = profile.get("signals")
    if not isinstance(signals, list) or len(signals) != 7:
        raise CredentialError("contract must contain the seven AOS-2 signals")
    scopes = []
    for signal in signals:
        path = signal.get("path")
        scope = signal.get("permissions", {}).get(permission)
        expected_action = "provide" if permission == "provider" else "read"
        if scope != f"{expected_action}:{path}":
            raise CredentialError(f"invalid {permission} scope for {path}")
        scopes.append(scope)
    return " ".join(scopes)


def issue_token(
    openssl: str,
    profile_path: Path,
    ttl_hours: int,
    subject: str,
    permission: str,
    destination: Path,
) -> dt.datetime:
    if not 1 <= ttl_hours <= 24 * 30:
        raise CredentialError("token lifetime must be between 1 hour and 30 days")
    scope = load_scopes(profile_path, permission)
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    expires = now + dt.timedelta(hours=ttl_hours)
    header = {"alg": "RS256", "typ": "at+JWT"}
    claims = {
        "aud": ["kuksa.val"],
        "exp": int(expires.timestamp()),
        "iat": int(now.timestamp()),
        "iss": "https://github.com/alexmaninblack/aos-vehicle-platform",
        "scope": scope,
        "sub": subject,
    }
    signing_input = ".".join(
        encode(json.dumps(item, separators=(",", ":"), sort_keys=True).encode("utf-8"))
        for item in (header, claims)
    )
    signature = subprocess.run(
        [openssl, "dgst", "-sha256", "-sign", str(PRIVATE_KEY)],
        check=True,
        input=signing_input.encode("ascii"),
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    ).stdout
    token = f"{signing_input}.{encode(signature)}\n".encode("ascii")
    temporary, descriptor = atomic_output(0o600)
    try:
        os.write(descriptor, token)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    try:
        verify_token(openssl, temporary, PUBLIC_KEY)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
    require_regular(destination, 0o600)
    return expires


def require_regular(path: Path, mode: int) -> None:
    if not path.is_file() or path.is_symlink():
        raise CredentialError(f"credential is not a safe regular file: {path}")
    actual_mode = stat.S_IMODE(path.stat().st_mode)
    if actual_mode != mode:
        raise CredentialError(
            f"credential mode must be {mode:04o}, found {actual_mode:04o}: {path}"
        )


def token_claims(token_path: Path) -> dict[str, object]:
    token = token_path.read_text(encoding="ascii").strip()
    parts = token.split(".")
    if len(parts) != 3:
        raise CredentialError("KUKSA token is not a compact JWT")
    claims = json.loads(decode(parts[1]))
    if not isinstance(claims, dict):
        raise CredentialError("KUKSA JWT claims must be an object")
    return claims


def verify_token(openssl: str, token_path: Path, public_key: Path) -> None:
    token = token_path.read_text(encoding="ascii").strip()
    parts = token.split(".")
    if len(parts) != 3:
        raise CredentialError("KUKSA token is not a compact JWT")
    signature_path, descriptor = atomic_output(0o600)
    try:
        os.write(descriptor, decode(parts[2]))
        os.close(descriptor)
        descriptor = -1
        subprocess.run(
            [
                openssl,
                "dgst",
                "-sha256",
                "-verify",
                str(public_key),
                "-signature",
                str(signature_path),
            ],
            check=True,
            input=f"{parts[0]}.{parts[1]}".encode("ascii"),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        signature_path.unlink(missing_ok=True)


def verify_issued_token(
    openssl: str,
    profile_path: Path,
    token_path: Path,
    subject: str,
    permission: str,
) -> dt.datetime:
    require_regular(token_path, 0o600)
    verify_token(openssl, token_path, PUBLIC_KEY)
    claims = token_claims(token_path)
    if claims.get("aud") != ["kuksa.val"]:
        raise CredentialError("KUKSA token audience is invalid")
    if claims.get("sub") != subject:
        raise CredentialError("KUKSA token subject is invalid")
    if claims.get("scope") != load_scopes(profile_path, permission):
        raise CredentialError("KUKSA token scope does not match contract 0.1.1")
    expires = dt.datetime.fromtimestamp(int(claims["exp"]), dt.timezone.utc)
    if expires <= dt.datetime.now(dt.timezone.utc):
        raise CredentialError("KUKSA provider token has expired")
    return expires


def status(openssl: str, profile_path: Path) -> tuple[dt.datetime, dt.datetime]:
    ensure_private_root()
    require_regular(PRIVATE_KEY, 0o600)
    require_regular(PUBLIC_KEY, 0o644)
    provider_expires = verify_issued_token(
        openssl,
        profile_path,
        PROVIDER_TOKEN,
        "carla-kuksa-provider",
        "provider",
    )
    reader_expires = verify_issued_token(
        openssl,
        profile_path,
        READER_TOKEN,
        "aos2-qualification-reader",
        "consumer",
    )
    return provider_expires, reader_expires


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("prepare", "status"))
    parser.add_argument("--profile", type=Path, default=DEFAULT_PROFILE)
    parser.add_argument("--ttl-hours", type=int, default=24 * 7)
    arguments = parser.parse_args()
    try:
        openssl = require_openssl()
        if arguments.command == "prepare":
            generate_key_pair(openssl)
            provider_expires = issue_token(
                openssl,
                arguments.profile,
                arguments.ttl_hours,
                "carla-kuksa-provider",
                "provider",
                PROVIDER_TOKEN,
            )
            reader_expires = issue_token(
                openssl,
                arguments.profile,
                arguments.ttl_hours,
                "aos2-qualification-reader",
                "consumer",
                READER_TOKEN,
            )
        else:
            provider_expires, reader_expires = status(openssl, arguments.profile)
        print("KUKSA prototype credentials passed verification.")
        print(f"Public verification key: {PUBLIC_KEY}")
        print(f"Provider token: {PROVIDER_TOKEN} (content hidden)")
        print(f"Provider token expires: {provider_expires.isoformat()}")
        print(f"Qualification token: {READER_TOKEN} (content hidden)")
        print(f"Qualification token expires: {reader_expires.isoformat()}")
        return 0
    except (CredentialError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"Error: {error}", file=os.sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
