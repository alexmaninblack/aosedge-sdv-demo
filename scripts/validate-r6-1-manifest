#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 maninblack
# SPDX-License-Identifier: MIT

"""Validate the tracked, fully pinned R6.1 Moulin manifest."""

from __future__ import annotations

import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[1]
LOCK_PATH = ROOT / "components" / "r6-1-source.lock.json"
MANIFEST_PATH = ROOT / "manifests" / "r6-1" / "aos-vm-upstream.pinned.yaml"
PROJECT_MANIFEST_PATH = ROOT / "manifests" / "r6-1" / "aos-vm-project.pinned.yaml"
REVISION_RE = re.compile(r"[0-9a-f]{40}")
SOURCE_RE = re.compile(
    r'^\s+- type: git\s*\n\s+url: "([^"]+)"\s*\n\s+rev: "([^"]+)"',
    re.MULTILINE,
)
YOCTO_SOURCES = {
    "poky",
    "meta-openembedded",
    "meta-virtualization",
    "meta-security",
    "meta-selinux",
    "meta-arm",
    "meta-aos",
    "meta-aos-vm",
}
PROJECT_SOURCE = "aos-vehicle-platform"
PROJECT_SOURCE_URL = "https://github.com/alexmaninblack/aos-vehicle-platform"
DOWNLOADS_DIR = "/home/yocto/yocto-cache/downloads"
SSTATE_DIR = "/home/yocto/yocto-cache/sstate-cache"
BOOTSTRAP_BASE_VERSION = "6.1.0"
BOOTSTRAP_ROOTFS_VERSION = "6.1.1-maninblack.11"


class ManifestError(ValueError):
    """Raised when the tracked manifest is floating, incomplete, or unsafe."""


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ManifestError(message)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_name(url: str) -> str:
    value = url.rstrip("/").removesuffix(".git")
    return value.rsplit("/", 1)[-1].lower()


def load_lock(path: Path = LOCK_PATH) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ManifestError(f"cannot read source lock: {error}") from error
    require(isinstance(value, dict), "source lock root must be an object")
    return value


def validate_manifest(
    manifest_path: Path = MANIFEST_PATH,
    lock: dict[str, Any] | None = None,
) -> None:
    source_lock = load_lock() if lock is None else lock
    try:
        content = manifest_path.read_text(encoding="utf-8")
    except OSError as error:
        raise ManifestError(f"cannot read pinned manifest: {error}") from error

    evidence = source_lock.get("evidence", {}).get("pinnedMoulinManifest")
    require(isinstance(evidence, dict), "pinned manifest evidence is missing")
    require(
        evidence.get("path") == "manifests/r6-1/aos-vm-upstream.pinned.yaml",
        "pinned manifest path changed",
    )
    require(
        sha256(manifest_path) == evidence.get("sha256"),
        "pinned manifest digest does not match the lock",
    )
    require(
        evidence.get("upstreamRevision")
        == source_lock.get("manifest", {}).get("revision"),
        "pinned manifest upstream revision changed",
    )
    require(
        re.fullmatch(
            r"[0-9a-f]{64}", str(evidence.get("generatedBuildNinjaSha256", ""))
        )
        is not None,
        "generated Ninja graph digest is missing",
    )
    require(evidence.get("result") == "pass", "pinned manifest did not pass")

    expected = {
        source["name"]: source["revision"]
        for source in source_lock.get("sources", [])
        if isinstance(source, dict) and source.get("name") in YOCTO_SOURCES
    }
    require(set(expected) == YOCTO_SOURCES, "Yocto source lock is incomplete")

    observed: dict[str, str] = {}
    for url, revision in SOURCE_RE.findall(content):
        name = source_name(url)
        require(name in YOCTO_SOURCES, f"unexpected manifest source: {name}")
        require(
            REVISION_RE.fullmatch(revision) is not None,
            f"{name}: manifest revision is not a full commit SHA",
        )
        previous = observed.setdefault(name, revision)
        require(previous == revision, f"{name}: manifest revisions disagree")

    require(set(observed) == YOCTO_SOURCES, "manifest source set is incomplete")
    for name, revision in expected.items():
        require(observed[name] == revision, f"{name}: manifest revision mismatches lock")

    require(content.count(f'"{DOWNLOADS_DIR}"') == 2, "DL_DIR is not fixed")
    require(content.count(f'"{SSTATE_DIR}"') == 2, "SSTATE_DIR is not fixed")
    require('"qemuarm64"' in content, "qemuarm64 target is missing")
    require('"main":\n      default: true' in content, "Main Node is not default")
    require('company: "maninblack"' in content, "publisher is not project-owned")
    require("EPAM Systems" not in content, "upstream example publisher remains")
    require("SPDX-License-Identifier: Apache-2.0" in content, "license is missing")
    for forbidden in (
        "BEGIN PRIVATE KEY",
        "BEGIN CERTIFICATE",
        "one-time token",
        "/Users/",
    ):
        require(forbidden not in content, f"manifest contains forbidden data: {forbidden}")


def validate_project_manifest(
    manifest_path: Path = PROJECT_MANIFEST_PATH,
    lock: dict[str, Any] | None = None,
) -> None:
    source_lock = load_lock() if lock is None else lock
    try:
        content = manifest_path.read_text(encoding="utf-8")
    except OSError as error:
        raise ManifestError(f"cannot read project manifest: {error}") from error
    try:
        manifest = yaml.safe_load(content)
    except yaml.YAMLError as error:
        raise ManifestError(f"project manifest is invalid YAML: {error}") from error
    require(isinstance(manifest, dict), "project manifest root is not an object")

    evidence = source_lock.get("evidence", {}).get("projectMoulinManifest")
    require(isinstance(evidence, dict), "project manifest evidence is missing")
    require(
        evidence.get("path") == "manifests/r6-1/aos-vm-project.pinned.yaml",
        "project manifest path changed",
    )
    require(
        sha256(manifest_path) == evidence.get("sha256"),
        "project manifest digest does not match the lock",
    )
    require(
        re.fullmatch(
            r"[0-9a-f]{64}", str(evidence.get("generatedBuildNinjaSha256", ""))
        )
        is not None,
        "project Ninja graph digest is missing",
    )
    require(evidence.get("result") == "pass", "project manifest did not pass")

    project_revision = str(evidence.get("platformRevision", ""))
    require(
        REVISION_RE.fullmatch(project_revision) is not None,
        "project layer revision is not a full commit SHA",
    )
    require(
        evidence.get("platformRepository") == f"{PROJECT_SOURCE_URL}.git",
        "project layer repository changed",
    )

    expected = {
        source["name"]: source["revision"]
        for source in source_lock.get("sources", [])
        if isinstance(source, dict) and source.get("name") in YOCTO_SOURCES
    }
    require(set(expected) == YOCTO_SOURCES, "Yocto source lock is incomplete")
    expected[PROJECT_SOURCE] = project_revision

    observed: dict[str, str] = {}
    observed_urls: dict[str, str] = {}
    for url, revision in SOURCE_RE.findall(content):
        name = source_name(url)
        require(name in expected, f"unexpected project manifest source: {name}")
        require(
            REVISION_RE.fullmatch(revision) is not None,
            f"{name}: project manifest revision is not a full commit SHA",
        )
        previous = observed.setdefault(name, revision)
        require(previous == revision, f"{name}: project manifest revisions disagree")
        observed_urls.setdefault(name, url)

    require(set(observed) == set(expected), "project manifest source set is incomplete")
    for name, revision in expected.items():
        require(
            observed[name] == revision,
            f"{name}: project manifest revision mismatches lock",
        )
    require(
        observed_urls[PROJECT_SOURCE] == PROJECT_SOURCE_URL,
        "project layer source URL changed",
    )

    require(content.count(f'"{DOWNLOADS_DIR}"') == 2, "project DL_DIR is not fixed")
    require(content.count(f'"{SSTATE_DIR}"') == 2, "project SSTATE_DIR is not fixed")
    require('"qemuarm64"' in content, "project qemuarm64 target is missing")
    require('"main":\n      default: true' in content, "project Main Node is not default")
    require(
        content.count('"../aos-vehicle-platform/meta-aos-vehicle-platform"') == 2,
        "project layer is not fixed for both node layer sets",
    )
    require('company: "maninblack"' in content, "project publisher is not owned")
    variables = manifest.get("variables")
    require(isinstance(variables, dict), "project variables are missing")
    require(
        variables.get("BOOT_IMAGE_VERSION") == BOOTSTRAP_BASE_VERSION,
        "boot version must remain on the qualified upstream baseline",
    )
    require(
        variables.get("ROOTFS_IMAGE_VERSION") == BOOTSTRAP_ROOTFS_VERSION,
        "rootfs release version changed",
    )
    require(
        "BUNDLE_IMAGE_VERSION" not in variables,
        "boot and rootfs versions must remain independently controlled",
    )
    try:
        fota_items = manifest["components"]["fota"]["builder"]["components"][
            "items"
        ]
    except (KeyError, TypeError) as error:
        raise ManifestError("project FOTA item configuration is missing") from error
    require(isinstance(fota_items, dict), "project FOTA items are not an object")
    require(
        set(fota_items) == {"boot", "rootfs-full", "rootfs-incremental"},
        "project FOTA item set changed",
    )
    require(
        fota_items["boot"].get("enabled") is False,
        "boot component must stay disabled for the rootfs-only release",
    )
    require(
        fota_items["boot"].get("version") == "%{BOOT_IMAGE_VERSION}",
        "boot component version binding changed",
    )
    require(
        fota_items["rootfs-full"].get("enabled") is True,
        "full rootfs component must be enabled",
    )
    require(
        fota_items["rootfs-full"].get("version")
        == "%{ROOTFS_IMAGE_VERSION}",
        "full rootfs version binding changed",
    )
    require(
        fota_items["rootfs-incremental"].get("enabled") is False,
        "unqualified incremental rootfs component must stay disabled",
    )
    require(
        content.count(
            '[AOS_ROOTFS_IMAGE_VERSION, "%{ROOTFS_IMAGE_VERSION}"]'
        )
        == 1,
        "rootfs image version is not bound exactly once",
    )
    require(
        content.count('[AOS_BOOT_IMAGE_VERSION, "%{BOOT_IMAGE_VERSION}"]') == 1,
        "boot image version is not bound exactly once",
    )
    require("EPAM Systems" not in content, "upstream example publisher remains")
    require(
        'script: "/home/yocto/.local/pipx/venvs/moulin/bin/python '
        'yocto/meta-aos/scripts/fota_builder.py"' in content
        and '- "output/fota/config.yaml"' in content
        and 'output_dir: "output/fota"' in content,
        "project FOTA paths are not rooted at the generated Ninja working directory",
    )
    require(
        'script: "../yocto/meta-aos/scripts/fota_builder.py"' not in content,
        "project FOTA script escapes the generated Ninja working directory",
    )
    require("SPDX-License-Identifier: Apache-2.0" in content, "license is missing")
    for forbidden in (
        "BEGIN PRIVATE KEY",
        "BEGIN CERTIFICATE",
        "one-time token",
        "/Users/",
        "tlsKey:",
        ".p12",
        ".pfx",
    ):
        require(
            forbidden not in content,
            f"project manifest contains forbidden data: {forbidden}",
        )


def main() -> int:
    try:
        validate_manifest()
        validate_project_manifest()
    except ManifestError as error:
        print(f"R6.1 manifest validation failed: {error}", file=sys.stderr)
        return 1
    print(
        "R6.1 pinned Moulin manifest validation passed for the upstream "
        "and project source sets."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
