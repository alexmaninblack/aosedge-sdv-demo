{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexmaninblack/aosedge-sdv-demo/components/baseline-lock.schema.json",
  "title": "CARLA-AosEdge exact component lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$comment", "schemaVersion", "baseline", "components"],
  "properties": {
    "$schema": { "const": "./baseline-lock.schema.json" },
    "$comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "created", "hostArchitecture", "guestArchitecture"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "accepted"] },
        "created": { "type": "string", "format": "date" },
        "hostArchitecture": { "const": "macos-arm64" },
        "guestArchitecture": { "const": "arm64" }
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "architectures", "source", "artifact"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["arm64", "macos-arm64", "any"] }
        },
        "source": { "$ref": "#/$defs/source" },
        "artifact": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["release-archive", "embedded", "git-commit", "repository-files"] },
            "generatedBundle": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "architecture", "sha256"],
              "properties": {
                "fileName": { "type": "string", "minLength": 1 },
                "architecture": { "const": "arm64" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
