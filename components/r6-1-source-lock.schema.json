{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexmaninblack/carla-aosedge-integration/components/r6-1-source-lock.schema.json",
  "title": "R6.1 exact source baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$comment",
    "schemaVersion",
    "baseline",
    "builder",
    "manifest",
    "sources",
    "evidence",
    "upstreamGaps"
  ],
  "properties": {
    "$schema": { "const": "./r6-1-source-lock.schema.json" },
    "$comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "created",
        "targetMachine",
        "nodeType",
        "guestArchitecture",
        "unitModel",
        "serviceManagerProtocol",
        "proposedComponentType"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "accepted"] },
        "created": { "type": "string", "format": "date" },
        "targetMachine": { "const": "qemuarm64" },
        "nodeType": { "const": "main" },
        "guestArchitecture": { "const": "arm64" },
        "unitModel": { "const": "aos-vm;1.0.0" },
        "serviceManagerProtocol": { "const": "v5" },
        "proposedComponentType": { "type": "string", "minLength": 1 }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "release",
        "architecture",
        "imageFileName",
        "imageUrl",
        "imageSha256",
        "qemuVersion",
        "firmwareSha256",
        "virtualCPUs",
        "memoryMiB",
        "virtualDiskGiB",
        "sshHostPort"
      ],
      "properties": {
        "os": { "const": "Ubuntu Server 22.04 LTS" },
        "release": { "const": "20260722" },
        "architecture": { "const": "arm64" },
        "imageFileName": { "const": "ubuntu-22.04-server-cloudimg-arm64.img" },
        "imageUrl": { "type": "string", "pattern": "^https://" },
        "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "qemuVersion": { "const": "11.0.3" },
        "firmwareSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "virtualCPUs": { "type": "integer", "minimum": 1 },
        "memoryMiB": { "type": "integer", "minimum": 8192 },
        "virtualDiskGiB": { "type": "integer", "minimum": 120 },
        "sshHostPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "manifest": { "$ref": "#/$defs/manifest" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "evidence": { "type": "object" },
    "upstreamGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "issue", "resolution"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "tag",
        "path",
        "sha256",
        "moulinMinimumVersion"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "moulinMinimumVersion": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "revision", "pinSource"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "minLength": 1 },
        "pinSource": {
          "enum": [
            "manifest-commit",
            "release-time-resolution",
            "resolved-manifest-tag",
            "yocto-recipe-srcrev",
            "resolved-cmake-tag",
            "builder-tool-tag"
          ]
        },
        "upstreamSelector": { "type": "string", "minLength": 1 }
      }
    }
  }
}
