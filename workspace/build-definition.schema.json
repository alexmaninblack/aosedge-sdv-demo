{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "title": "Current build selection with immutable compatibility inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "id", "compatibilityBase", "developerSelection", "operatorSelection", "documentation", "historicalEvidence"],
  "properties": {
    "$comment": {"type": "string"},
    "$schema": {"const": "build-definition.schema.json"},
    "schemaVersion": {"type": "integer", "const": 2},
    "kind": {"const": "current-build-definition"},
    "id": {"const": "sdv-lab-current"},
    "compatibilityBase": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "definitionDigest"],
      "properties": {
        "path": {"const": "workspace/releases/kit028-setup042.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "definitionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "developerSelection": {"const": "workspace/current-developer-build.json"},
    "operatorSelection": {"const": "workspace/launcher-catalog.json"},
    "documentation": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^docs/[A-Za-z0-9_./-]+\\.md$"}},
    "historicalEvidence": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "path", "sha256"],
        "properties": {
          "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "path": {"type": "string", "pattern": "^docs/[A-Za-z0-9_./-]+\\.md$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
