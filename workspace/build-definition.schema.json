{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone SDV Lab build selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "developerSelection",
    "operatorSelection",
    "inputs",
    "authorities",
    "documentation"
  ],
  "properties": {
    "$schema": {
      "const": "build-definition.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "kind": {
      "const": "current-build-definition"
    },
    "id": {
      "const": "sdv-lab-current"
    },
    "developerSelection": {
      "const": "workspace/current-developer-build.json"
    },
    "operatorSelection": {
      "const": "workspace/launcher-catalog.json"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "runtime",
        "controllers",
        "services",
        "policy",
        "cache"
      ],
      "properties": {
        "sources": {
          "const": "workspace/inputs/sources.lock.json"
        },
        "runtime": {
          "const": "workspace/inputs/runtime-inputs.lock.json"
        },
        "controllers": {
          "const": "workspace/inputs/controller-images.lock.json"
        },
        "services": {
          "const": "workspace/inputs/service-inputs.lock.json"
        },
        "policy": {
          "const": "workspace/inputs/build-policy.json"
        },
        "cache": {
          "const": "workspace/inputs/cache-compatibility.json"
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "documentation": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "pattern": "^docs/[A-Za-z0-9_./-]+\\.md$"
      }
    }
  }
}
