{
  "$schema": "./repositories.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "schemaVersion": 1,
  "workspace": {
    "solutionDirectory": "aosedge-sdv-demo",
    "acceptedBranches": ["main"],
    "obsoleteDirectoryNames": ["carla-aosedge-integration"]
  },
  "repositories": [
    {
      "id": "carla",
      "directory": "CarlaSim",
      "role": "Virtual physical vehicle and CARLA simulator source",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/carla.git",
      "remote": "personal",
      "acceptedRevision": "ac7d882cac496ccbf8b40aa543d6b38513e1173c",
      "acceptedBranches": ["macos-apple-silicon"],
      "allowedDirtyPaths": []
    },
    {
      "id": "unreal-engine",
      "directory": "UnrealEngine5_carla",
      "role": "Restricted Unreal Engine dependency for the native CARLA editor",
      "visibility": "private",
      "repository": "https://github.com/alexmaninblack/UnrealEngine.git",
      "remote": "personal",
      "acceptedRevision": "9b705d6d2db5b769ab34edb04f3ca2bb8b960014",
      "acceptedBranches": ["macos-xcode26-compat"],
      "allowedDirtyPaths": ["Engine/Config/DefaultEngine.ini"]
    },
    {
      "id": "vehicle-gateway",
      "directory": "carla-ego-runtime",
      "role": "Simulated Vehicle Gateway ECU, control plane, VSS projection, and VISS server",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/carla-ego-runtime.git",
      "remote": "origin",
      "acceptedRevision": "a3f62c0610b84ada0aac804d7e21d52572cae9f1",
      "acceptedBranches": ["main"],
      "allowedDirtyPaths": []
    },
    {
      "id": "vehicle-platform",
      "directory": "aos-vehicle-platform",
      "role": "Domain Controller vehicle integration and OEM platform/FOTA lifecycle",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/aos-vehicle-platform.git",
      "remote": "origin",
      "acceptedRevision": "75503cdc2b9ab0ecb527db3bbf84e5380d6c42c7",
      "acceptedBranches": ["main"],
      "allowedDirtyPaths": []
    },
    {
      "id": "functional-service",
      "directory": "brake-health-service",
      "role": "In-vehicle Brake Health functional service with an independent SOTA lifecycle",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/brake-health-service.git",
      "remote": "origin",
      "acceptedRevision": "4f75373123cbc00a5b7a3541b1d289cb07affd39",
      "acceptedBranches": ["main"],
      "allowedDirtyPaths": []
    },
    {
      "id": "brake-health-cloud",
      "directory": "brake-health-cloud",
      "role": "Function Team 1 Brake Health backend and Function Dashboard",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/brake-health-cloud.git",
      "remote": "origin",
      "acceptedRevision": "42395715103d9f512c2586a2c9b98c3975c06ab7",
      "acceptedBranches": ["main"],
      "allowedDirtyPaths": []
    },
    {
      "id": "tire-health-service",
      "directory": "tire-health-service",
      "role": "Independent in-vehicle Tire Health service and advisory producer",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/tire-health-service.git",
      "remote": "origin",
      "acceptedRevision": "20e6a23dcb97c29a0315fedd2e720ab537f01ff8",
      "acceptedBranches": ["main"],
      "allowedDirtyPaths": []
    },
    {
      "id": "tire-health-cloud",
      "directory": "tire-health-cloud",
      "role": "Function Team 2 Tire Health backend and observations",
      "visibility": "public",
      "repository": "https://github.com/alexmaninblack/tire-health-cloud.git",
      "remote": "origin",
      "acceptedRevision": "47cfa632a80c89a7eaab0c501fe437c4ae2cb180",
      "acceptedBranches": ["main"],
      "allowedDirtyPaths": []
    }
  ],
  "launcherPaths": [
    { "id": "carla-root", "base": "workspace", "path": "CarlaSim", "kind": "directory" },
    { "id": "runtime-root", "base": "workspace", "path": "carla-ego-runtime", "kind": "directory" },
    { "id": "runtime-build", "base": "workspace", "path": "CarlaSim/Build-ego-runtime-ltvp-final", "kind": "directory" },
    { "id": "python", "base": "workspace", "path": "CarlaSim/.venv-m5/bin/python", "kind": "executable" },
    { "id": "tls", "base": "workspace", "path": "CarlaSim/LocalRuntime/m5/tls", "kind": "directory" },
    { "id": "unreal-editor", "base": "workspace", "path": "UnrealEngine5_carla/Engine/Binaries/Mac/UnrealEditor.app/Contents/MacOS/UnrealEditor", "kind": "executable" },
    { "id": "keyboard-app", "base": "home", "path": "Library/Application Support/CARLA Ego Runtime/m6_2/CARLA Keyboard Control.app", "kind": "directory" }
  ],
  "launchers": [
    {
      "id": "manual-drive",
      "base": "home",
      "path": "Library/Application Support/CARLA Ego Runtime/launchers/manual-drive.command",
      "requiredReferences": ["carla-root", "runtime-root", "runtime-build", "python", "tls", "unreal-editor", "keyboard-app"]
    },
    {
      "id": "route",
      "base": "home",
      "path": "Library/Application Support/CARLA Ego Runtime/launchers/route.command",
      "requiredReferences": ["carla-root", "runtime-root", "runtime-build", "python", "tls", "unreal-editor"]
    }
  ]
}
