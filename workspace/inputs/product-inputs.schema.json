{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "inputs",
    "artifacts",
    "profiles",
    "components",
    "toolchains",
    "gates",
    "id"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "revision",
          "buildRevision",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "buildRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "access": {
            "enum": [
              "public-git",
              "epic-entitlement"
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lock",
          "path",
          "bytes",
          "sha256",
          "kitPath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lock": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@/-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@/-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kitPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@/-]+$"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostManifest",
        "preparationManifest",
        "vmManifest",
        "backendManifest",
        "factory"
      ],
      "properties": {
        "hostManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "preparationManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "vmManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "backendManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "factory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "name",
            "bytes",
            "sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "components",
          "platform",
          "prerequisites"
        ],
        "properties": {
          "id": {
            "enum": [
              "operator",
              "developer",
              "full-source"
            ]
          },
          "claim": {
            "enum": [
              "not-qualified"
            ]
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platform": {
            "const": "macOS-arm64"
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "sourceIds",
          "manifestIds",
          "requires",
          "recipes",
          "format",
          "license",
          "access",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "manifestIds": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recipes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "path"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@/-]+$"
                }
              }
            }
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "enum": [
              "restricted",
              "review-required",
              "public-git",
              "public-pypi"
            ]
          },
          "actions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "developer",
              "full-source"
            ],
            "properties": {
              "operator": {
                "type": "string",
                "enum": [
                  "reuse",
                  "build",
                  "assemble"
                ]
              },
              "developer": {
                "type": "string",
                "enum": [
                  "reuse",
                  "build",
                  "assemble"
                ]
              },
              "full-source": {
                "type": "string",
                "enum": [
                  "reuse",
                  "build",
                  "assemble"
                ]
              }
            }
          }
        }
      }
    },
    "toolchains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "identity",
          "evidence",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@/-]+$"
          },
          "state": {
            "enum": [
              "pinned",
              "unresolved"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profiles",
          "owner",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "operator",
                "developer",
                "full-source"
              ]
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "id": {
      "const": "sdv-lab-current"
    }
  }
}
