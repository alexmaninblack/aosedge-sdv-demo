.DS_Store
.env
.env.*
!.env.example

# Local VM state and downloaded upstream artifacts
.cache/
.local/
.run/
artifacts/
downloads/
runs/

# Virtual machine images, firmware, and release archives
*.qcow2
*.img
*.raw
*.vdi
*.vmdk
*.fd
*.tar
*.tar.gz
*.tar.xz
*.xz

# Credentials and private key material
secrets/
credentials/
*.key
*.pem
*.crt
*.cer
*.csr
*.p12
*.pfx
*.pkcs12
*.jks
id_rsa
id_ed25519

# Confidential or customer-provided source material. Canonical inputs belong
# outside every Git worktree; only reviewed, sanitized derivatives are allowed.
private-inputs/
customer-inputs/
confidential-inputs/
*.customer-confidential.*
*[Kk]3[Ss]*[Ii]ssue*[Cc]overage*.xlsx
*[Pp]o[Cc]*[Cc]overage*260728*.xlsx

# Language and tool output
__pycache__/
*.py[cod]
.venv/
build/

# Optional developer checkout locations; never part of the shared lock
config/component-paths.local.json
