#!/bin/sh

set -eu
umask 077

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH='' cd -- "$script_dir/../.." && pwd)
test_root=$(mktemp -d /private/tmp/aosvm-start-dry-run-test.XXXXXX)
test_run_root="$test_root/run"
test_runs_root="$test_root/runs"
output_path="$test_root/dry-run-output"
test_port="41022"
test_dns_port="41053"
test_provisioning_port="41089"
base_image="$repository_root/.cache/aosvm/v6.1.0/qemuarm64/aos-vm-main-qemuarm64.qcow2"
test_local_root="$test_root/local"
test_backup_root="$test_root/backups"

mkdir -m 700 "$test_local_root" "$test_backup_root"
qemu-img create -q -f qcow2 -F qcow2 -b "$base_image" \
    "$test_local_root/aosvm-main-overlay.qcow2"
chmod 0600 "$test_local_root/aosvm-main-overlay.qcow2"
export AOSVM_LOCAL_ROOT="$test_local_root"
export AOSVM_BACKUP_ROOT="$test_backup_root"

cleanup() {
    rm -r "$test_root"
}

trap cleanup EXIT HUP INT TERM

run_dry_run() {
    AOSVM_RUN_ROOT="$test_run_root" \
    AOSVM_RUNS_ROOT="$test_runs_root" \
    AOSVM_SSH_HOST_PORT="$test_port" \
    AOSVM_HOST_DNS_PORT="$test_dns_port" \
        "$repository_root/scripts/aosvm" start --dry-run
}

run_dry_run >"$output_path"

AOSVM_RUN_ROOT="$test_root/provisioning-run" \
AOSVM_RUNS_ROOT="$test_root/provisioning-runs" \
AOSVM_SSH_HOST_PORT="41023" \
AOSVM_HOST_DNS_PORT="41054" \
AOSVM_PROVISIONING_HOST_PORT="$test_provisioning_port" \
    "$repository_root/scripts/aosvm" start-provisioning --dry-run \
    >"$test_root/provisioning-dry-run-output"

if "$repository_root/scripts/aosvm" start --invalid \
    >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected an invalid start mode to be rejected.\n' >&2
    exit 1
fi

grep -q 'Start mode must be --dry-run or --foreground' "$test_root/stderr"

grep -Fq "QEMU command (dry run; not executed):" "$output_path"
grep -Fq "'/opt/homebrew/bin/qemu-system-aarch64'" "$output_path"
grep -Fq "'virt-11.0,accel=hvf'" "$output_path"
grep -Fq "'-cpu'" "$output_path"
grep -Fq "'host'" "$output_path"
grep -Fq "'-smp'" "$output_path"
grep -Fq "'2'" "$output_path"
grep -Fq "'-m'" "$output_path"
grep -Fq "'2048'" "$output_path"
grep -Fq "'-nodefaults'" "$output_path"
grep -Fq "QEMU_EFI.fd'" "$output_path"
grep -Fq "file=$test_local_root/aosvm-main-overlay.qcow2,if=none,id=aos-image,format=qcow2,cache=writeback" "$output_path"
grep -Fq "'virtio-scsi-pci,id=scsi'" "$output_path"
grep -Fq "'scsi-hd,drive=aos-image,bootindex=0'" "$output_path"
grep -Fq "user,id=aosnet,net=10.0.0.0/24,host=10.0.0.1,dns=10.0.0.2,restrict=off,hostfwd=tcp:127.0.0.1:$test_port-10.0.0.100:22" "$output_path"
if grep -Fq '10.0.0.100:8089' "$output_path"; then
    printf 'Normal dry-run unexpectedly exposes provisioning IAM.\n' >&2
    exit 1
fi
grep -Fq "user,id=aosnet,net=10.0.0.0/24,host=10.0.0.1,dns=10.0.0.2,restrict=off,hostfwd=tcp:127.0.0.1:41023-10.0.0.100:22,hostfwd=tcp:127.0.0.1:$test_provisioning_port-10.0.0.100:8089" \
    "$test_root/provisioning-dry-run-output"
if grep -Eq 'hostfwd=tcp:(0\.0\.0\.0|10\.|192\.168\.|172\.)' \
    "$test_root/provisioning-dry-run-output"; then
    printf 'Provisioning dry-run exposes a non-loopback listener.\n' >&2
    exit 1
fi
grep -Fq "'virtio-net-pci,netdev=aosnet,mac=52:54:00:41:4f:53'" "$output_path"
grep -Fq "path=$test_run_root/aosvm-main.serial,server=on,wait=off,logfile=$test_runs_root/aosvm-main-serial.log,logappend=on,logtimestamp=on" "$output_path"
grep -Fq "'chardev:serial0'" "$output_path"
grep -Fq "'unix:$test_run_root/aosvm-main.qmp,server=on,wait=off'" "$output_path"
grep -Fq "'$test_run_root/aosvm-main.pid'" "$output_path"
grep -Fq "'-monitor'" "$output_path"
grep -Fq "'none'" "$output_path"
grep -Fq "'-display'" "$output_path"

if grep -Eq 'tcg|qemu-aarch64|aos-vm-main-qemuarm64\.qcow2|aos-vm-secondary|hostfwd=[^,]*0\.0\.0\.0|-daemonize|-nographic|-enable-kvm' "$output_path"; then
    printf 'Dry-run output contains a forbidden QEMU argument.\n' >&2
    exit 1
fi

[ "$(stat -f '%Lp' "$test_run_root")" = "700" ]
[ "$(stat -f '%Lp' "$test_runs_root")" = "700" ]
[ -z "$(find "$test_run_root" -mindepth 1 -print)" ]
[ -z "$(find "$test_runs_root" -mindepth 1 -print)" ]

if AOSVM_RUN_ROOT="$test_root/dns-port-run" \
    AOSVM_RUNS_ROOT="$test_root/dns-port-runs" \
    AOSVM_SSH_HOST_PORT="41026" \
    AOSVM_HOST_DNS_PORT="53" \
        "$repository_root/scripts/aosvm" start --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a privileged host DNS port to be rejected.\n' >&2
    exit 1
fi

grep -q 'Host DNS port must be between 1024 and 65535' "$test_root/stderr"

if AOSVM_RUN_ROOT="$test_root/provisioning-port-run" \
    AOSVM_RUNS_ROOT="$test_root/provisioning-port-runs" \
    AOSVM_SSH_HOST_PORT="41027" \
    AOSVM_HOST_DNS_PORT="41057" \
    AOSVM_PROVISIONING_HOST_PORT="443" \
        "$repository_root/scripts/aosvm" start-provisioning --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a privileged provisioning host port to be rejected.\n' >&2
    exit 1
fi

grep -q 'Provisioning host port must be between 1024 and 65535' \
    "$test_root/stderr"

if AOSVM_RUN_ROOT="$test_root/provisioning-conflict-run" \
    AOSVM_RUNS_ROOT="$test_root/provisioning-conflict-runs" \
    AOSVM_SSH_HOST_PORT="41028" \
    AOSVM_HOST_DNS_PORT="41058" \
    AOSVM_PROVISIONING_HOST_PORT="41028" \
        "$repository_root/scripts/aosvm" start-provisioning --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a conflicting provisioning host port to be rejected.\n' >&2
    exit 1
fi

grep -q 'Provisioning, SSH, and DNS host ports must differ' "$test_root/stderr"

unprotected_local_root="$test_root/unprotected-local"
mkdir -m 700 "$unprotected_local_root"
if AOSVM_LOCAL_ROOT="$unprotected_local_root" \
    AOSVM_BACKUP_ROOT="$test_root/unprotected-backups" \
    AOSVM_RUN_ROOT="$test_root/unprotected-run" \
    AOSVM_RUNS_ROOT="$test_root/unprotected-runs" \
    AOSVM_SSH_HOST_PORT="41029" \
    AOSVM_HOST_DNS_PORT="41059" \
    AOSVM_PROVISIONING_HOST_PORT="41099" \
        "$repository_root/scripts/aosvm" start-provisioning \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a real provisioning start without a checkpoint to fail.\n' >&2
    exit 1
fi

grep -q 'Provisioning mode requires a verified pre-provision checkpoint' \
    "$test_root/stderr"
[ ! -e "$test_root/unprotected-run/aosvm-main.pid" ]
[ ! -e "$test_root/unprotected-run/aosvm-main-supervisor.pid" ]

grep -q 'lsof -nP -a -iTCP:"$provisioning_host_port"' \
    "$repository_root/tests/host/aosvm-provisioning-host-gate"
grep -q 'nc -z -w 1 "$address" "$provisioning_host_port"' \
    "$repository_root/tests/host/aosvm-provisioning-host-gate"

if AOSVM_RUN_ROOT="$test_root/invalid-port-run" \
    AOSVM_RUNS_ROOT="$test_root/invalid-port-runs" \
    AOSVM_SSH_HOST_PORT="22" \
        "$repository_root/scripts/aosvm" start --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a privileged SSH host port to be rejected.\n' >&2
    exit 1
fi

grep -q 'SSH host port must be between 1024 and 65535' "$test_root/stderr"

symlink_target="$test_root/symlink-target"
mkdir "$symlink_target"
ln -s "$symlink_target" "$test_root/symlink-run"

if AOSVM_RUN_ROOT="$test_root/symlink-run" \
    AOSVM_RUNS_ROOT="$test_root/symlink-runs" \
    AOSVM_SSH_HOST_PORT="41023" \
        "$repository_root/scripts/aosvm" start --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a symbolic-link runtime directory to be rejected.\n' >&2
    exit 1
fi

grep -q 'Runtime directory must not be a symbolic link' "$test_root/stderr"

existing_run_root="$test_root/existing-run"
existing_runs_root="$test_root/existing-runs"
mkdir -m 700 "$existing_run_root" "$existing_runs_root"
: >"$existing_run_root/aosvm-main.pid"

if AOSVM_RUN_ROOT="$existing_run_root" \
    AOSVM_RUNS_ROOT="$existing_runs_root" \
    AOSVM_SSH_HOST_PORT="41024" \
        "$repository_root/scripts/aosvm" start --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected an existing runtime path to be rejected.\n' >&2
    exit 1
fi

grep -q 'Runtime path already exists' "$test_root/stderr"

serial_log_run_root="$test_root/serial-log-run"
serial_log_runs_root="$test_root/serial-log-runs"
mkdir -m 700 "$serial_log_run_root" "$serial_log_runs_root"
: >"$serial_log_runs_root/aosvm-main-serial.log"
chmod 0644 "$serial_log_runs_root/aosvm-main-serial.log"

if AOSVM_RUN_ROOT="$serial_log_run_root" \
    AOSVM_RUNS_ROOT="$serial_log_runs_root" \
    AOSVM_SSH_HOST_PORT="41025" \
        "$repository_root/scripts/aosvm" start --dry-run \
        >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected an overly broad serial log mode to be rejected.\n' >&2
    exit 1
fi

grep -q 'Existing serial log mode must be 0600' "$test_root/stderr"

validation_output="$test_root/validation-dry-run-output"
mkdir -m 700 "$test_root/validation-local"
qemu-img create -q -f qcow2 -F qcow2 -b "$base_image" \
    "$test_root/validation-local/aosvm-r6-1-validation-overlay.qcow2"
chmod 0600 \
    "$test_root/validation-local/aosvm-r6-1-validation-overlay.qcow2"
AOSVM_INSTANCE=r6-1-validation \
AOSVM_MAC_ADDRESS=52:54:00:52:36:32 \
AOSVM_LOCAL_ROOT="$test_root/validation-local" \
AOSVM_BACKUP_ROOT="$test_root/validation-backups" \
AOSVM_RUN_ROOT="$test_root/validation-run" \
AOSVM_RUNS_ROOT="$test_root/validation-runs" \
AOSVM_SSH_HOST_PORT=41030 \
AOSVM_HOST_DNS_PORT=41060 \
AOSVM_PROVISIONING_HOST_PORT=41100 \
    "$repository_root/scripts/aosvm" start --dry-run >"$validation_output"
grep -Fq "'-name'" "$validation_output"
grep -Fq "'aosvm-r6-1-validation'" "$validation_output"
grep -Fq \
    "$test_root/validation-local/aosvm-r6-1-validation-overlay.qcow2" \
    "$validation_output"
grep -Fq "'virtio-net-pci,netdev=aosnet,mac=52:54:00:52:36:32'" \
    "$validation_output"

if AOSVM_INSTANCE=unknown "$repository_root/scripts/aosvm" status \
    >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected an unknown AosVM instance to be rejected.\n' >&2
    exit 1
fi
grep -q 'unsupported AosVM instance' "$test_root/stderr"

printf 'AosVM start dry-run contract tests passed.\n'
