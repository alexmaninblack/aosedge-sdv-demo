#!/bin/sh

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH='' cd -- "$script_dir/../.." && pwd)
test_root=$(mktemp -d /private/tmp/aosvm-prepare-test.XXXXXX)
test_local_root="$test_root/local"
overlay_path="$test_local_root/aosvm-main-overlay.qcow2"
expected_backing="$repository_root/.cache/aosvm/v6.1.0/qemuarm64/aos-vm-main-qemuarm64.qcow2"

cleanup() {
    rm -r "$test_root"
}

trap cleanup EXIT HUP INT TERM

AOSVM_LOCAL_ROOT="$test_local_root" "$repository_root/scripts/aosvm" prepare \
    >"$test_root/first-prepare.log"

[ -f "$overlay_path" ]
[ ! -L "$overlay_path" ]
[ "$(stat -f '%Lp' "$overlay_path")" = "600" ]

qemu-img info --output=json "$overlay_path" | jq -e \
    --arg expected_backing "$expected_backing" \
    '.["backing-filename"] == $expected_backing and
     .["backing-filename-format"] == "qcow2" and
     .format == "qcow2" and
     .["virtual-size"] == 6997147648 and
     .["dirty-flag"] == false and
     .["format-specific"].data.corrupt == false' >/dev/null

qemu-img check "$overlay_path" >/dev/null

AOSVM_LOCAL_ROOT="$test_local_root" "$repository_root/scripts/aosvm" prepare \
    >"$test_root/second-prepare.log"

: > "$overlay_path"

if AOSVM_LOCAL_ROOT="$test_local_root" "$repository_root/scripts/aosvm" prepare \
    >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a corrupt existing overlay to be rejected.\n' >&2
    exit 1
fi

grep -q 'Overlay qcow2 metadata or backing file is not the expected value' \
    "$test_root/stderr"

rm "$overlay_path"
ln -s /dev/null "$overlay_path"

if AOSVM_LOCAL_ROOT="$test_local_root" "$repository_root/scripts/aosvm" prepare \
    >"$test_root/stdout" 2>"$test_root/stderr"; then
    printf 'Expected a symbolic-link overlay to be rejected.\n' >&2
    exit 1
fi

grep -q 'Overlay path must not be a symbolic link' "$test_root/stderr"

printf 'AosVM prepare safety tests passed.\n'
