#!/bin/sh

set -u
umask 077

interface=enp0s2
expected_mac=52:54:00:41:4f:53
expected_address=10.0.0.100/24
expected_gateway=10.0.0.1
expected_dns=10.0.0.100
expected_upstream='server=10.0.0.1#18053'
host_probe_port=${AOSVM_HOST_PROBE_PORT:-18080}
host_probe_marker=AOSVM_PHASE11_HOST_OK
https_host=docs.aosedge.tech
ca_bundle=/etc/ssl/certs/ca-certificates.crt
minimum_utc_epoch=1785542400

fail() {
    printf 'FAIL: AosVM Phase 11 network gate: %s\n' "$*" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'the gate must run as root'
[ "$(uname -m)" = aarch64 ] || fail 'the guest is not AArch64'
grep -qx 'ID=aos-core' /etc/os-release || fail 'the guest OS is not AosCore'
grep -qx 'VERSION_ID=6.1.0' /etc/os-release \
    || fail 'the guest OS is not AosCore 6.1.0'
case "$host_probe_port" in
    ''|*[!0-9]*) fail 'the host probe port is not numeric' ;;
esac
[ "$host_probe_port" -ge 1024 ] && [ "$host_probe_port" -le 65535 ] \
    || fail 'the host probe port must be between 1024 and 65535'

for tool in ip nc openssl resolvectl timeout wget; do
    command -v "$tool" >/dev/null 2>&1 \
        || fail "required command is unavailable: $tool"
done

printf 'AosVM Phase 11 layered network gate\n'

[ "$(cat "/sys/class/net/$interface/address")" = "$expected_mac" ] \
    || fail 'the guest interface has the wrong MAC address'
address=$(ip -4 -o addr show dev "$interface" scope global |
    awk '{ print $4 }')
[ "$address" = "$expected_address" ] \
    || fail "unexpected guest IPv4 address: ${address:-none}"
default_route=$(ip -4 route show default | sed 's/[[:space:]]*$//')
[ "$default_route" = "default via $expected_gateway dev $interface proto static" ] \
    || fail "unexpected default route: ${default_route:-none}"
printf 'PASS: guest interface and default route\n'

if ! timeout 10 nc 1.1.1.1 443 </dev/null >/dev/null 2>&1; then
    fail 'outbound TCP by IP failed'
fi
printf 'PASS: outbound TCP by IP\n'

probe_output=$(timeout 10 nc "$expected_gateway" "$host_probe_port" 2>/dev/null) \
    || fail 'the guest could not reach the loopback-only host probe'
[ "$probe_output" = "$host_probe_marker" ] \
    || fail 'the host probe returned an unexpected response'
printf 'PASS: guest-to-host TCP through the QEMU gateway\n'

configured_dns=$(awk -F= '$1 == "DNS" { print $2 }' \
    /etc/systemd/network/20-wired.network)
[ "$configured_dns" = "$expected_dns" ] \
    || fail "the persistent DNS setting is not $expected_dns"
[ "$(awk -F= '$1 == "server" { print $0 }' /var/aos/dns/dnsmasq.conf)" \
    = "$expected_upstream" ] \
    || fail 'dnsmasq does not use the loopback-only macOS bridge'
[ "$(systemctl is-active dnsmasq.service)" = active ] \
    || fail 'the guest dnsmasq forwarder is not active'
resolved_dns=$(resolvectl dns "$interface" 2>/dev/null |
    sed -n 's/^Link [^:]*: //p')
[ "$resolved_dns" = "$expected_dns" ] \
    || fail "systemd-resolved is not using $expected_dns"
timeout 20 resolvectl query "$https_host" >/dev/null 2>&1 \
    || fail "DNS resolution failed for $https_host"
timeout 20 nslookup "$https_host" "$expected_dns" >/dev/null 2>&1 \
    || fail 'ordinary guest DNS through dnsmasq failed'
printf 'PASS: DNS through guest dnsmasq and the loopback-only macOS bridge\n'

current_epoch=$(date -u +%s)
[ "$current_epoch" -ge "$minimum_utc_epoch" ] \
    || fail 'the guest clock is still older than the Phase 11 qualification date'
timesync_status=$(timedatectl timesync-status 2>&1) \
    || fail 'systemd-timesyncd status is unavailable'
packet_count=$(printf '%s\n' "$timesync_status" |
    awk -F: '/Packet count:/ { gsub(/[[:space:]]/, "", $2); print $2 }')
case "$packet_count" in
    ''|*[!0-9]*|0) fail 'systemd-timesyncd has not received a time packet' ;;
esac
printf 'PASS: guest clock synchronized after DNS recovery\n'

[ -r "$ca_bundle" ] || fail "the system CA bundle is unavailable: $ca_bundle"
tls_output=$(timeout 25 openssl s_client \
    -connect "$https_host:443" \
    -servername "$https_host" \
    -CAfile "$ca_bundle" \
    -verify_return_error </dev/null 2>&1) \
    || fail "TLS verification failed for $https_host"
printf '%s\n' "$tls_output" | grep -Fq 'Verify return code: 0 (ok)' \
    || fail "TLS did not return a verified certificate chain for $https_host"
timeout 30 wget -q -O /dev/null "https://$https_host/" \
    || fail "verified outbound HTTPS failed for $https_host"
printf 'PASS: outbound HTTPS with certificate validation\n'

[ "$(findmnt -T / -no OPTIONS | tr ',' '\n' | grep -x ro)" = ro ] \
    || fail 'the root filesystem is not read-only'

printf 'PASS: AosVM Phase 11 layered network gate\n'
