{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "schemaVersion": 1,
  "contractVersion": "1.0.0",
  "decision": "ADR-0015",
  "resource": "kuksa-auth-client",
  "mountRoot": "/run/aosedge/secrets/kuksa",
  "mountOptions": [
    "rw",
    "nosuid",
    "nodev",
    "noexec",
    "mode=1777",
    "size=65536"
  ],
  "sessionCreation": "MKDTEMP",
  "sessionPrefix": "session-",
  "sessionMode": "0700",
  "sessionOwner": "ACTUAL_EFFECTIVE_UID_GID",
  "tokenName": "token.jwt",
  "tokenMode": "0400",
  "tokenPathCarrier": "KUKSA_TOKEN_FILE",
  "secretRemovedFromAnalytics": [
    "AOS_SECRET"
  ],
  "preexistingSessionAdoption": false,
  "symlinkTraversal": false,
  "persistentCredential": false,
  "maximumSessionDirectories": 8,
  "sessionCapacityBehavior": "FAIL_CLOSED_WITHOUT_DELETING_OTHER_SESSIONS",
  "normalExit": "REMOVE_OWN_TOKEN_AND_SESSION",
  "restart": "NEW_SESSION_AND_FRESH_IAM_EXCHANGE",
  "crashOrphans": "BOUNDED_BY_SESSION_CAP_CONTAINER_DESTROYS_TMPFS",
  "smCodeChangeRequired": false
}
