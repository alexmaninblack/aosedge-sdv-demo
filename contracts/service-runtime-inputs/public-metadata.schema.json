{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:service-public-metadata:schema:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unitSystemUid",
    "unitRole",
    "vdpContractVersion",
    "vdpContractSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "unitSystemUid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "unitRole": {
      "enum": [
        "validation",
        "production"
      ]
    },
    "vdpContractVersion": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "vdpContractSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
