{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:service-package-release:schema:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serviceVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "serviceVersion": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
