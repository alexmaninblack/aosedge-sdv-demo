    { "path": "Vehicle.Chassis.Axle.Row1.SteeringAngle", "dataType": "float", "unit": "degrees", "namespace": "VSS_6_0", "cadence": "PER_SIMULATION_FRAME", "access": ["SELECTED_PLATFORM_UNIT", "ENGINEERING_DASHBOARD", "QUALIFICATION_CLIENT"], "implementationState": "CURRENT", "capabilityIds": ["vehicle.front_wheel.steer_angles", "actuator.steering"] },
