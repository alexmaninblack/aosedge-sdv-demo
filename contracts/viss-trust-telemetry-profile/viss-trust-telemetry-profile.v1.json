{
  "$schema": "./viss-trust-telemetry-profile.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "schemaVersion": 1,
  "contractId": "aosedge-demo-viss-trust-telemetry-profile",
  "contractVersion": "1.1.0",
  "decision": "D4-006",
  "standards": { "viss": "3.1", "vss": "6.0", "projectOverlay": "Vehicle.CarlaSimulation.*" },
  "transport": {
    "uri": "wss://10.0.0.1:6443",
    "tlsServerName": "127.0.0.1",
    "bindAddress": "127.0.0.1",
    "webSocketSubprotocol": "VISSv3",
    "minimumTlsVersion": "TLS1.2",
    "mutualTls": true,
    "unencryptedWebSocket": false
  },
  "credentialLifecycle": {
    "unitUnique": true,
    "purposeBound": true,
    "separateForRoles": ["SELECTED_PLATFORM_UNIT", "PLATFORM_UPDATE_RUNTIME"],
    "created": "per-Unit onboarding after Cloud Unit and Node identity are known",
    "stored": "root-owned persistent Unit credential outside Factory Image and FOTA payload",
    "delivered": "systemd LoadCredential",
    "excludedFrom": ["FACTORY_IMAGE", "FOTA_COMPONENT", "GIT", "LOGS", "DASHBOARD"],
    "retiredAtR0": true,
    "productionHardening": "future non-exportable TPM/PKCS11 client key; not required by first-demo Python VISS client"
  },
  "peerRoles": [
    { "role": "SELECTED_PLATFORM_UNIT", "maxConcurrentConnections": 1, "allowedOperations": ["GET", "SUBSCRIBE", "UNSUBSCRIBE"], "setPolicy": "DENY_UNTIL_D4_008", "availability": "LIVE_DEMO" },
    { "role": "PLATFORM_UPDATE_RUNTIME", "maxConcurrentConnections": 1, "allowedOperations": ["GET", "SUBSCRIBE", "UNSUBSCRIBE"], "setPolicy": "ALWAYS_DENY", "availability": "LIVE_DEMO" },
    { "role": "ENGINEERING_DASHBOARD", "maxConcurrentConnections": 1, "allowedOperations": ["GET", "SUBSCRIBE", "UNSUBSCRIBE"], "setPolicy": "ALWAYS_DENY", "availability": "LIVE_DEMO" },
    { "role": "QUALIFICATION_CLIENT", "maxConcurrentConnections": 1, "allowedOperations": ["GET", "SUBSCRIBE", "UNSUBSCRIBE"], "setPolicy": "ALWAYS_DENY", "availability": "QUALIFICATION_ONLY" }
  ],
  "selectedUnitGate": {
    "selectedBoundRoles": ["SELECTED_PLATFORM_UNIT", "PLATFORM_UPDATE_RUNTIME"],
    "maximumConnectionsPerSelectedRole": 1,
    "distinctCredentialPerSelectedRole": true,
    "selectedIdentity": ["UnitId", "NodeId", "clientCertificateFingerprint", "assignmentGeneration"],
    "reject": ["NON_SELECTED_UNIT", "UNKNOWN_CLIENT", "EXPIRED_CLIENT", "REVOKED_CLIENT", "ADDITIONAL_UNIT_SESSION", "IDENTITY_MISMATCH"],
    "engineeringDashboardException": "separately authenticated read-only peer; never a Unit binding"
  },
  "timing": { "subscriptionPeriodMs": 50, "freshnessTimeoutMs": 250, "reconnectInitialMs": 500, "reconnectMaximumMs": 10000 },
  "limits": { "maximumRoleConnections": 4, "maximumSubscriptionsPerConnection": 16, "minimumSubscriptionPeriodMs": 50, "maximumSubscriptionPeriodMs": 60000, "maximumPendingMessagesPerClient": 8, "maximumMessageBytes": 262144 },
  "operations": {
    "supported": ["GET", "SUBSCRIBE", "UNSUBSCRIBE"],
    "setBeforeD4008": "DENY_ALL_WITHOUT_SIDE_EFFECT",
    "responsePriority": "PROTOCOL_RESPONSES_BEFORE_SUBSCRIPTION_EVENTS",
    "eventOverflow": "DROP_NEW_EVENT_AND_INCREMENT_COUNTER",
    "missedPeriods": "COALESCE_TO_CURRENT_SNAPSHOT"
  },
  "dataSemantics": {
    "store": "one latest complete frame; no history queue",
    "atomicity": "mandatory malformed frame rejected; optional invalid path unavailable",
    "disconnect": "immediate atomic KUKSA NotAvailable for selected VDP subset",
    "stale": "atomic KUKSA NotAvailable after freshnessTimeoutMs without a valid snapshot",
    "recovery": "LIVE only after one complete valid snapshot with matching contract/source/generation and monotonic frame",
    "healthSeparation": "provider process may be HEALTHY while vehicle data readiness is NOT_READY or STALE",
    "sourceStates": ["STARTING", "AUTHENTICATING", "LIVE", "STALE", "DISCONNECTED", "AUTHENTICATION_FAILED", "CONTRACT_MISMATCH"]
  },
  "paths": [
    { "path": "Vehicle.Speed", "dataType": "float", "unit": "km/h", "namespace": "VSS_6_0", "cadence": "PER_SIMULATION_FRAME", "access": ["SELECTED_PLATFORM_UNIT", "PLATFORM_UPDATE_RUNTIME", "ENGINEERING_DASHBOARD", "QUALIFICATION_CLIENT"], "implementationState": "CURRENT", "capabilityIds": ["vehicle.velocity.world", "vehicle.speed"] },
    { "path": "Vehicle.Acceleration.Longitudinal", "dataType": "float", "unit": "m/s^2", "namespace": "VSS_6_0", "cadence": "PER_SIMULATION_FRAME", "access": ["SELECTED_PLATFORM_UNIT", "ENGINEERING_DASHBOARD", "QUALIFICATION_CLIENT"], "implementationState": "CURRENT", "capabilityIds": ["vehicle.acceleration"] },
