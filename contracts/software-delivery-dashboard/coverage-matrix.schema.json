{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexmaninblack/aosedge-sdv-demo/contracts/software-delivery-dashboard/coverage-matrix.schema.json",
  "title": "Automotive orchestration coverage matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$comment",
    "schemaVersion",
    "matrixVersion",
    "title",
    "provenance",
    "statusDefinitions",
    "items"
  ],
  "properties": {
    "$schema": { "const": "./coverage-matrix.schema.json" },
    "$comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "matrixVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "confidentialSourceIncluded",
        "customerIdentityIncluded",
        "directQuotesIncluded"
      ],
      "properties": {
        "classification": { "const": "SANITIZED_DERIVATIVE" },
        "confidentialSourceIncluded": { "const": false },
        "customerIdentityIncluded": { "const": false },
        "directQuotesIncluded": { "const": false }
      }
    },
    "statusDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PARTIAL", "PLANNED", "DOCUMENTARY_ONLY"],
      "properties": {
        "PARTIAL": { "type": "string", "minLength": 1 },
        "PLANNED": { "type": "string", "minLength": 1 },
        "DOCUMENTARY_ONLY": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coverageItem" }
    }
  },
  "$defs": {
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "theme",
        "concern",
        "demoStages",
        "proofModes",
        "dashboardSection",
        "dashboardEvidence",
        "acceptanceCriterion",
        "currentStatus",
        "claimBoundary"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^AO-[0-9]{2}$" },
        "theme": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "concern": { "type": "string", "minLength": 1 },
        "demoStages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["G0", "G1", "G2", "G3", "G4", "CROSS_STAGE"] }
        },
        "proofModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["LIVE_DEMO", "CONTROLLED_QUALIFICATION", "DOCUMENTARY_EVIDENCE", "EXPLICIT_SCOPE_BOUNDARY"] }
        },
        "dashboardSection": {
          "enum": ["release_control", "runtime_assurance", "supply_chain", "fleet_targeting", "connectivity_edge", "lifecycle_evidence"]
        },
        "dashboardEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "acceptanceCriterion": { "type": "string", "minLength": 1 },
        "currentStatus": { "enum": ["PARTIAL", "PLANNED", "DOCUMENTARY_ONLY"] },
        "claimBoundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
