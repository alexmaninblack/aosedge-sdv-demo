{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexmaninblack/aosedge-sdv-demo/contracts/software-delivery-dashboard/coverage-matrix.schema.json",
  "title": "Automotive orchestration coverage matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$comment",
    "schemaVersion",
    "matrixVersion",
    "title",
    "provenance",
    "statusDefinitions",
    "items"
  ],
  "properties": {
    "$schema": { "const": "./coverage-matrix.schema.json" },
    "$comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "matrixVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "confidentialSourceIncluded",
        "customerIdentityIncluded",
        "directQuotesIncluded"
      ],
      "properties": {
        "classification": { "const": "SANITIZED_DERIVATIVE" },
        "confidentialSourceIncluded": { "const": false },
        "customerIdentityIncluded": { "const": false },
        "directQuotesIncluded": { "const": false }
      }
    },
    "statusDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["UNKNOWN", "PARTIAL", "PLANNED", "DOCUMENTARY_ONLY", "ACCEPTED", "STALE"],
      "properties": {
        "UNKNOWN": { "type": "string", "minLength": 1 },
        "PARTIAL": { "type": "string", "minLength": 1 },
        "PLANNED": { "type": "string", "minLength": 1 },
        "DOCUMENTARY_ONLY": { "type": "string", "minLength": 1 },
        "ACCEPTED": { "type": "string", "minLength": 1 },
        "STALE": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coverageItem" }
    }
  },
  "$defs": {
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "theme",
        "concern",
        "demoStages",
        "proofModes",
        "dashboardSection",
        "dashboardEvidence",
        "acceptanceCriterion",
        "currentStatus",
        "claimBoundary"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^AO-[0-9]{2}$" },
        "theme": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "concern": { "type": "string", "minLength": 1 },
        "demoStages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["M0", "M1", "G0", "G1", "G2", "G3", "G4", "T1", "R0", "CROSS_STAGE"] }
        },
        "proofModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["LIVE_DEMO", "CONTROLLED_QUALIFICATION", "DOCUMENTARY_EVIDENCE", "EXPLICIT_SCOPE_BOUNDARY"] }
        },
        "dashboardSection": {
          "enum": ["release_control", "runtime_assurance", "supply_chain", "fleet_targeting", "connectivity_edge", "lifecycle_evidence"]
        },
        "dashboardEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "acceptanceCriterion": { "type": "string", "minLength": 1 },
        "currentStatus": { "enum": ["UNKNOWN", "PARTIAL", "PLANNED", "DOCUMENTARY_ONLY", "ACCEPTED", "STALE"] },
        "claimBoundary": { "type": "string", "minLength": 1 },
        "acceptedEvidence": { "$ref": "#/$defs/acceptedEvidence" },
        "staleReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "currentStatus": { "const": "ACCEPTED" } },
            "required": ["currentStatus"]
          },
          "then": { "required": ["acceptedEvidence"] }
        },
        {
          "if": {
            "properties": { "currentStatus": { "const": "STALE" } },
            "required": ["currentStatus"]
          },
          "then": { "required": ["acceptedEvidence", "staleReason"] }
        }
      ]
    },
    "acceptedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "verifiedAt",
        "subjectVersion",
        "subjectDigest",
        "platformRelease",
        "configurationDigest"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "subjectVersion": { "type": "string", "minLength": 1 },
        "subjectDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "platformRelease": { "type": "string", "minLength": 1 },
        "configurationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
