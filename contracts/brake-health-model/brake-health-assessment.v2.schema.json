{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:brake-health-assessment:schema:v2",
  "title": "Brake Health Synthetic Assessment — Native service provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "messageType",
    "assessmentId",
    "sourceEventId",
    "unitSystemUid",
    "unitRole",
    "serviceVersion",
    "vdpContractVersion",
    "vdpContractSha256",
    "modelId",
    "modelVersion",
    "modelConfigSha256",
    "provenance",
    "assessedAt",
    "content",
    "contentSha256",
    "serviceInstance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "messageType": {
      "const": "BRAKE_HEALTH_ASSESSMENT"
    },
    "assessmentId": {
      "$ref": "#/$defs/uuid5"
    },
    "sourceEventId": {
      "$ref": "#/$defs/uuid4"
    },
    "unitSystemUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    },
    "unitRole": {
      "enum": [
        "VALIDATION",
        "PRODUCTION"
      ]
    },
    "serviceVersion": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "vdpContractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "vdpContractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "modelId": {
      "const": "brake-condition-demo-v1"
    },
    "modelVersion": {
      "const": "1.0.0"
    },
    "modelConfigSha256": {
      "$ref": "#/$defs/sha256"
    },
    "provenance": {
      "const": "DEMO_SYNTHETIC"
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceWindowStartTimestamp",
        "sourceWindowEndTimestamp",
        "activeSampleCount",
        "straightActiveSampleCount",
        "features",
        "episodeLoadBps",
        "wearIndexBefore",
        "wearIncrement",
        "wearIndexAfter",
        "conditionScore",
        "previousBand",
        "currentBand",
        "quality"
      ],
      "properties": {
        "sourceWindowStartTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "sourceWindowEndTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "activeSampleCount": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "straightActiveSampleCount": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peakDecelerationMps2",
            "peakDecelerationBps",
            "activeDurationSeconds",
            "activeDurationBps",
            "speedReductionKph",
            "speedReductionBps",
            "meanBrakeEffortPercent",
            "meanBrakeEffortBps",
            "wheelDispersionRatio",
            "wheelDispersionBps"
          ],
          "properties": {
            "peakDecelerationMps2": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "peakDecelerationBps": {
              "$ref": "#/$defs/bps"
            },
            "activeDurationSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "activeDurationBps": {
              "$ref": "#/$defs/bps"
            },
            "speedReductionKph": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "speedReductionBps": {
              "$ref": "#/$defs/bps"
            },
            "meanBrakeEffortPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "meanBrakeEffortBps": {
              "$ref": "#/$defs/bps"
            },
            "wheelDispersionRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "wheelDispersionBps": {
              "$ref": "#/$defs/bps"
            }
          }
        },
        "episodeLoadBps": {
          "$ref": "#/$defs/bps"
        },
        "wearIndexBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "wearIncrement": {
          "type": "integer",
          "minimum": 4,
          "maximum": 10
        },
        "wearIndexAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "conditionScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "previousBand": {
          "$ref": "#/$defs/band"
        },
        "currentBand": {
          "$ref": "#/$defs/band"
        },
        "quality": {
          "const": "VALID_DEMO_SYNTHETIC"
        }
      }
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "serviceInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "subjectId",
        "instanceIndex",
        "instanceId"
      ],
      "properties": {
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
        },
        "instanceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
        }
      }
    }
  },
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuid5": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boundedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "band": {
      "enum": [
        "GOOD",
        "MONITOR",
        "INSPECTION_RECOMMENDED"
      ]
    }
  }
}
