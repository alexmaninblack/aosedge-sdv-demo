{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:human-presenter-review:schema:v1",
  "title": "Human Presenter Acceptance Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "reviewId", "dossierId", "cycle",
    "machineVerdict", "reviewerRole", "reviewedAt", "checklistResults",
    "outcome", "sanitizedReasonCodes", "qualificationRule"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "1.0.0"},
    "reviewId": {"type": "string", "format": "uuid"},
    "dossierId": {"type": "string", "format": "uuid"},
    "cycle": {"const": "LIVE_BASELINE_POSITIVE_CYCLE_B"},
    "machineVerdict": {"enum": ["PASSED", "FAILED", "ABORTED", "INCOMPLETE"]},
    "reviewerRole": {"$ref": "#/$defs/code"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "checklistResults": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "outcome", "sanitizedReasonCode"],
        "properties": {
          "checkId": {"$ref": "#/$defs/code"},
          "outcome": {"enum": ["PASS", "FAIL"]},
          "sanitizedReasonCode": {
            "oneOf": [{"$ref": "#/$defs/code"}, {"type": "null"}]
          }
        }
      }
    },
    "outcome": {"enum": ["ACCEPTED", "REJECTED"]},
    "sanitizedReasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "qualificationRule": {"const": "MACHINE_PASSED_AND_HUMAN_ACCEPTED"}
  },
  "$defs": {
    "code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9_./:-]+$"}
  }
}
