{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "schemaVersion": 1,
  "contractId": "aosedge-demo-run-state",
  "contractVersion": "1.1.0",
  "lifecycleState": "DESIGN_REVIEWED",
  "decision": "D4-021",
  "acceptedSubdecisions": [
    {"id": "D4-021.1", "accepted": "2026-08-23"},
    {"id": "D4-021.2", "accepted": "2026-08-23", "revalidated": "2026-08-25"},
    {"id": "D4-021.3", "accepted": "2026-08-23", "revalidated": "2026-08-25"},
    {"id": "D4-021.4", "accepted": "2026-08-23"},
    {"id": "D4-021.5", "accepted": "2026-08-23"},
    {"id": "D4-021.6", "accepted": "2026-08-23"}
  ],
  "repositoryLocalLayout": {
    "excludedFromGit": [".local/", ".run/"],
    "factoryRoot": ".local/factory",
    "currentOverlayRoot": ".local/demo-current",
    "currentRunStateRoot": ".run/demo-current",
    "historicalRunDirectoriesAllowed": false
  },
  "factoryImage": {
    "owner": "CMP_FACTORY",
    "role": "QUALIFIED_LOCAL_COPY_OF_OEM_DEMO_FACTORY_IMAGE",
    "imagePath": ".local/factory/oem-demo-factory.qcow2",
    "manifestPath": ".local/factory/oem-demo-factory.manifest.json",
    "fileMode": "0444",
    "symlinkAllowed": false,
    "hardLinkAllowed": false,
    "digestVerificationPoints": ["M0_ENTRY", "R0_EXIT"],
    "modifiedByDemoRun": false,
    "retainedAfterSuccessfulR0": true
  },
  "currentOverlays": {
    "format": "qcow2",
    "copyOnWrite": true,
    "backingImage": ".local/factory/oem-demo-factory.qcow2",
    "backingDigestMustMatchManifest": true,
    "fileMode": "0600",
    "exactFiles": {
      "VALIDATION": ".local/demo-current/validation.qcow2",
      "PRODUCTION": ".local/demo-current/production.qcow2"
    },
    "createdFreshAtM0": true,
    "provisionedOverlayMayBeCopiedOrUsedAsNextRunSource": false,
    "existingCurrentRunBlocksNewM0UntilReconciledOrSuccessfullyRetired": true,
    "deletedOnlyAfterSuccessfulR0": true
  },
  "currentRunJournal": {
    "path": ".run/demo-current/journal.json",
    "directoryMode": "0700",
    "fileMode": "0600",
    "persistsAcrossLauncherAndMacRestart": true,
    "singleWriter": "DEMO_ORCHESTRATOR",
    "atomicUpdate": "TEMP_FILE_FLUSH_AND_RENAME",
    "authoritativeExternalStateSource": false,
    "externalStateMustBeRereadAfterRestart": true,
    "audienceVisibleDemoRunIdIntroduced": false,
    "allowedContent": [
      "SCHEMA_VERSION",
      "CURRENT_RUN_START_TIME",
      "CURRENT_STAGE",
      "FACTORY_AND_MANIFEST_DIGESTS",
      "REPO_RELATIVE_OVERLAY_ROLES_AND_PATHS",
      "VU_AND_PU_SYSTEM_UID_UNIT_UUID_MAIN_NODE_UUID_UNIT_SET_UUID",
      "VISS_IDENTITY_FINGERPRINT_ONLY",
      "CURRENT_CARLA_GATEWAY_SOURCE_ROLE",
      "BOUNDED_CURRENT_RUN_EXTERNAL_OPERATION_REGISTRY",
      "PER_OPERATION_RESOURCE_CONFLICT_KEYS",
      "PER_OPERATION_RECONCILIATION_STATE",
      "PER_OPERATION_LAST_SANITIZED_AUTHORITATIVE_REREAD_RESULT"
    ],
    "operationStates": ["READY", "WAITING", "SUBMITTING", "UNCERTAIN", "RECONCILING", "BLOCKED", "COMPLETED"],
    "forbiddenContent": [
      "PRIVATE_KEYS",
      "CERTIFICATE_OR_PKCS12_CONTENT",
      "PASSWORDS_OR_JWT",
      "HELPER_SESSION_CAPABILITIES",
      "RAW_CLOUD_RESPONSES",
      "TELEMETRY_OR_FUNCTION_PAYLOADS",
      "RAW_LOGS",
      "VIN",
      "PERSONAL_ABSOLUTE_PATHS",
      "BACKEND_CLEANUP_CONFIRMATION_TOKENS",
      "PREVIOUS_RUN_HISTORY"
    ],
    "uncertainStateAllowsBlindRetry": false,
    "missingOrCorruptWithExistingOverlayBlocksM0": true,
    "deletedAfterSuccessfulR0": true,
    "retainedUntilReconciledWhenR0Incomplete": true
  },
  "interruptedOperationRecovery": {
    "operationRegistry": {
      "bounded": true,
      "maximumNonterminalEntries": 16,
      "ordinaryOperationHistoryRetained": false,
      "requiredPerEntry": [
        "LOCAL_OPERATION_ID",
        "OWNING_TEAM",
        "CANDIDATE_OR_OPERATION_CLASS",
        "AUTHORITY_CONTEXT",
        "EXACT_TARGET",
        "REQUEST_FINGERPRINT",
        "RESOURCE_CONFLICT_KEYS",
        "KNOWN_EXTERNAL_IDS",
        "LOCAL_STATE",
        "RECONCILIATION_CLASSIFICATION",
        "LAST_SANITIZED_AUTHORITATIVE_REREAD"
      ]
    },
    "journalBeforeCall": ["LOCAL_OPERATION_ID", "OWNING_TEAM", "OPERATION_TYPE", "EXACT_TARGET", "REQUEST_FINGERPRINT", "RESOURCE_CONFLICT_KEYS", "KNOWN_EXTERNAL_IDS", "SUBMITTING"],
    "resourceConflictPolicy": {
      "unrelatedMutationsMayProceed": true,
      "readOnlyNavigationAndAuthoritativeReadsRemainAvailable": true,
      "resourceLockHoldingStates": ["WAITING", "SUBMITTING", "UNCERTAIN", "RECONCILING"],
      "conflictWhenAnyExactKeyMatches": true,
      "conflictKeyNamespaces": [
        "CANDIDATE_DIGEST",
        "PUBLICATION_PROFILE",
        "CLOUD_OBJECT",
        "VERIFICATION_BATCH",
        "FLEET_VALIDATION_BATCH",
        "CAMPAIGN",
        "UNIT",
        "UNIT_SET"
      ],
      "runExclusiveOperationClasses": [
        "PROVISIONING",
        "IDENTITY_RETIREMENT",
        "LIVE_SOURCE_HANDOVER_OR_RESET",
        "R0_FREEZE_AND_CLEANUP"
      ],
      "runExclusiveOperationConflictsWithEveryMutation": true,
      "r0RequiresNoOtherNonterminalOperation": true
    },
    "helperCapacity": {
      "busyAffectsOnlyRequestedOperation": true,
      "busyVisibleState": "WAITING",
      "presentedAsAosCloudRestriction": false,
      "automaticSubmissionWhenCapacityReturns": false,
      "automaticCrossTeamQueueOrTriggerAllowed": false
    },
    "successfulHttpResponseMeansCompleted": false,
    "successfulHttpResponseNextState": "RECONCILING",
    "timeoutLostResponseProcessOrMacRestartState": "UNCERTAIN",
    "explicitRejectionState": "BLOCKED",
    "restartPerformsMutationBeforeReread": false,
    "restartSequence": ["ACQUIRE_JOURNAL_WRITER_LOCK", "READ_AND_VALIDATE_OPERATION_REGISTRY_FACTORY_AND_OVERLAYS", "REREAD_EACH_NONTERMINAL_OPERATION_AUTHORITATIVE_STATE", "CLASSIFY_EACH_OPERATION", "CONTINUE_EACH_SCOPE_ONLY_WHEN_PROVEN"],
    "reconciliationClassifications": ["APPLIED", "NOT_APPLIED", "CONTRADICTORY", "UNOBSERVABLE"],
    "appliedAllowsJournalAdvance": true,
    "notAppliedAllowsAutomaticResubmit": false,
    "notAppliedRequiresExactProofAndNewExplicitConfirmation": true,
    "contradictoryOrUnobservableBlocks": true,
    "unresolvedOperationBlocksUnrelatedResourceScopes": false,
    "corruptRegistryBlocksAllMutationsButAllowsReadOnlyDiagnosis": true,
    "notFoundProvesAbsenceOnlyWithIndependentVisibilityProof": true,
    "partialProvisioningRequiresBothRolesReconciledBeforeRetryDisposalOrNewM0": true,
    "partialR0ResumesAtFirstUnprovenStep": true,
    "partialR0RepeatsProvenDestructiveAction": false,
    "overlaysRetainedUntilCloudIdentityAndBackendCleanupAreProven": true,
    "corruptJournalState": "RECOVERY_REQUIRED",
    "automaticRollbackOrJustInCaseDeletionAllowed": false,
    "audienceStates": ["UNCERTAIN", "RECONCILING", "BLOCKED", "RECOVERY_REQUIRED"],
    "qualificationInterruptions": [
      "LOST_RESPONSE",
      "NATIVE_HELPER_RESTART",
      "DEMO_LAUNCHER_RESTART",
      "MAC_RESTART",
      "AFTER_EACH_DESTRUCTIVE_R0_STEP"
    ]
  },
  "completeR0Ordering": {
    "unitRetirementOrder": ["VALIDATION", "PRODUCTION"],
    "orderedPhases": [
      "FREEZE_NEW_ACTIONS_CAPTURE_FINAL_IDENTITIES_AND_DETACH_LIVE_SOURCE",
      "RETIRE_VALIDATION_UNIT",
      "RETIRE_PRODUCTION_UNIT",
      "PROVE_UNITS_NODES_ABSENT_AND_PERSISTENT_ROLE_SETS_EMPTY",
      "CLEAN_EXACT_BRAKE_CURRENT_UNIT_DATA",
      "CLEAN_EXACT_TIRE_CURRENT_UNIT_DATA",
      "STOP_LOCAL_FUNCTION_BACKENDS_AND_RESET_EMPTY_OWNED_VOLUMES",
      "RESET_AND_STOP_CARLA_CONTROLLER_AND_GATEWAY",
      "DELETE_RUN_SPECIFIC_VISS_AND_HOST_ACCESS_MATERIAL",
      "DELETE_VALIDATION_AND_PRODUCTION_OVERLAYS",
      "DELETE_CURRENT_OPERATION_RECEIPTS",
      "VERIFY_FACTORY_IMAGE_AND_MANIFEST_DIGESTS",
      "DELETE_CURRENT_RUN_JOURNAL_LAST",
      "PASS_NEXT_M0_EXIT_GATE"
    ],
    "perUnitRetirement": [
      "DISCONNECT_EXTERNAL_CONNECTIVITY_AND_WAIT_AOSCLOUD_OFFLINE",
      "DEPROVISION_ONCE",
      "REREAD_AUTHORITATIVE_UNIT_STATE",
      "PROVE_OLD_CREDENTIAL_CANNOT_RETURN_UNIT_ONLINE",
      "LEAVE_EXTERNAL_CONNECTIVITY_OFF",
      "STOP_VM_AND_PROVE_OVERLAY_UNHELD",
      "DELETE_EXACT_CURRENT_RUN_NATIVE_LOG_REQUESTS",
      "REMOVE_SYSTEM_UID_FROM_EXACT_ROLE_UNIT_SET_AND_REREAD",
      "DELETE_UNIT_ONCE",
      "PROVE_UNIT_ABSENT_AND_UNIT_OWNED_NODE_INACCESSIBLE"
    ],
    "persistentUnitSetObjectsDeleted": false,
    "aosCloudAuditBatchOrCampaignHistoryDeleted": false,
    "functionalCleanupUsesExactCurrentVuAndDuSystemUids": true,
    "functionalVolumeResetRequiresProvenBackendCleanup": true,
    "overlayDeletionRequiresProvenCloudRetirementBackendCleanupAndStoppedVm": true,
    "factoryImageDeletedOrModified": false,
    "journalDeletedLast": true,
    "uncertainStepBehavior": "HALT_RETAIN_JOURNAL_AND_REMAINING_OVERLAYS_BLOCK_NEXT_M0",
    "presentedAsFotaOrSotaRollback": false,
    "exitGate": [
      "FACTORY_IMAGE_AND_MANIFEST_PRESENT_WITH_ACCEPTED_DIGESTS",
      "CURRENT_OVERLAYS_ABSENT",
      "CURRENT_RUN_JOURNAL_ABSENT",
      "BRAKE_AND_TIRE_CURRENT_RUN_DATA_ABSENT",
      "BOTH_VMS_NATIVE_HELPER_CARLA_CONTROLLER_AND_GATEWAY_STOPPED",
      "PERSISTENT_VERIFICATION_AND_PRODUCTION_UNIT_SETS_EMPTY",
      "NEXT_M0_UNBLOCKED"
    ]
  },
  "functionalDataAndSimulatorCleanup": {
    "backendCleanupCaller": "DEMO_ORCHESTRATOR_ONLY",
    "browserOrSotaServiceMayInvokeCleanup": false,
    "selectorSource": "CURRENT_JOURNAL_VU_PU_SYSTEM_UIDS_VERIFIED_BY_FINAL_CLOUD_EVIDENCE",
    "backendOrder": ["BRAKE", "TIRE"],
    "perBackendSequence": ["PREVIEW", "PROVE_EXACT_TWO_UNIT_SET_COUNT_AND_RECORD_DIGEST", "CONFIRM", "EXECUTE", "PROVE_ZERO_SELECTED_RECORDS"],
    "confirmationTokenStorage": "MEMORY_ONLY",
    "restartRequiresNewPreview": true,
    "crossFunctionDeletionAllowed": false,
    "containersStopAndVolumesResetOnlyAfterBothBackendsProveClean": true,
    "simulatorSequence": [
      "REQUEST_SAFE_STOP_AND_WAIT_APPLIED",
      "ABORT_ACTIVE_SCENARIO_AND_DISABLE_AUTOPILOT_TRAFFIC_MANAGER",
      "EXECUTE_D4_004_CANONICAL_FREE_DRIVE_RESET",
      "REMOVE_SCENARIO_OWNED_OBSTACLE_ZERO_MOTION_AND_PROVE_RESET_GENERATION",
      "DETACH_LIVE_SOURCE_ASSIGNMENT",
      "UNIFIED_STACK_SHUTDOWN_CONTROL_UI_CONTROLLER_GATEWAY_CARLA",
      "WAIT_BOUNDED_GRACEFUL_EXIT",
      "TERMINATE_ONLY_LAUNCHER_OWNED_EXACT_PIDS_OR_PROCESS_GROUP_IF_REQUIRED",
      "PROVE_NO_PROCESS_WINDOW_LISTENER_SOCKET_SOURCE_ASSIGNMENT_ACTOR_OR_RUN_STATE"
    ],
    "escapeAndR0UseSameUnifiedShutdownPath": true,
    "broadProcessKillAllowed": false,
    "carlaInstallationMapsAssetsSourceOrPreparedScenariosDeleted": false,
    "cleanupFailureBlocksOverlayDeletionAndNextM0": true
  },
  "nextRunReadinessProof": {
    "localState": "READY_FOR_M0",
    "isAosCloudState": false,
    "requiresExactEqualityNotWarning": true,
    "cloudChecks": [
      "RETIRED_VU_AND_PU_ABSENT_WITH_INDEPENDENT_VISIBILITY",
      "UNIT_OWNED_NODES_INACCESSIBLE",
      "PERSISTENT_VERIFICATION_UNIT_SET_EXISTS_AND_IS_EMPTY",
      "PERSISTENT_PRODUCTION_UNIT_SET_EXISTS_AND_IS_EMPTY",
      "OLD_UNIT_CREDENTIALS_CANNOT_RESTORE_ONLINE",
      "AOSCLOUD_AUDIT_BATCH_AND_CAMPAIGN_HISTORY_RETAINED"
    ],
    "localChecks": [
      "REGULAR_READ_ONLY_FACTORY_IMAGE_MATCHES_MANIFEST_DIGEST",
      "CURRENT_OVERLAYS_ABSENT",
      "CURRENT_JOURNAL_AND_OPERATION_RECEIPTS_ABSENT",
      "RUN_SPECIFIC_VISS_IDENTITIES_AND_HELPER_CAPABILITIES_ABSENT",
      "VMS_HELPER_BACKENDS_CARLA_CONTROLLER_AND_GATEWAY_STOPPED",
      "OWNED_PORTS_AND_SOCKETS_FREE",
      "BRAKE_AND_TIRE_CURRENT_RUN_DATA_AND_VOLUMES_ABSENT",
      "LIVE_SOURCE_ASSIGNMENT_ABSENT",
      "SCENARIO_OBSTACLE_AND_RUN_OWNED_ACTORS_ABSENT",
      "PREBUILT_VDP_BRAKE_TIRE_ARTIFACTS_AND_DIGEST_CATALOGUE_RETAINED"
    ],
    "missingProofState": "BLOCKED",
    "ordinaryRunHistoryRetained": false,
    "formalQualificationMayRetainSanitizedDossierOnly": true,
    "nextM0CreatesCloudIdentity": false,
    "nextM1MustProveNewSystemUidUnitUuidNodeUuidAndVissFingerprint": true,
    "repeatabilityQualification": "TWO_CONSECUTIVE_COMPLETE_M0_THROUGH_R0_THEN_M0_M1_CYCLES",
    "repeatabilityProvedByHistoricalRunDatabase": false
  }
}
