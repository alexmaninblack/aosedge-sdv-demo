        "category": "SOURCE_UNAVAILABLE",
        "reasonCodes": ["TELEMETRY_STALE", "TELEMETRY_DISCONNECTED"],
        "owner": "VEHICLE_DATA_OPERATIONS",
        "action": "Show source unavailable or stale; do not mislabel a transient data/connectivity problem as a required VDP upgrade."
      },
      {
        "category": "ACCESS_CONFIGURATION",
        "reasonCodes": ["SERVICE_ACCESS_DENIED"],
        "owner": "OEM_INTEGRATION",
        "action": "Review approved service metadata and current KUKSA permission mapping; do not widen access automatically."
      }
    ]
