{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "schemaVersion": 1,
  "contractId": "aosedge-demo-tire-cloud-api",
  "contractVersion": "1.0.0",
  "lifecycleState": "ACCEPTED",
  "decision": "D4-019",
  "transport": {
    "protocol": "HTTP_1_1",
    "scope": "LOCAL_ISOLATED_DEMO_ROUTE",
    "authentication": "OUT_OF_SCOPE_FOR_FIRST_DEMO",
    "applicationLayerAuthenticationImplemented": false,
    "productionAuthenticationOwner": "FUNCTION_TEAM_2",
    "productionBackendSecurityClaimed": false,
    "clientCredentialProvisioningRequired": false,
    "lanExposureAllowed": false,
    "publicNetworkExposureAllowed": false,
    "browserIngestionAllowed": false,
    "networkIsolationQualificationDecision": "D4-020",
    "messageSystemUidUsage": "CORRELATION_ONLY_NOT_AUTHENTICATED_IDENTITY",
    "endpoint": "/api/v1/tire/messages",
    "method": "POST",
    "logicalMessagesPerRequest": 1,
    "requestContentType": "application/json",
    "optionalContentEncoding": "gzip",
    "compressionChangesLogicalDigest": false,
    "maximumWireRequestBytes": 32768,
    "requestTimeoutSeconds": 10,
    "deliveryExecution": "ASYNCHRONOUS_FROM_BOUNDED_PERSISTENT_OUTBOX",
    "deliveryMayBlockLocalAssessment": false,
    "deliveryMayBlockLocalStateUpdate": false,
    "deliveryMayBlockLocalAdvisory": false
  },
  "tenantIsolation": {
    "apiNamespace": "/api/v1/tire",
    "backendContainer": "TIRE_CLOUD_ONLY",
    "sqliteDatabase": "TIRE_CLOUD_ONLY",
    "dockerVolume": "TIRE_CLOUD_ONLY",
    "dockerNetwork": "TIRE_CLOUD_ONLY",
    "dashboard": "TIRE_CLOUD_ONLY",
    "publicationProfile": "tire-sp2",
    "sharesFailureBoundaryWithBrakeCloud": false,
    "oemLifecycleAuthority": false,
    "approvalTargetingPromotionAuthority": "OEM_SOFTWARE_DELIVERY_DASHBOARD_AND_AOSCLOUD"
  },
  "messageKinds": [
    {"messageType": "TIRE_HEALTH_ASSESSMENT", "schema": "../tire-health-model/tire-health-assessment.schema.json", "idempotencyKeyFields": ["unitSystemUid", "messageType", "assessmentId"], "maximumCanonicalBytes": 16384},
    {"messageType": "TIRE_CONDITION_BAND_CHANGED", "schema": "../tire-health-model/tire-health-event.schema.json", "idempotencyKeyFields": ["unitSystemUid", "messageType", "eventId"], "maximumCanonicalBytes": 16384},
    {"messageType": "TIRE_ADVISORY_FACT", "schema": "tire-advisory-fact.schema.json", "idempotencyKeyFields": ["unitSystemUid", "messageType", "requestId", "gatewayState"], "maximumCanonicalBytes": 16384},
    {"messageType": "TIRE_FUNCTION_STATUS", "schema": "tire-function-status.schema.json", "idempotencyKeyFields": ["unitSystemUid", "messageType", "statusId"], "maximumCanonicalBytes": 8192}
  ],
  "prohibitedPayload": ["CONTINUOUS_RAW_TELEMETRY", "SELECTED_TIRE_PROFILE", "FRICTION_FORCE_MULTIPLIER", "SIMULATOR_EXPECTED_BAND"],
  "functionStatus": {
    "authority": "FUNCTION_TEAM_REPORTED_NOT_AOSCORE_LIFECYCLE_READINESS",
    "emission": ["SERVICE_START", "STATUS_CHANGE", "BOUNDED_HEARTBEAT"],
    "maximumHeartbeatFrequencySeconds": 30,
    "statusId": "DETERMINISTIC_UUIDV5",
    "incompatibleVdpIncludesActualRequiredAndMissingContractFacts": true
  },
  "acknowledgement": {
    "successStates": ["DURABLE_ACCEPTED", "DUPLICATE_ACCEPTED"],
    "deleteLocalOnlyAfterMatchingDurableAck": true,
    "messageKeyDigest": "SHA256_OF_RFC8785_IDEMPOTENCY_KEY_ARRAY",
    "acknowledgementKeyField": "messageKeySha256",
    "duplicateReusesOriginalReceiptIdAndReceivedAt": true,
    "conflictLocalDisposition": "DELIVERY_CONFLICT_RETAIN_NO_AUTOMATIC_RETRY",
    "businessMeaning": "EXACT_LOGICAL_MESSAGE_DURABLY_STORED_ONLY",
    "gatewayApplicationAcknowledged": false,
    "driverReceiptAcknowledged": false,
    "oemAcceptanceAcknowledged": false,
    "sameKeySameDigestHttpStatus": 200,
    "newDurableMessageHttpStatus": 201,
    "sameKeyDifferentDigestHttpStatus": 409,
    "invalidMessageHttpStatus": 422,
    "tooLargeHttpStatus": 413,
    "temporarilyUnavailableHttpStatus": 503,
    "responseBeforeTransactionCommitAllowed": false
  },
  "retry": {
    "retryableHttpStatuses": [408, 425, 429, 500, 502, 503, 504],
    "ambiguousOutcomeReusesIdenticalLogicalBytes": true,
    "initialBackoffSeconds": 1,
    "multiplier": 2,
    "maximumBackoffSeconds": 30,
    "jitterPercent": 20,
    "serverRetryAfterMayIncreaseDelay": true,
    "retryPreservesSourceTime": true,
    "retryDeletesOrRewritesSourceTimestamp": false
  },
  "persistence": {
    "engine": "SQLITE",
    "runtimeAndMigrationsLocation": "IMMUTABLE_TIRE_BACKEND_CONTAINER_IMAGE",
    "databasePath": "/data/tire-health.sqlite",
    "databaseStorage": "DEDICATED_EXTERNAL_DOCKER_PERSISTENT_VOLUME",
    "dashboardDirectDatabaseAccessAllowed": false,
    "journalMode": "WAL",
    "synchronous": "FULL",
    "foreignKeys": true,
    "busyTimeoutMilliseconds": 5000,
    "writeConcurrency": "SINGLE_SERIALIZED_WRITER",
    "ingestionTransactionIncludes": ["IDEMPOTENCY_CHECK", "CANONICAL_MESSAGE_INSERT", "TYPED_PROJECTION_UPDATE", "DURABLE_RECEIPT_INSERT"],
    "schemaVersionTable": "schema_version",
    "tables": ["messages", "assessments", "condition_events", "advisory_facts", "function_status", "quarantine"],
    "migrationPolicy": "FORWARD_ONLY_PACKAGED_TRANSACTIONAL_BEFORE_READY",
    "unknownNewerSchemaBehavior": "NOT_READY_NO_DESTRUCTIVE_RESET",
    "automaticDowngradeAllowed": false,
    "walCheckpointPolicy": "BOUNDED_WITHOUT_WEAKENING_COMMITTED_ACKNOWLEDGEMENT",
    "conflictingDuplicateDisposition": "QUARANTINE",
    "persistentVolumeOwner": "TIRE_CLOUD_ONLY",
    "ordinaryContainerRestartPreservesData": true,
    "ordinaryDockerDesktopRestartPreservesData": true,
    "containerReplacementWithinRunPreservesData": true,
    "historicalDemoRunArchive": false,
    "separateDatabaseBackupRequired": false,
    "r0Removal": "CLEAN_CURRENT_UNIT_RECORDS_THEN_RESET_OWNED_VOLUME",
    "failureHttpStatus": 503,
    "failureCreatesDurableAcknowledgement": false,
    "readinessRule": "DATABASE_OPEN_AND_SCHEMA_SUPPORTED_AND_MIGRATIONS_COMPLETE_AND_READ_WRITE_PROBE_PASSES",
    "sharesDatabaseOrVolumeWithBrakeCloud": false
  },
  "query": {
    "basePath": "/api/v1/tire",
    "routes": [
      "/units/{systemUid}/assessments",
      "/units/{systemUid}/events",
      "/units/{systemUid}/advisories",
      "/units/{systemUid}/function-status",
      "/stream"
    ],
    "backendHealthRoutes": ["/health/live", "/health/ready"],
    "liveUpdateMechanism": "SERVER_SENT_EVENTS",
    "dashboardAuthority": "TIRE_FUNCTIONAL_BACKEND_RECORDS_ONLY",
    "unitServiceReadinessAuthority": "AOSCLOUD_AND_AOSCORE_VIA_SOFTWARE_DELIVERY_DASHBOARD",
    "currentUnitSelector": "EXACT_CURRENT_VALIDATION_OR_PRODUCTION_SYSTEM_UID",
    "pagination": "BOUNDED_STABLE_ORDER_WITH_EXPLICIT_CURSOR_OR_OFFSET",
    "sseRole": "CHANGE_NOTIFICATION_ONLY_NOT_STATE_AUTHORITY",
    "sseReconnectBehavior": "AUTHORITATIVE_REST_REREAD"
  },
  "qualificationControl": {
    "decision": "D4-023.3",
    "owner": "FUNCTION_TEAM_2",
    "purpose": "DEMO_ONLY_TIRE_CPU_ISOLATION_PROOF",
    "dashboardCommandEndpoint": "/api/v1/tire/qualification/cpu-load",
    "serviceCommandEndpoint": "/api/v1/tire/qualification/cpu-load/commands/{systemUid}",
    "serviceStatusEndpoint": "/api/v1/tire/qualification/cpu-load/status",
    "serviceRouteDirection": "TIRE_SERVICE_INITIATES_OUTBOUND_BACKEND_REQUEST",
    "profileId": "TIRE_CPU_ISOLATION_PROOF_V1",
    "allowedCommands": ["START_FIXED_CPU_LOAD", "STOP_FIXED_CPU_LOAD"],
    "backendBinds": ["CURRENT_SYSTEM_UID", "TIRE_SERVICE_VERSION", "TIRE_SERVICE_ARTIFACT_DIGEST", "PROFILE_ID"],
    "callerSelectedParametersAllowed": false,
    "maximumConcurrentWorkers": 1,
    "absoluteSafetyCeilingSeconds": 180,
    "dashboardOrBackendLeaseLossBehavior": "AUTO_STOPPED",
    "serviceOrVmRestartBehavior": "INACTIVE_NO_PERSISTENCE_NO_RESUME",
    "externalConnectivityRequired": true,
    "dashboardButtonDisabledWhenSelectedVehicleOffline": true,
    "states": ["INACTIVE", "STARTING", "ACTIVE", "STOPPING", "AUTO_STOPPED", "FAILED"],
    "stateAuthority": "TIRE_SERVICE_CONTROL_STATE_ONLY",
    "stateProvesAosCoreQuotaEnforcement": false,
    "adminExecOrSignalFallbackAllowed": false
  },
  "cleanup": {
    "previewEndpoint": "/api/v1/tire/admin/current-run/cleanup-preview",
    "executeEndpoint": "/api/v1/tire/admin/current-run/cleanup",
    "accessBoundary": "LOCAL_DEMO_ORCHESTRATOR_ONLY",
    "browserAccessAllowed": false,
    "guestIngestionRouteAccessAllowed": false,
    "lanAccessAllowed": false,
    "selectorSource": "CURRENT_RUN_PROVISIONING_JOURNAL",
    "requiredSelector": "EXACT_CURRENT_VALIDATION_AND_PRODUCTION_SYSTEM_UIDS",
    "exactSystemUidCount": 2,
    "wildcardAllowed": false,
    "emptySelectorAllowed": false,
    "emptyMatchingRecordSetAllowed": true,
    "confirmationTokenTtlSeconds": 60,
    "tokenBinds": ["sortedSystemUids", "recordCounts", "recordSetSha256", "expiresAt"],
    "executeRequiresExactPreviewToken": true,
    "stalePreviewBehavior": "REJECT_IF_RECORD_COUNTS_OR_RECORD_SET_DIGEST_CHANGED",
    "deleteTransactionIncludes": ["MESSAGES", "ASSESSMENTS", "EVENTS", "ADVISORIES", "FUNCTION_STATUS", "QUARANTINE"],
    "transactionScope": "ONE_SQLITE_TRANSACTION",
    "postDeleteProof": "ZERO_MATCHING_ROWS_AND_UNCHANGED_NONMATCHING_DIGEST",
    "ambiguousResultReconciliation": "AUTHORITATIVE_ZERO_COUNT_AND_NONMATCHING_DIGEST_REREAD",
    "blindRepeatAllowed": false,
    "deletesAosCloudAudit": false,
    "deletesBrakeCloudData": false,
    "deletesCloudUnitsOrNodes": false,
    "deletesVmOrOverlay": false,
    "mustCompleteBeforeVolumeReset": true,
    "overallResetOrderingDecision": "D4-021"
  },
  "presentation": {
    "requiredFields": [
      "unitSystemUid",
      "unitRole",
      "serviceVersion",
      "serviceArtifactSha256",
      "vdpContractVersion",
      "conditionBand",
      "conditionScore",
      "confidencePercent",
      "sourceEventTime",
      "backendReceivedAt",
      "deliveryState"
    ],
    "views": ["ASSESSMENTS", "BAND_CHANGE_CHRONOLOGY", "ADVISORY_FACTS", "FUNCTION_STATUS"],
    "functionStatusLabel": "FUNCTION_TEAM_REPORTED_STATUS",
    "functionStatusStaleAfterSeconds": 90,
    "staleStatusPresentation": "FUNCTION_STATUS_STALE_KEEP_LAST_REASON_NO_PROCESS_INFERENCE",
    "functionStatusReasons": ["READY", "BACKEND_SYNC_PENDING", "BACKEND_DISCONNECTED", "OUTBOX_FULL", "INCOMPATIBLE_VDP", "TELEMETRY_STALE", "TELEMETRY_DISCONNECTED", "SERVICE_ACCESS_DENIED", "NOT_READY_STATE"],
    "incompatibleVdpGuidance": "CONTACT_PLATFORM_TEAM_FOR_VDP_V3",
    "incompatibleVdpGuidanceIsLifecycleMutation": false,
    "requiredAuthorityLabels": ["FUNCTIONAL_DATA_FROM_TIRE_BACKEND", "UNIT_AND_SERVICE_STATE_FROM_AOSCLOUD"],
    "forbiddenClaims": ["EXACT_TREAD_DEPTH", "REMAINING_USEFUL_LIFE", "PRODUCTION_DIAGNOSTIC", "SAFETY_RESULT", "SIMULATOR_ORACLE_VISIBLE", "DRIVER_ACKNOWLEDGED", "GATEWAY_APPLIED_WITHOUT_STATUS", "CLOUD_DECIDED_TIRE_HEALTH", "AOSCORE_READINESS_DERIVED_FROM_FUNCTION_STATUS"]
  }
}
