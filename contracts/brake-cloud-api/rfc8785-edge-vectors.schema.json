{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:brake-cloud-rfc8785-edge-vectors:schema:v1",
  "title": "Brake Cloud RFC8785 Edge Vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "canonicalVectors", "rejectedRawJson"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "1.0.0"},
    "canonicalVectors": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/canonicalVector"}
    },
    "rejectedRawJson": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rejectedVector"}
    }
  },
  "$defs": {
    "canonicalVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rawInputJson", "canonicalJson", "canonicalSha256"],
      "properties": {
        "id": {"enum": ["RFC8785_UNICODE_UTF16_ORDER", "RFC8785_NUMBER_SERIALIZATION"]},
        "rawInputJson": {"type": "string", "minLength": 1},
        "canonicalJson": {"type": "string", "minLength": 1},
        "canonicalSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rejectedVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rawInputJson", "errorCode"],
      "properties": {
        "id": {"const": "DUPLICATE_OBJECT_KEY"},
        "rawInputJson": {"type": "string", "minLength": 1},
        "errorCode": {"const": "DUPLICATE_JSON_KEY"}
      }
    }
  }
}
