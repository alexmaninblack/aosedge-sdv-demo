{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:brake-cloud-cleanup-preview-request:schema:v1",
  "title": "Brake Cloud Current-Unit Cleanup Preview Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "systemUids"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "1.0.0"},
    "systemUids": {"$ref": "#/$defs/systemUids"}
  },
  "$defs": {
    "systemUids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}
    }
  }
}
