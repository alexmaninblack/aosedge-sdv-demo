{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "schemaVersion": 1,
  "profileId": "aosedge-demo-brake-cloud-query-admin",
  "contractVersion": "1.1.0",
  "lifecycleState": "ACCEPTED",
  "acceptedBaseContractVersion": "1.0.0",
  "decision": "D4-017",
  "acceptedClarifications": [
    "BC-DATA-DEC-03",
    "BC-DATA-DEC-05",
    "BC-DATA-DEC-06",
    "BC-WINDOW-DETAIL-DEC-01"
  ],
  "currentUnitContext": {
    "schema": "current-unit-context.schema.json",
    "injection": "REQUIRED_EXPLICIT_APPLICATION_INPUT",
    "acceptedSource": "CURRENT_RUN_PROVISIONING_JOURNAL",
    "exactRoles": ["VALIDATION", "PRODUCTION"],
    "exactUnitCount": 2,
    "distinctSystemUidsRequired": true,
    "cloudLifecycleOrReadinessFieldsAllowed": false,
    "cloudLookupOrInferenceAllowed": false,
    "liveProvisioningJournalAdapter": "DEFERRED_TO_BRAKE_CLOUD_INTEGRATION_001",
    "missingOrInvalidBehavior": "503_CURRENT_UNIT_CONTEXT_UNAVAILABLE"
  },
  "rest": {
    "transport": "HTTP_1_1",
    "basePath": "/api/v1/brake",
    "requestContentType": "application/json",
    "responseContentType": "application/json",
    "unitSelector": "EXACT_PATH_SYSTEM_UID",
    "userFacingUnitRoleLabels": {"VALIDATION": "Test Vehicle", "PRODUCTION": "Production Vehicle"},
    "currentUnitAuthorization": "PATH_SYSTEM_UID_MUST_EQUAL_ONE_IN_INJECTED_CURRENT_UNIT_CONTEXT",
    "emptyCurrentUnitBehavior": "200_EMPTY_PAGE_WITH_CONTEXT_ROLE",
    "nonCurrentUnitBehavior": "404_UNIT_NOT_CURRENT",
    "routes": [
      {
        "resourceType": "WINDOW",
        "method": "GET",
        "path": "/units/{systemUid}/windows",
        "order": ["windowStartTimestamp_DESC", "eventId_DESC"]
      },
      {
        "resourceType": "ASSESSMENT",
        "method": "GET",
        "path": "/units/{systemUid}/assessments",
        "order": ["assessedAt_DESC", "assessmentId_DESC"]
      },
      {
        "resourceType": "EVENT",
        "method": "GET",
        "path": "/units/{systemUid}/events",
        "order": ["effectiveAt_DESC", "eventId_DESC"]
      },
      {
        "resourceType": "ADVISORY",
        "method": "GET",
        "path": "/units/{systemUid}/advisories",
        "order": ["recordedAt_DESC", "requestId_DESC", "gatewayState_DESC"]
      }
    ],
    "pagination": {
      "style": "OPAQUE_KEYSET_CURSOR",
      "limitQueryParameter": "limit",
      "cursorQueryParameter": "cursor",
      "defaultLimit": 50,
      "maximumLimit": 100,
      "minimumLimit": 1,
      "cursorEncoding": "BASE64URL_NO_PADDING_OF_RFC8785_JSON_ARRAY",
      "cursorFields": ["unitSystemUid", "resourceType", "primaryOrderValue", "identityTieBreakers"],
      "cursorIsOpaqueToClient": true,
      "snapshotIsolationClaimed": false,
      "malformedOrScopeMismatchedCursor": "400_INVALID_CURSOR",
      "endOfCollection": "nextCursor_NULL"
    },
    "responseSchema": "query-page.schema.json",
    "pointReads": [
      {
        "resourceType": "WINDOW_DETAIL",
        "method": "GET",
        "path": "/units/{systemUid}/windows/{eventId}",
        "eventIdFormat": "LOWERCASE_UUID_V4",
        "responseSchema": "window-detail.schema.json",
        "queryParametersAllowed": false,
        "paginationApplied": false,
        "visibilitySource": "EXISTING_WINDOW_QUERY_PROJECTION",
        "missingVisibleProjectionBehavior": "404_NOT_FOUND",
        "sampleSource": "VALIDATED_CANONICAL_WINDOW_CHUNK_CONTENT_JSON",
        "sampleOrder": "CHUNK_INDEX_ASC_THEN_STORED_SAMPLE_ARRAY_ORDER",
        "minimumSamples": 0,
        "maximumSamples": 150,
        "storedSampleFieldsPreserved": true,
        "snapshotIsolationClaimed": false,
        "freshnessClaimed": false
      }
    ],
    "cacheControl": "no-store",
    "windowProjectionVisibility": {
      "outOfOrderChunkPersistence": "DURABLE_ACK_ALLOWED",
      "visibleOnlyAfterAuthoritativeStart": true,
      "authoritativeStartSources": ["CHUNK_INDEX_0_FIRST_SAMPLE_SOURCE_TIMESTAMP", "WINDOW_COMPLETION_WINDOW_START_TIMESTAMP"],
      "bothSourcesMustMatchWhenPresent": true,
      "laterChunkBeforeAuthoritativeStart": "PERSIST_WITHHOLD_WINDOW_QUERY_PROJECTION_AND_SSE_CHANGE",
      "mismatchDisposition": "QUARANTINE_NON_TERMINAL"
    },
    "eventVdpProvenance": {
      "initialState": "PENDING_ASSESSMENT_CORRELATION",
      "pendingContractVersion": null,
      "pendingContractSha256": null,
      "correlationRequiredFields": ["unitSystemUid", "assessmentId", "sourceEventId", "serviceVersion", "serviceArtifactSha256", "modelId", "modelVersion", "modelConfigSha256"],
      "correlatedState": "CORRELATED_ASSESSMENT",
      "inferenceFromServiceVersionOrNearbyRecordAllowed": false
    }
  },
  "errors": {
    "schema": "error-response.schema.json",
    "contentType": "application/json",
    "mappings": [
      {"errorCode": "INVALID_REQUEST", "httpStatus": 400, "retryable": false},
      {"errorCode": "INVALID_CURSOR", "httpStatus": 400, "retryable": false},
      {"errorCode": "NOT_FOUND", "httpStatus": 404, "retryable": false},
      {"errorCode": "UNIT_NOT_CURRENT", "httpStatus": 404, "retryable": false},
      {"errorCode": "CONTENT_CONFLICT", "httpStatus": 409, "retryable": false},
      {"errorCode": "PREVIEW_STALE", "httpStatus": 409, "retryable": false},
      {"errorCode": "PREVIEW_TOKEN_EXPIRED", "httpStatus": 409, "retryable": false},
      {"errorCode": "PAYLOAD_TOO_LARGE", "httpStatus": 413, "retryable": false},
      {"errorCode": "UNPROCESSABLE_MESSAGE", "httpStatus": 422, "retryable": false},
      {"errorCode": "TEMPORARILY_UNAVAILABLE", "httpStatus": 503, "retryable": true},
      {"errorCode": "CURRENT_UNIT_CONTEXT_UNAVAILABLE", "httpStatus": 503, "retryable": true}
    ]
  },
  "sse": {
    "method": "GET",
    "path": "/api/v1/brake/stream",
    "systemUidQueryParameter": "systemUid",
    "systemUidRule": "EXACT_ONE_UNIT_FROM_INJECTED_CURRENT_UNIT_CONTEXT",
    "missingContextBehavior": "503_CURRENT_UNIT_CONTEXT_UNAVAILABLE_NO_STREAM",
    "nonCurrentUnitBehavior": "404_UNIT_NOT_CURRENT_NO_STREAM",
    "responseContentType": "text/event-stream",
    "cacheControl": "no-store",
    "eventName": "brake-data-changed",
    "dataSchema": "sse-change-notification.schema.json",
    "eventId": "MONOTONIC_UNSIGNED_DECIMAL_PER_BACKEND_PROCESS",
    "statePayloadAllowed": false,
    "replayOrResumeAuthority": false,
    "lastEventIdIsStateAuthority": false,
    "clientRuleAfterEveryNotification": "AUTHORITATIVE_REST_REREAD",
    "clientRuleAfterEveryReconnect": "AUTHORITATIVE_REST_REREAD_BEFORE_CURRENT_PRESENTATION",
    "clientRuleAfterGapOrBackendRestart": "DISCARD_CONTINUITY_CLAIM_AND_AUTHORITATIVE_REST_REREAD",
    "backpressureBehavior": "CLOSE_CONNECTION_CLIENT_RECONNECTS_AND_REREADS_REST"
  },
  "admin": {
    "transport": "HTTP_1_1_OVER_UNIX_DOMAIN_SOCKET",
    "socketPath": "/run/brake-health-cloud/admin.sock",
    "socketMode": "0600",
    "compositionRoot": "SEPARATE_FROM_BROWSER_QUERY_AND_GUEST_INGESTION_LISTENERS",
    "accessBoundary": "LOCAL_DEMO_ORCHESTRATOR_ONLY",
    "browserAccessAllowed": false,
    "guestIngestionRouteAccessAllowed": false,
    "lanAccessAllowed": false,
    "requestContentType": "application/json",
    "responseContentType": "application/json",
    "maximumRequestBytes": 4096,
    "selector": "EXACT_SORTED_CURRENT_VALIDATION_AND_PRODUCTION_SYSTEM_UIDS",
    "selectorSource": "CURRENT_RUN_PROVISIONING_JOURNAL",
    "selectorMustEqualInjectedCurrentUnitContext": true,
    "demoRunIdFieldAllowed": false,
    "runTimeRangeFieldAllowed": false,
    "recordSetDigest": {
      "algorithm": "SHA256_OF_RFC8785_CANONICAL_JSON",
      "selectedRows": "EXACT_SYSTEM_UID_EQUALITY_FOR_BOTH_CONTEXT_UNITS",
      "topLevelShape": "ARRAY_OF_TABLE_NAME_AND_ROW_ARRAY_PAIRS",
      "logicalTableOrder": ["messages", "windows", "assessments", "events", "advisories", "quarantine"],
      "includeEmptyTableArrays": true,
      "rowOrder": "LEXICOGRAPHIC_ASCENDING_RFC8785_CANONICAL_ROW_UTF8_BYTES",
      "tables": [
        {
          "name": "messages",
          "fields": ["unitSystemUid", "messageType", "messageIdentity", "messageKeySha256", "contentSha256", "canonicalMessageSha256", "backendReceivedAt", "receiptId", "receiptReceivedAt"]
        },
        {
          "name": "windows",
          "fields": ["unitSystemUid", "eventId", "projectionState", "terminalState", "receivedChunkCount", "expectedChunkCount", "receivedSampleCount", "windowStartTimestamp", "completionContentSha256", "windowSha256", "lastBackendReceivedAt"]
        },
        {
          "name": "assessments",
          "fields": ["unitSystemUid", "assessmentId", "sourceEventId", "contentSha256", "backendReceivedAt"]
        },
        {
          "name": "events",
          "fields": ["unitSystemUid", "eventId", "assessmentId", "sourceEventId", "contentSha256", "backendReceivedAt"]
        },
        {
          "name": "advisories",
          "fields": ["unitSystemUid", "requestId", "gatewayState", "contentSha256", "backendReceivedAt"]
        },
        {
          "name": "quarantine",
          "fields": ["unitSystemUid", "messageType", "messageIdentity", "messageKeySha256", "attemptedContentSha256", "reasonCode", "quarantinedAt"]
        }
      ],
      "fieldValuesEncodedAs": "JSON_ARRAY_IN_DECLARED_FIELD_ORDER",
      "duplicateJsonObjectKeyBehavior": "REJECT_BEFORE_CANONICALIZATION",
      "nonmatchingDigestUsesSameShapeAndComplementRows": true
    },
    "confirmationToken": {
      "format": "v1.BASE64URL_NO_PADDING_RFC8785_PAYLOAD.BASE64URL_NO_PADDING_HMAC_SHA256",
      "payload": ["brake-cleanup-preview-v1", "sortedSystemUids", "recordCounts", "recordSetSha256", "expiresAt"],
      "key": "RANDOM_256_BIT_PROCESS_LOCAL_NOT_PERSISTED_NOT_LOGGED_NOT_RETURNED",
      "comparison": "CONSTANT_TIME",
      "ttlSeconds": 60,
      "maximumLength": 1024,
      "malformedBehavior": "409_PREVIEW_TOKEN_EXPIRED",
      "badMacBehavior": "409_PREVIEW_TOKEN_EXPIRED",
      "previousProcessOrRestartBehavior": "409_PREVIEW_TOKEN_EXPIRED",
      "previousProcessOrRestartNextAction": "NEW_PREVIEW_REQUIRED",
      "validMacChangedCurrentRowSetBehavior": "409_PREVIEW_STALE",
      "failureDeletesRecords": false
    },
    "preview": {
      "method": "POST",
      "path": "/api/v1/brake/admin/current-run/cleanup-preview",
      "requestSchema": "cleanup-preview-request.schema.json",
      "responseSchema": "cleanup-preview.schema.json",
      "successHttpStatus": 200
    },
    "execute": {
      "method": "POST",
      "path": "/api/v1/brake/admin/current-run/cleanup",
      "requestSchema": "cleanup-execute-request.schema.json",
      "responseSchema": "cleanup-result.schema.json",
      "successHttpStatus": 200,
      "transaction": "ONE_SQLITE_TRANSACTION",
      "malformedBadMacExpiredOrPreviousProcessTokenBehavior": "409_PREVIEW_TOKEN_EXPIRED",
      "validMacChangedCurrentRowSetBehavior": "409_PREVIEW_STALE",
      "tokenFailureDeletesRecords": false,
      "ambiguousResponseBehavior": "AUTHORITATIVE_PREVIEW_REREAD_NO_BLIND_REPEAT"
    }
  }
}
