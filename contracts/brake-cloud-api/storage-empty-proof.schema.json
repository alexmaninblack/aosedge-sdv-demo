{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:brake-cloud-storage-empty-proof:schema:v1",
  "title": "Brake Cloud Private Read-only Storage Proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "state", "databaseSchemaVersion", "recordCounts", "observedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": "1.0.0"},
    "state": {"enum": ["EMPTY", "NONEMPTY"]},
    "databaseSchemaVersion": {"const": 2},
    "recordCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "windows", "assessments", "events", "advisories", "quarantine"],
      "properties": {
        "messages": {"type": "integer", "minimum": 0},
        "windows": {"type": "integer", "minimum": 0},
        "assessments": {"type": "integer", "minimum": 0},
        "events": {"type": "integer", "minimum": 0},
        "advisories": {"type": "integer", "minimum": 0},
        "quarantine": {"type": "integer", "minimum": 0}
      }
    },
    "observedAt": {"type": "string", "format": "date-time"}
  },
  "if": {"properties": {"state": {"const": "EMPTY"}}},
  "then": {"properties": {"recordCounts": {"additionalProperties": {"const": 0}}}},
  "else": {"properties": {"recordCounts": {"not": {"additionalProperties": {"const": 0}}}}}
}
