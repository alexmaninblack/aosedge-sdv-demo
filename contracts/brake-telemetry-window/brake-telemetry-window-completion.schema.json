{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aosedge-sdv-demo:brake-telemetry-window-completion:schema:v1",
  "title": "Brake Telemetry Window Completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "messageType", "eventType", "eventId", "unitSystemUid", "unitRole", "serviceVersion", "serviceArtifactSha256", "vdpContractVersion", "vdpContractSha256", "content", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "1.0.0" },
    "messageType": { "const": "WINDOW_COMPLETION" },
    "eventType": { "const": "HARD_BRAKING_EPISODE_V1" },
    "eventId": { "$ref": "#/$defs/uuid4" },
    "unitSystemUid": { "$ref": "#/$defs/boundedId" },
    "unitRole": { "enum": ["VALIDATION", "PRODUCTION"] },
    "serviceVersion": { "$ref": "#/$defs/semver" },
    "serviceArtifactSha256": { "$ref": "#/$defs/sha256" },
    "vdpContractVersion": { "$ref": "#/$defs/semver" },
    "vdpContractSha256": { "$ref": "#/$defs/sha256" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminalState", "reasonCode", "triggerTimestamp", "windowStartTimestamp", "windowEndTimestamp", "phaseSampleCounts", "totalSamples", "totalChunks", "chunkContentSha256", "windowSha256"],
      "properties": {
        "terminalState": { "enum": ["COMPLETE", "TRUNCATED_MAX_DURATION", "INCOMPLETE_SOURCE_GAP", "ABORTED_SERVICE_STOP", "ABORTED_RESTART"] },
        "reasonCode": { "enum": ["NORMAL_CLEAR", "MAX_ACTIVE_DURATION", "SOURCE_GAP", "SERVICE_STOP", "SERVICE_RESTART"] },
        "triggerTimestamp": { "type": "string", "format": "date-time" },
        "windowStartTimestamp": { "type": "string", "format": "date-time" },
        "windowEndTimestamp": { "type": "string", "format": "date-time" },
        "phaseSampleCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PRE", "ACTIVE", "POST"],
          "properties": {
            "PRE": { "type": "integer", "minimum": 0, "maximum": 30 },
            "ACTIVE": { "type": "integer", "minimum": 0, "maximum": 100 },
            "POST": { "type": "integer", "minimum": 0, "maximum": 20 }
          }
        },
        "totalSamples": { "type": "integer", "minimum": 1, "maximum": 150 },
        "totalChunks": { "type": "integer", "minimum": 1, "maximum": 15 },
        "chunkContentSha256": { "type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "windowSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contentSha256": { "$ref": "#/$defs/sha256" }
  },
  "oneOf": [
    { "properties": { "content": { "properties": { "terminalState": { "const": "COMPLETE" }, "reasonCode": { "const": "NORMAL_CLEAR" } } } } },
    { "properties": { "content": { "properties": { "terminalState": { "const": "TRUNCATED_MAX_DURATION" }, "reasonCode": { "const": "MAX_ACTIVE_DURATION" } } } } },
    { "properties": { "content": { "properties": { "terminalState": { "const": "INCOMPLETE_SOURCE_GAP" }, "reasonCode": { "const": "SOURCE_GAP" } } } } },
    { "properties": { "content": { "properties": { "terminalState": { "const": "ABORTED_SERVICE_STOP" }, "reasonCode": { "const": "SERVICE_STOP" } } } } },
    { "properties": { "content": { "properties": { "terminalState": { "const": "ABORTED_RESTART" }, "reasonCode": { "const": "SERVICE_RESTART" } } } } }
  ],
  "$defs": {
    "uuid4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "boundedId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
