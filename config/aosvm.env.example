# Optional AosVM host overrides. The qualified defaults require no file.
# Source this file from the repository root before invoking scripts/aosvm.

export AOSVM_SSH_HOST_PORT=10022
export AOSVM_HOST_DNS_PORT=18053

# QEMU readiness, clean guest shutdown, verified TERM, and guest SSH readiness.
export AOSVM_START_TIMEOUT_SECONDS=30
export AOSVM_STOP_TIMEOUT_SECONDS=90
export AOSVM_TERM_TIMEOUT_SECONDS=15
export AOSVM_SMOKE_TIMEOUT_SECONDS=90

# Optional local-state locations. Keep these untracked and outside shared paths.
# export AOSVM_CACHE_ROOT="$PWD/.cache"
# export AOSVM_LOCAL_ROOT="$PWD/.local"
# export AOSVM_RUN_ROOT="$PWD/.run"
# export AOSVM_RUNS_ROOT="$PWD/runs"

# Optional absolute private directory for persistent lifecycle metadata and
# standalone pre-/post-provision checkpoints. The default is:
# ~/Library/Application Support/CarlaAosEdge/AosVM/backups
# AOSVM_BACKUP_ROOT=/Volumes/EncryptedStorage/CarlaAosEdge/AosVM/backups
